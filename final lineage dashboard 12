    max_depth = max(depths.values()) if depths else 0
    combined_from = set(lineage.get("combined_from") or [])

    nodes_json = json.dumps([
        {
            "id": n["sheet_name"], "label": n["sheet_name"],
            "color": COMBINED_START_COLOR if n["sheet_name"] in combined_from else NODE_COLOR.get(n["classification"], "#888888"),
            "shape": "box", "size": 30 if n["classification"] == "Output node" else 24,
            "level": depths.get(n["sheet_name"], max_depth),
            "title": (
                f"{n['sheet_name']}\\nClassification: {n['classification']}"
                f"\\nConfidence: {n['confidence_score']}%"
                f"\\nMethod: {n['match_method'] or '(root)'}"
            ),
            "font": {"color": "#ffffff", "size": 16},
        }
        for n in lineage["nodes"]
    ])

    edge_dicts = []
    for r in lineage["relationships"]:
        label, title = _edge_label_and_title(r)
        edge_dicts.append({
            "from": r["source"], "to": r["target"], "arrows": "to",
            "label": label, "title": title,
            # Carried separately (not just baked into the hover title) so
            # the side panel can print it directly under each fed-by/fed-to
            # entry -- evidence you'd otherwise only see by hovering a thin
            # arrow. None/absent on real formula/named_range edges.
            "evidenceDetail": r.get("evidence_detail"),
        })
    edges_json = json.dumps(edge_dicts)

    legend_extra = (
        "Orange = sheet(s) you selected for this combined view.<br>"
        if combined_from else ""
    )
    if filter_label:
        legend_extra += f"<b>Filter:</b> {filter_label} -- sheets/edges outside this filter are hidden here (still present in the tables/exports).<br>"

    return f"""<!doctype html>
