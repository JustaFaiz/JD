  #side-panel .close-btn {{ position:absolute; top:10px; right:14px; cursor:pointer; font-size:20px; color:#aaa; }}
  #side-panel .close-btn:hover {{ color:#fff; }}
  #side-panel h3 {{ margin:0 30px 4px 0; word-break:break-word; }}
  #side-panel .section-title {{
    margin-top:18px; font-weight:bold; color:#f1c40f; font-size:13px;
    text-transform:uppercase; letter-spacing:0.03em; border-bottom:1px solid #333; padding-bottom:4px;
  }}
  #side-panel ul {{ list-style:none; padding-left:0; margin:8px 0 0 0; }}
  #side-panel li {{ padding:6px 0; border-bottom:1px solid #2a2a2a; font-size:13px; }}
  #side-panel li .tag {{ color:#888; font-size:11px; margin-left:6px; }}
  #side-panel li .evidence-detail {{
    display:block; color:#aaa; font-size:11px; font-style:italic;
    margin-top:3px; line-height:1.4; word-break:break-word;
  }}
  #side-panel .empty {{ color:#777; font-size:13px; font-style:italic; }}
</style></head>
<body>
<div id="hint">
  <b>Filing reference:</b> {lineage['filing_reference']}<br>
  <b>Final output:</b> {lineage['final_output']}<br>
  Green = Input source, teal = Process node, gold = Output node (root).<br>
  {legend_extra}
  Edge numbers = formula count linking those sheets. "~desc"/"~val" = fuzzy-matched (no direct formula) with match strength % -- hover for the actual matched text/values and how many corroborate it.<br>
  Click a sheet: its direct connections light up, everything else dims, and a panel opens with the full fed-by/fed-to detail. Click empty space to reset.<br>
  Top = furthest upstream, bottom = filing output.
</div>
<div id="tree"></div>
<div id="side-panel">
  <span class="close-btn" onclick="closePanel()">&times;</span>
  <h3 id="panel-title"></h3>
  <div class="section-title">Fed by (upstream sources)</div>
  <ul id="fed-by-list"></ul>
  <div class="section-title">Fed to (downstream)</div>
  <ul id="fed-to-list"></ul>
</div>
<script>
  var nodes = new vis.DataSet({nodes_json});
  var edges = new vis.DataSet({edges_json});
  var network = new vis.Network(document.getElementById('tree'), {{nodes: nodes, edges: edges}}, {{
    layout: {{
      hierarchical: {{
        enabled: true, direction: "DU", sortMethod: "directed",
        levelSeparation: 220, nodeSpacing: 260, treeSpacing: 280
      }}
    }},
    physics: {{
      hierarchicalRepulsion: {{ nodeDistance: 260 }},
      solver: "hierarchicalRepulsion"
    }},
    interaction: {{ dragNodes: true, dragView: true, zoomView: true }},
    edges: {{
      smooth: {{ type: "cubicBezier", forceDirection: "vertical" }},
      arrows: {{ to: {{ enabled: true }} }}, color: "#888888",
      font: {{ color: "#ffffff", strokeWidth: 3, strokeColor: "#111111", size: 13 }}
    }},
    nodes: {{ font: {{ color: "#ffffff", size: 16 }} }}
  }});
  network.once("stabilizationIterationsDone", function () {{ network.setOptions({{physics: false}}); }});

  // --- Highlight-on-click -----------------------------------------------
  // Dims everything except the clicked node's direct neighbors (its "fed
  // by" sources and "fed to" targets), so a busy diagram with overlapping
  // arrows reduces to just the handful of edges that matter for that
  // sheet. Layout/levels never change -- only color/opacity/width, so the
  // hierarchical structure stays intact.
  var HIGHLIGHT_COLOR = "#4dd0e1";
  var DIM_NODE_OPACITY = 0.12;
  var DIM_EDGE_OPACITY = 0.08;
  var DIM_FONT_COLOR = "rgba(255,255,255,0.25)";
  var FULL_FONT_COLOR = "#ffffff";

  var originalNodeColors = {{}};
  nodes.get().forEach(function (n) {{ originalNodeColors[n.id] = n.color; }});

  // vis-network's hierarchical layout silently recomputes every node's
  // position whenever the node/edge DataSets change -- even for a pure
  // color/width update like highlighting. That's what was causing the
  // large gaps on click: each click was quietly re-running the layout
  // algorithm. Fix: snapshot every node's current (x, y) right before the
  // update, then pin them straight back afterward -- so highlighting only
  // ever touches color/opacity/width, never position.
  function pinPositions(positions) {{
    Object.keys(positions).forEach(function (id) {{
      network.moveNode(id, positions[id].x, positions[id].y);
    }});
  }}

  function highlightNode(nodeId) {{
    var positions = network.getPositions();
    var allEdges = edges.get();
    var connectedNodeIds = new Set([nodeId]);
    allEdges.forEach(function (e) {{
      if (e.from === nodeId) connectedNodeIds.add(e.to);
      if (e.to === nodeId) connectedNodeIds.add(e.from);
    }});

    nodes.update(nodes.get().map(function (n) {{
      var isConnected = connectedNodeIds.has(n.id);
      return {{
        id: n.id,
        color: {{
          background: originalNodeColors[n.id], border: originalNodeColors[n.id],
          opacity: isConnected ? 1 : DIM_NODE_OPACITY,
        }},
        font: {{ color: isConnected ? FULL_FONT_COLOR : DIM_FONT_COLOR, size: 16 }},
      }};
    }}));

    edges.update(allEdges.map(function (e) {{
      var isConnected = e.from === nodeId || e.to === nodeId;
      return {{
        id: e.id,
        color: {{ color: isConnected ? HIGHLIGHT_COLOR : "#888888", opacity: isConnected ? 1 : DIM_EDGE_OPACITY }},
        width: isConnected ? 3 : 1,
        font: {{
          color: isConnected ? FULL_FONT_COLOR : DIM_FONT_COLOR,
          strokeWidth: isConnected ? 3 : 0, strokeColor: "#111111", size: 13,
        }},
      }};
    }}));

    pinPositions(positions);
  }}

  function resetHighlight() {{
    var positions = network.getPositions();
    nodes.update(nodes.get().map(function (n) {{
      return {{
        id: n.id,
        color: {{ background: originalNodeColors[n.id], border: originalNodeColors[n.id], opacity: 1 }},
        font: {{ color: FULL_FONT_COLOR, size: 16 }},
      }};
    }}));
    edges.update(edges.get().map(function (e) {{
      return {{
        id: e.id,
        color: {{ color: "#888888", opacity: 1 }},
        width: 1,
        font: {{ color: FULL_FONT_COLOR, strokeWidth: 3, strokeColor: "#111111", size: 13 }},
      }};
    }}));
    pinPositions(positions);
  }}
  // ------------------------------------------------------------------------

  function closePanel() {{
    document.getElementById('side-panel').classList.remove('open');
    network.unselectAll();
    resetHighlight();
  }}

  function buildEdgeListItem(sheetName, edge) {{
    var li = document.createElement('li');
    var mainLine = document.createElement('div');
    mainLine.textContent = sheetName;
    if (edge.label) {{
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = edge.label;
      mainLine.appendChild(tag);
    }}
    li.appendChild(mainLine);
    if (edge.evidenceDetail) {{
      var evidence = document.createElement('span');
      evidence.className = 'evidence-detail';
      evidence.textContent = edge.evidenceDetail;
      li.appendChild(evidence);
    }}
    return li;
  }}

  function showPanel(nodeId) {{
    document.getElementById('panel-title').textContent = nodeId;
    var fedByList = document.getElementById('fed-by-list');
    var fedToList = document.getElementById('fed-to-list');
    fedByList.innerHTML = '';
    fedToList.innerHTML = '';
    var allEdges = edges.get();
    var fedBy = allEdges.filter(function (e) {{ return e.to === nodeId; }});
    var fedTo = allEdges.filter(function (e) {{ return e.from === nodeId; }});

    if (fedBy.length === 0) {{
      fedByList.innerHTML = '<li class="empty">Nothing feeds this sheet (input source)</li>';
    }} else {{
      fedBy.forEach(function (e) {{
        fedByList.appendChild(buildEdgeListItem(e.from, e));
      }});
    }}

    if (fedTo.length === 0) {{
      fedToList.innerHTML = '<li class="empty">This sheet feeds nothing further</li>';
    }} else {{
      fedTo.forEach(function (e) {{
        fedToList.appendChild(buildEdgeListItem(e.to, e));
      }});
    }}

    document.getElementById('side-panel').classList.add('open');
  }}

  network.on("click", function (params) {{
    if (params.nodes.length > 0) {{
      var nodeId = params.nodes[0];
      showPanel(nodeId);
      highlightNode(nodeId);
    }} else {{
      closePanel();
    }}
  }});
</script>
</body></html>"""


# ---------------------------------------------------------------------------
# STREAMLIT UI
# ---------------------------------------------------------------------------

if st is not None:
    # Cached wrappers around the expensive steps. Keyed on file bytes, so a
    # re-run triggered by an unrelated widget (typing in a text_input,
    # toggling an expander, etc.) reuses the cached result instead of
    # re-parsing the workbook or re-running fallback matching from scratch.
    _cached_load_workbook_formulas = st.cache_data(show_spinner=False)(load_workbook_formulas)
    _cached_load_raw_sheets = st.cache_data(show_spinner=False)(load_raw_sheets)
    _cached_fallback_match = st.cache_data(show_spinner=False)(fallback_match_unreached_sheets)

    @st.cache_resource(show_spinner=False)
    def _cached_open_workbooks(file_bytes, _name):
        """
        Keeps one data_only and one formulas-mode workbook open in memory
        for the lifetime of the current uploaded file, so lookup_cell_direct
        (driven by a text_input that reruns on every keystroke) never has
        to re-open/re-parse the file from bytes again. cache_resource (not
        cache_data) because live openpyxl Workbook objects aren't meant to
        be pickled/copied.
        """
        wb_values = load_workbook(io.BytesIO(file_bytes), data_only=True, read_only=True)
        wb_formulas = load_workbook(io.BytesIO(file_bytes), data_only=False, read_only=True)
        return wb_values, wb_formulas


def run_app():
    st.set_page_config(page_title="Filing Lineage", layout="wide")
    st.title("Filing-Centric Lineage")
    st.caption("Pick your filing reference sheet -> trace every real formula link feeding it -> fuzzy-fallback for anything formulas don't reach.")

    uploaded = st.file_uploader("Upload workbook", type=["xlsx", "xls"])
    if uploaded is None:
        st.info("Upload your workbook to get started.")
        return

    file_bytes = uploaded.getvalue()

    if st.session_state.get("_fld_name") != uploaded.name:
        st.session_state.pop("fld_lineage", None)
        st.session_state["_fld_name"] = uploaded.name

    with st.spinner("Reading formulas and defined names..."):
        formulas, sheetnames, defined_name_map = _cached_load_workbook_formulas(file_bytes)
    with st.spinner("Reading sheet values..."):
        raw_sheets = _cached_load_raw_sheets(file_bytes)

    st.success(f"Loaded {len(sheetnames)} sheets, {len(formulas)} formulas, {len(defined_name_map)} defined name(s).")

    st.subheader("1. Filing reference sheet")
    default_idx = next((i for i, s in enumerate(sheetnames) if "taxable income" in s.lower()), 0)
    root_sheet = st.selectbox("This sheet is the root/output node -- the final aggregation sheet.", sheetnames, index=default_idx)

    st.subheader("2. Final output cell (Taxable Income / Line 30)")
    input_mode = st.radio(
        "How do you want to specify it?",
        ["Enter cell reference directly", "Pick from auto-detected candidates"],
        horizontal=True,
    )

    if input_mode == "Enter cell reference directly":
        cell_ref = st.text_input("Cell reference on the filing reference sheet (e.g. B30)", value="")
        if cell_ref.strip():
            wb_values, wb_formulas = _cached_open_workbooks(file_bytes, uploaded.name)
            if root_sheet not in wb_values.sheetnames:
                info = None
            else:
                info = lookup_cell_direct(wb_values[root_sheet], wb_formulas[root_sheet], cell_ref)
            if info is None:
                st.error(f"Couldn't parse or find '{cell_ref}' on {root_sheet} -- check the reference (e.g. B30).")
                final_output_desc = None
            else:
                label_text = f'"{info["label"]}"' if info["label"] else "(no label found in column A)"
                if info["value"] is None and info["formula"]:
                    st.warning(
                        f"Row {info['row']}, col {info['col']}: {label_text}, formula {info['formula']} -- "
                        f"no cached value (this workbook wasn't last saved by Excel itself, so openpyxl can't "
                        f"read a computed result). The formula and label look fine to use regardless."
                    )
                else:
                    st.success(f"Row {info['row']}, col {info['col']}: {label_text} = {info['value']}")
                final_output_desc = f'{label_text} (cell {info["col"]}{info["row"]}) on {root_sheet}, value {info["value"]}'
        else:
            st.info("Enter a cell reference to confirm it before building the lineage.")
            final_output_desc = None
    else:
        candidates = detect_final_output_cell(raw_sheets[root_sheet])
        if candidates:
            options = [f"Row {r}, col {c}: \"{text}\" (match {score}%)" for r, c, text, score in candidates]
            choice_idx = st.selectbox("Best guesses, ranked -- confirm or pick a different one:", range(len(options)), format_func=lambda i: options[i])
            chosen = candidates[choice_idx]
            final_output_desc = f'"{chosen[2]}" (row {chosen[0]}, col {chosen[1]}) on {root_sheet}'
        else:
            st.warning("No row matched 'Taxable Income' / 'Line 30' well -- switch to direct entry instead.")
            final_output_desc = None

    st.subheader("3. Build the lineage")
    with st.expander("Line-schedule naming pattern (advanced)"):
        st.write(
            "Sheets matching this pattern are treated as calculation/support schedules "
            "(Process node) even if nothing formula-feeds them -- e.g. \"L20\", \"Line_15\", "
            "\"Sch M-1\" are line-item schedules for the return, not raw data sources, even "
            "when they're self-contained. Adjust if your tabs follow a different convention."
        )
        line_schedule_pattern = st.text_input(
            "Regex (case-insensitive, matched from the start of the sheet name)",
            value=LINE_SCHEDULE_PATTERN_DEFAULT,
        )
        test_name = st.text_input("Test a sheet name against this pattern", value="L20 Depreciation")
        if test_name:
            matched = matches_line_schedule_pattern(test_name, line_schedule_pattern)
            st.caption(("Matches" if matched else "Does not match") + f" -- \"{test_name}\"")

    if st.button("Trace lineage from this root", type="primary", disabled=final_output_desc is None):
        with st.spinner("Tracing formulas backward from root..."):
            traced_edges, visited = trace_lineage_from_root(root_sheet, formulas, defined_name_map)
        unmapped = [s for s in sheetnames if s not in visited]
        with st.spinner(f"Running fallback matching on {len(unmapped)} unreached sheet(s)..."):
            fallback_edges = _cached_fallback_match(tuple(unmapped), tuple(sorted(visited)), raw_sheets)
        lineage = classify_and_assemble(root_sheet, traced_edges, fallback_edges, final_output_desc, line_schedule_pattern)
        st.session_state["fld_lineage"] = lineage

        excluded = [s for s in unmapped if s not in fallback_edges]
        if excluded:
            st.warning(f"{len(excluded)} sheet(s) had no formula path AND no match clearing {CONFIDENCE_THRESHOLD}% -- excluded: {', '.join(excluded)}")

    if "fld_lineage" in st.session_state and st.session_state["fld_lineage"].get("schema_version") != LINEAGE_SCHEMA_VERSION:
        # Cached lineage was built by an older version of this file (before
        # formula_count/method existed on relationships, for example) --
        # discard it rather than render edges with blank labels.
        st.session_state.pop("fld_lineage", None)
        st.info("The lineage format changed since your last run -- click 'Trace lineage from this root' again to rebuild it.")

    if "fld_lineage" in st.session_state:
        lineage = st.session_state["fld_lineage"]

        st.divider()
        st.subheader("4. Result")
        nodes_df = pd.DataFrame(lineage["nodes"])
        rel_df = pd.DataFrame(lineage["relationships"])

        col1, col2 = st.columns(2)
        with col1:
            st.write("**Nodes**")
            st.dataframe(nodes_df, use_container_width=True, hide_index=True)
        with col2:
            st.write("**Relationships**")
            st.dataframe(rel_df, use_container_width=True, hide_index=True)

        st.divider()
        st.subheader("4a. Fuzzy match evidence -- jump to the matched cell in Excel")
        fallback_evidence = lineage.get("fallback_evidence", {})
        if not fallback_evidence:
            st.caption("No fuzzy-matched (description/value) connections in this lineage -- every sheet was linked by a real formula.")
        else:
            st.caption(
                "Requires pywin32 and Windows, with the SAME workbook already open in a local Excel "
                "instance -- this jumps that open window to the matched cell, it doesn't open a new copy."
            )
            for sheet, info in sorted(fallback_evidence.items()):
                parent = info["parent"]
                with st.expander(f"{sheet}  ~  {parent}   ({info['tier']}, {info.get('match_score', '?')}%)"):
                    st.write(info.get("evidence_detail", ""))

                    if info["tier"] == "description" and info.get("top_matches"):
                        for idx, m in enumerate(info["top_matches"]):
                            st.markdown(
                                f"**{idx + 1}.** `{m['text_a']}` (cell `{m.get('cell_a') or '?'}` on **{sheet}**) "
                                f"~ `{m['text_b']}` (cell `{m.get('cell_b') or '?'}` on **{parent}**) -- score {m['score']}"
                            )
                            b1, b2 = st.columns(2)
                            with b1:
                                if m.get("cell_a") and st.button(
                                    f"Open {sheet}!{m['cell_a']}", key=f"locate_desc_{sheet}_{parent}_{idx}_a"
                                ):
                                    ok, msg = locate_cell_in_excel(uploaded.name, sheet, m["cell_a"])
                                    (st.success if ok else st.error)(msg)
                            with b2:
                                if m.get("cell_b") and st.button(
                                    f"Open {parent}!{m['cell_b']}", key=f"locate_desc_{sheet}_{parent}_{idx}_b"
                                ):
                                    ok, msg = locate_cell_in_excel(uploaded.name, parent, m["cell_b"])
                                    (st.success if ok else st.error)(msg)

                    elif info["tier"] == "value":
                        cell_a, cell_b = info.get("cell_a"), info.get("cell_b")
                        if cell_a and cell_b:
                            b1, b2 = st.columns(2)
                            with b1:
                                if st.button(f"Open {sheet}!{cell_a}", key=f"locate_val_{sheet}_{parent}_a"):
                                    ok, msg = locate_cell_in_excel(uploaded.name, sheet, cell_a)
                                    (st.success if ok else st.error)(msg)
                            with b2:
                                if st.button(f"Open {parent}!{cell_b}", key=f"locate_val_{sheet}_{parent}_b"):
                                    ok, msg = locate_cell_in_excel(uploaded.name, parent, cell_b)
                                    (st.success if ok else st.error)(msg)
                        else:
                            st.caption("Couldn't resolve a specific cell for this match.")

        st.divider()
        st.subheader("5. Outputs")

        edge_filter_label = st.selectbox(
            "Connections to show in the visual",
            list(EDGE_FILTER_OPTIONS.keys()),
            index=0,
            help=(
                "Display-only -- doesn't change node classification, confidence scores, "
                "or the tables/exports below, which always reflect the full lineage. This "
                "just controls what's drawn (and traversed) in the diagram itself."
            ),
        )
        allowed_methods = EDGE_FILTER_OPTIONS[edge_filter_label]
        is_filtered = allowed_methods != EDGE_FILTER_OPTIONS["All connections (formula + named range + fuzzy matches)"]
        visual_lineage = filter_lineage_by_methods(lineage, allowed_methods) if is_filtered else lineage
        if is_filtered and len(visual_lineage["nodes"]) < len(lineage["nodes"]):
            hidden = len(lineage["nodes"]) - len(visual_lineage["nodes"])
            st.caption(f"{hidden} sheet(s) hidden from the visual -- only reachable via connections this filter excludes.")

        dl_col, vis_col, json_col = st.columns(3)

        with dl_col:
            st.download_button(
                "Download Excel", data=lineage_to_excel_bytes(lineage),
                file_name="filing_lineage.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )

        with vis_col:
            if st.button("Open Visual in New Tab"):
                html = build_lineage_visual_html(visual_lineage, filter_label=edge_filter_label if is_filtered else None)
                tmpdir = tempfile.mkdtemp(prefix="filing_lineage_")
                html_path = os.path.join(tmpdir, "lineage_visual.html")
                with open(html_path, "w", encoding="utf-8") as f:
                    f.write(html)
                webbrowser.open(f"file://{html_path}")
                st.success("Opened in a new browser tab (same machine this app is running on).")

        with json_col:
            st.download_button(
                "Download JSON", data=json.dumps(lineage, indent=2),
                file_name="filing_lineage.json", mime="application/json",
            )

        st.divider()
        st.subheader("6. Combined downstream flow from selected inputs")
        input_sources = sorted(n["sheet_name"] for n in lineage["nodes"] if n["classification"] == "Input source")

        if not input_sources:
            st.info("No sheets are currently classified as Input source in this lineage.")
        else:
            selected_inputs = st.multiselect(
                "Pick one or more input sheets -- their combined path(s) to the filing output will be merged into one flow:",
                input_sources,
            )

            if not selected_inputs:
                st.info("Select at least one input sheet to trace its combined flow to the filing output.")
            else:
                downstream = get_downstream_lineage_multi(lineage, selected_inputs)

                if downstream is None or len(downstream["nodes"]) <= len(selected_inputs) and len(downstream["relationships"]) == 0:
                    st.warning("None of the selected sheets lead anywhere further in this lineage -- no downstream path found.")
                else:
                    reached_root = lineage["filing_reference"] in {n["sheet_name"] for n in downstream["nodes"]}
                    not_reaching = [
                        s for s in selected_inputs
                        if lineage["filing_reference"] not in
                        {d for (src, d) in [(r["source"], r["target"]) for r in downstream["relationships"]] if src == s}
                        and s != lineage["filing_reference"]
                    ]
                    if reached_root:
                        st.success(
                            f"Combined path from {len(selected_inputs)} selected input(s) reaches the filing output "
                            f"through {len(downstream['nodes'])} sheet(s) total."
                        )
                    else:
                        st.warning(
                            f"Combined selection touches {len(downstream['nodes']) - len(selected_inputs)} downstream "
                            f"sheet(s), but no path reaches the filing output in this lineage."
                        )

                    down_col1, down_col2 = st.columns(2)
                    with down_col1:
                        st.dataframe(pd.DataFrame(downstream["nodes"]), use_container_width=True, hide_index=True)
                    with down_col2:
                        st.dataframe(pd.DataFrame(downstream["relationships"]), use_container_width=True, hide_index=True)

                    dd_col1, dd_col2, dd_col3 = st.columns(3)
                    combined_tag = "_".join(s.replace(" ", "-") for s in selected_inputs)[:60]
                    with dd_col1:
                        st.download_button(
                            "Download this path (xlsx)", data=lineage_to_excel_bytes(downstream),
                            file_name=f"combined_downstream_{combined_tag}.xlsx",
                            mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                            key="downstream_xlsx",
                        )
                    with dd_col2:
                        if st.button("Open this path's visual in new tab", key="downstream_visual"):
                            visual_downstream = (
                                filter_lineage_by_methods(downstream, allowed_methods) if is_filtered else downstream
                            )
                            html = build_lineage_visual_html(
                                visual_downstream, filter_label=edge_filter_label if is_filtered else None
                            )
                            tmpdir = tempfile.mkdtemp(prefix="filing_lineage_downstream_")
                            html_path = os.path.join(tmpdir, "downstream_visual.html")
                            with open(html_path, "w", encoding="utf-8") as f:
                                f.write(html)
                            webbrowser.open(f"file://{html_path}")
                            st.success("Opened in a new browser tab.")
                    with dd_col3:
                        st.download_button(
                            "Download this path (json)", data=json.dumps(downstream, indent=2),
                            file_name=f"combined_downstream_{combined_tag}.json", mime="application/json",
                            key="downstream_json",
                        )


if __name__ == "__main__":
    if st is None:
        raise SystemExit("Streamlit is required to run this app: pip install streamlit")
    run_app()
