def lineage_to_excel_bytes(lineage: dict) -> bytes:
    nodes_df = pd.DataFrame(lineage["nodes"])
    rel_df = pd.DataFrame(lineage["relationships"])
    summary_df = pd.DataFrame([{
        "Filing Reference": lineage["filing_reference"],
        "Final Output": lineage["final_output"],
        "Combined From": ", ".join(lineage["combined_from"]) if lineage.get("combined_from") else "",
        "Node Count": len(lineage["nodes"]),
        "Relationship Count": len(lineage["relationships"]),
    }])

    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        summary_df.to_excel(writer, index=False, sheet_name="Summary")
        nodes_df.to_excel(writer, index=False, sheet_name="Nodes")
        rel_df.to_excel(writer, index=False, sheet_name="Relationships")
    return buf.getvalue()


NODE_COLOR = {"Input source": "#2ecc71", "Process node": "#2a9d8f", "Output node": "#f1c40f"}
COMBINED_START_COLOR = "#e76f51"  # highlight the sheets the user picked, distinct from plain Input source green


def compute_lineage_depths(lineage: dict) -> dict:
    """
    BFS distance from the root over the relationship edges, root = depth 0.
    A direct feeder of the root is depth 1, a feeder of that is depth 2,
    etc. This gives a real, meaningful level for each node (based on
    actual traced/fallback lineage position) instead of relying on
    vis-network's automatic leveling, which doesn't know which node is
    the conceptually "final" one.
    """
    root = lineage["filing_reference"]
    feeds_into = {}  # src -> dst  (each node has exactly one primary parent in this schema)
    for n in lineage["nodes"]:
        if n["parent_sheet"]:
            feeds_into[n["sheet_name"]] = n["parent_sheet"]

    depths = {root: 0}
    for n in lineage["nodes"]:
        sheet = n["sheet_name"]
        if sheet in depths:
            continue
        # walk up the parent chain until we hit something with a known depth
        chain = []
        cursor = sheet
        seen = set()
        while cursor not in depths and cursor in feeds_into and cursor not in seen:
            seen.add(cursor)
            chain.append(cursor)
            cursor = feeds_into[cursor]
        base_depth = depths.get(cursor, 0)
        # chain[0] is the farthest sheet (original), chain[-1] is nearest
        # the already-known cursor -- so chain[0] gets the largest depth
        for j, s in enumerate(chain):
            depths[s] = base_depth + (len(chain) - j)
    return depths


def _edge_label_and_title(r: dict) -> tuple:
    """
    Builds the on-diagram edge label and hover tooltip from a relationship
    dict. Traced (formula/named_range) edges show the number of distinct
    formula cells on the target sheet that reference the source sheet, so
    the arrow itself communicates strength of linkage instead of the
    generic word "feeds". Fallback (description/value) edges carry no
    real formula count, so the label instead shows the match strength as
    a percentage (e.g. "~desc 78%"), and the tooltip spells out the exact
    evidence -- the matched text or shared values, and how many OTHER
    labels/columns corroborate it -- so a fuzzy match backed by a single
    coincidental word is visibly distinguishable from one backed by
    several independently-agreeing labels.
    """
    method = r.get("method")
    count = r.get("formula_count")
    src, dst = r["source"], r["target"]

    if method in ("formula", "named_range") and count:
        label = str(count)
        noun = "formula" if count == 1 else "formulas"
        via = " (via a named range)" if method == "named_range" else ""
        title = f"{count} {noun} on {dst} reference {src}{via}"
    elif method == "description":
        score = r.get("match_score")
        label = f"~desc {score:.0f}%" if score is not None else "~desc"
        detail = r.get("evidence_detail") or ""
        title = f"{src} matched to {dst} by description similarity -- no direct formula link found. {detail}"
    elif method == "value":
        score = r.get("match_score")
        label = f"~val {score:.0f}%" if score is not None else "~val"
        detail = r.get("evidence_detail") or ""
        title = f"{src} matched to {dst} by shared data values -- no direct formula link found. {detail}"
    else:
        label = ""
        title = f"{src} feeds {dst}"
    return label, title


