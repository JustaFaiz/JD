"""
filing_lineage_dashboard.py
----------------------------
Filing-centric lineage engine. You pick one sheet (e.g. "A_Taxable Income
Summary") as the filing reference / root node, and the tool builds the
lineage BACKWARD from it: every sheet that feeds it, directly or
transitively, via real cross-sheet formulas or Excel named ranges -- with
fuzzy description/value matching as a fallback for sheets no formula path
reaches at all.

Every node is classified purely by its position in the traced graph:
    - Output node   = the root you picked
    - Process node  = something feeds it, and it feeds something else
    - Input source  = nothing (discoverable) feeds it

Confidence is a fixed-tier ranking, not a blend -- the method that found
a given edge determines its confidence outright:
    1. Cell formula reference (direct cross-sheet formula)  -> 100%
    2. Named range link (formula uses a workbook-defined name) -> 90%
    3. Description similarity (fuzzy sheet name / row label match) -> 80%
    4. Value overlap (shared unique values between columns)  -> 70%
A sheet only enters the lineage if some method clears its tier's
detection bar; below 70% overall, it's excluded rather than force-fit.

PERFORMANCE NOTES (see comments inline for detail):
    - Workbook is parsed with read_only=True + values_only=True wherever
      possible -- this skips openpyxl's per-cell Cell object construction,
      which is the dominant cost on large workbooks.
    - Raw sheet values are pulled from the SAME data_only workbook via
      iter_rows(values_only=True) instead of a second, separate pass
      through pandas' own openpyxl engine -- this removes a full duplicate
      parse of the file.
    - Fuzzy description matching uses rapidfuzz.process.cdist, which scores
      an entire pool-by-pool matrix in one batched C call, instead of a
      nested Python double loop calling the scorer once per pair.
    - Expensive steps (formula/name extraction, raw sheet load, fallback
      matching) are wrapped in st.cache_data / st.cache_resource so
      Streamlit's per-interaction reruns don't repeat work that's already
      been done for the current file.
    - lookup_cell_direct no longer re-opens the workbook from bytes on
      every keystroke -- it reads from cached, already-open workbook
      objects.

Run with:
    streamlit run filing_lineage_dashboard.py
"""

import io
import os
import re
import json
import tempfile
import webbrowser

import pandas as pd
import numpy as np
from openpyxl import load_workbook
from openpyxl.utils import get_column_letter, column_index_from_string
from rapidfuzz import fuzz, process as rf_process

try:
    import streamlit as st
except ImportError:
    st = None  # allows importing this module's logic functions without Streamlit installed

try:
    import win32com.client as win32  # pywin32 -- Windows only
    _WIN32COM_AVAILABLE = True
except ImportError:
    _WIN32COM_AVAILABLE = False


def locate_cell_in_excel(workbook_name_hint: str, sheet_name: str, cell_ref: str):
    """
    Jumps to a specific cell in an ALREADY-OPEN Excel instance on this
    machine via COM automation, and returns (ok: bool, message: str).

    This only works: on Windows, with pywin32 installed, with Excel
    already running, and with the SAME workbook (matched by filename)
    already open in it -- it does not launch Excel or open a new copy of
    the file. That's a deliberate scope: this is meant to jump the Excel
    window you already have open to the exact cell a fuzzy match came
    from, not to manage files. It can't run from the standalone visual
    HTML (that's a static file opened in your browser, disconnected from
    this Python process) -- only from buttons inside the Streamlit app
    itself, since Streamlit runs Python locally on this same machine.
    """
    if not _WIN32COM_AVAILABLE:
        return False, "Needs pywin32 (`pip install pywin32`) and only works on Windows with Excel installed."
    if not cell_ref:
        return False, "No cell reference available for this match."
    try:
        excel_app = win32.GetActiveObject("Excel.Application")
    except Exception:
        return False, "Excel doesn't appear to be running right now -- open the workbook in Excel first."

    target_wb = None
    hint = (workbook_name_hint or "").lower()
    try:
        for wb in excel_app.Workbooks:
            if hint and hint in wb.Name.lower():
                target_wb = wb
                break
    except Exception as e:
        return False, f"Couldn't inspect open workbooks: {e}"
    if target_wb is None:
        return False, f"No open workbook matching '{workbook_name_hint}' was found -- make sure it's open in Excel."

    try:
        ws = target_wb.Worksheets(sheet_name)
    except Exception:
        return False, f"Sheet '{sheet_name}' wasn't found in the open workbook."

    try:
        excel_app.Visible = True
        target_wb.Activate()
        ws.Activate()
        ws.Range(cell_ref).Select()
        try:
            excel_app.ActiveWindow.Activate()
        except Exception:
            pass
    except Exception as e:
        return False, f"Couldn't select {cell_ref} on {sheet_name}: {e}"

    return True, f"Jumped to {sheet_name}!{cell_ref} in Excel."


# ---------------------------------------------------------------------------
# CONFIDENCE TIERS -- fixed by method, not blended
# ---------------------------------------------------------------------------

TIER_CONFIDENCE = {
    "formula": 100,        # direct cross-sheet cell/range formula reference
    "named_range": 90,     # formula uses a workbook-defined name resolving to another sheet
    "description": 80,     # fuzzy sheet-name / row-label match
    "value": 70,           # value-set overlap
}
CONFIDENCE_THRESHOLD = 70

# Sheets named after a form line item (L10, L26, Line_15, "Line 20", etc.)
# are calculation/support schedules, not raw data sources -- they're often
# self-contained (manual entries, or math with no formula link to another
# sheet), which would otherwise make "nothing feeds it" wrongly classify
# them as Input source. This pattern overrides that: a name matching it
# is treated as a Process node even with no discovered upstream feeder.
# Adjustable per-workbook via the UI, since naming conventions vary.
LINE_SCHEDULE_PATTERN_DEFAULT = r"^(l|line)[\s_\-]?\d+|^(sch|schedule)\b"

# Bumped whenever the shape of a lineage dict's relationships changes (e.g.
# adding formula_count/method). A lineage object cached in Streamlit's
# session_state from a previous version of this file won't have the new
# keys, and the edge-label code would then silently render blank labels
# instead of an error -- so the app checks this tag on load and discards
# a stale cached lineage rather than displaying it half-populated.
LINEAGE_SCHEMA_VERSION = 4


def matches_line_schedule_pattern(sheet_name, pattern):
    if not pattern:
        return False
    try:
        return bool(re.match(pattern, sheet_name.strip(), re.IGNORECASE))
    except re.error:
        return False

DESCRIPTION_DETECT_THRESHOLD = 55   # rapidfuzz score (0-100) to count as "a description match exists"
VALUE_DETECT_THRESHOLD = 0.25       # Jaccard overlap fraction to count as "a value match exists"

MAX_COLS_FOR_MATCHING = 15
MAX_ROWS_FOR_VALUE_MATCH = 300
MAX_ROWS_FOR_LABEL_SCAN = 500
MAX_POOL_ITEMS_FOR_FUZZ = 60  # cap on how many text items per sheet enter the cdist matrix


# ---------------------------------------------------------------------------
# FORMULA PARSING -- cross-sheet cell/range references
# (same approach as sheet_tree_server.py's extract_refs)
# ---------------------------------------------------------------------------

CELL_REF_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])(\$?[A-Z]{1,3}\$?\d{1,7})(?::(\$?[A-Z]{1,3}\$?\d{1,7}))?(?!\()"
)
COLUMN_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?([A-Z]{1,3})\$?:\$?([A-Z]{1,3})\$?(?![A-Za-z0-9_])"
)
ROW_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?(\d{1,7})\$?:\$?(\d{1,7})\$?(?![A-Za-z0-9_])"
)
# Bare identifier NOT immediately followed by "(" -- i.e. not a function call.
# Used to spot references to Excel defined names (named ranges) inside formulas.
NAME_TOKEN_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_.]*)\b(?!\()")

FULL_RANGE_ROW_CAP = 5000
FULL_RANGE_COL_CAP = 200


def extract_cross_sheet_refs(formula, current_sheet):
    """Returns the set of OTHER sheet names directly referenced by this formula
    via a standard cell/range/column/row reference (e.g. 'L20'!B12, or a
    bare B12 meaning the current sheet -- excluded since it's not cross-sheet)."""
    refs = set()
    for m in CELL_REF_RE.finditer(formula):
        sheet = m.group(1) or m.group(2)
        if sheet and sheet != current_sheet:
            refs.add(sheet)
    for m in COLUMN_ONLY_RE.finditer(formula):
        sheet = m.group(1) or m.group(2)
        if sheet and sheet != current_sheet:
            refs.add(sheet)
    for m in ROW_ONLY_RE.finditer(formula):
        sheet = m.group(1) or m.group(2)
        if sheet and sheet != current_sheet:
            refs.add(sheet)
    return refs


def extract_named_range_refs(formula, defined_name_map, current_sheet):
    """
    Scans a formula for bare identifiers that match a workbook-defined name
    (Name Manager), and returns the set of OTHER sheets that name resolves
    to. defined_name_map: {lowercase_name: set(sheet_names)}.
    """
    refs = set()
    for m in NAME_TOKEN_RE.finditer(formula):
        token = m.group(1).lower()
        if token in defined_name_map:
            for sheet in defined_name_map[token]:
                if sheet != current_sheet:
                    refs.add(sheet)
    return refs


def load_defined_name_map(wb):
    """
    Returns {lowercase_defined_name: set(sheet_names it resolves into)}.
    Handles both workbook-level (wb.defined_names) and worksheet-scoped
    names across openpyxl versions.
    """
    name_map = {}

    def add_destinations(name_obj, name_key):
        try:
            for sheet_name, _coord in name_obj.destinations:
                name_map.setdefault(name_key, set()).add(sheet_name)
        except Exception:
            pass

    try:
        for name_key, name_obj in wb.defined_names.items():
            add_destinations(name_obj, name_key.lower())
    except AttributeError:
        # very old openpyxl: defined_names might be a plain list
        for name_obj in getattr(wb, "defined_names", []):
            add_destinations(name_obj, getattr(name_obj, "name", "").lower())

    for ws in wb.worksheets:
        local_names = getattr(ws, "defined_names", None)
        if not local_names:
            continue
        try:
            for name_key, name_obj in local_names.items():
                add_destinations(name_obj, name_key.lower())
        except AttributeError:
            pass

    return name_map


def load_workbook_formulas(file_bytes):
    """
    Reads every formula in the workbook once. Returns:
        formulas: {(sheet, coord): formula_string}
        sheetnames: [str]
        defined_name_map: {lowercase_name: set(sheet_names)}

    PERFORMANCE: read_only=True + iter_rows(values_only=True) skips
    openpyxl's normal per-cell Cell object construction entirely -- for a
    workbook with real formulas this is the single biggest win available,
    since the old path built a full Cell object (with style refs etc.) for
    every populated cell just to check .value. In read_only + data_only=False
    mode, values_only=True still returns the formula string itself (not a
    cached result), so the "startswith('=')" check still works unchanged.
    Named-range destinations still resolve fine in read_only mode at the
    workbook level; worksheet-scoped names (rare) are still read from the
    ws object, which read_only mode also exposes.
    """
    wb = load_workbook(io.BytesIO(file_bytes), data_only=False, read_only=True)
    defined_name_map = load_defined_name_map(wb)

    formulas = {}
    for ws in wb.worksheets:
        for r_idx, row in enumerate(ws.iter_rows(values_only=True), start=1):
            for c_idx, value in enumerate(row, start=1):
                if isinstance(value, str) and value.startswith("="):
                    coord = f"{get_column_letter(c_idx)}{r_idx}"
                    formulas[(ws.title, coord)] = value
    sheetnames = wb.sheetnames
    wb.close()
    return formulas, sheetnames, defined_name_map


def load_raw_sheets(file_bytes):
    """
    Builds {sheet_name: DataFrame} directly from a single data_only,
    read_only openpyxl pass -- header row becomes columns, same shape
    pd.read_excel(sheet_name=None) would give.

    PERFORMANCE: this replaces a separate pd.read_excel(sheet_name=None)
    call, which under the hood opens and re-parses the ENTIRE workbook a
    second time through openpyxl's normal (non read-only) engine. Reading
    values_only rows ourselves means the file is only ever fully parsed
    twice total for the whole app (once for formulas, once for values)
    instead of three times, and both passes use the fast read_only path.
    """
    wb = load_workbook(io.BytesIO(file_bytes), data_only=True, read_only=True)
    raw_sheets = {}
    for ws in wb.worksheets:
        rows = list(ws.iter_rows(values_only=True))
        if not rows:
            raw_sheets[ws.title] = pd.DataFrame()
            continue
        header, *body = rows
        header = [h if h is not None else f"Unnamed: {i}" for i, h in enumerate(header)]
        df = pd.DataFrame(body, columns=header)
        raw_sheets[ws.title] = df
    wb.close()
    return raw_sheets


# ---------------------------------------------------------------------------
# BACKWARD TRAVERSAL FROM THE ROOT
# ---------------------------------------------------------------------------

def trace_lineage_from_root(root_sheet, formulas, defined_name_map):
    """
    BFS backward from root_sheet along real formula references. An edge
    (src -> dst) means "src feeds dst". Returns:
        edges: {(src, dst): {"tier": "formula"|"named_range", "confidence": int, "count": int}}
        visited: set of sheet names reached (includes root_sheet)

    Tie-break: if a (src, dst) pair is found via BOTH a direct formula ref
    and a named-range ref, the direct formula (higher tier) wins for
    confidence purposes.

    "count" is the number of DISTINCT formula cells on the dst sheet that
    reference the src sheet at all (via a direct ref, a named range, or
    both) -- this is tracked independently of the tier logic above, so a
    formula that uses both a direct ref and a named range into the same
    src sheet still only counts once, matching "how many of my formulas
    pull from that sheet" rather than "how many individual cell tokens".
    """
    edges = {}
    counts = {}
    visited = {root_sheet}
    frontier = [root_sheet]

    # index formulas by sheet for fast lookup
    formulas_by_sheet = {}
    for (sheet, coord), f in formulas.items():
        formulas_by_sheet.setdefault(sheet, []).append(f)

    while frontier:
        next_frontier = []
        for current in frontier:
            for f in formulas_by_sheet.get(current, []):
                direct_refs = extract_cross_sheet_refs(f, current)
                named_refs = extract_named_range_refs(f, defined_name_map, current) - direct_refs
                all_refs = direct_refs | named_refs

                for src in all_refs:
                    counts[(src, current)] = counts.get((src, current), 0) + 1

                for src in direct_refs:
                    key = (src, current)
                    if key not in edges or edges[key]["tier"] != "formula":
                        edges[key] = {"tier": "formula", "confidence": TIER_CONFIDENCE["formula"]}
                    if src not in visited:
                        visited.add(src)
                        next_frontier.append(src)

                for src in named_refs:
                    key = (src, current)
                    if key not in edges:
                        edges[key] = {"tier": "named_range", "confidence": TIER_CONFIDENCE["named_range"]}
                    if src not in visited:
                        visited.add(src)
                        next_frontier.append(src)
        frontier = next_frontier

    for key, info in edges.items():
        info["count"] = counts.get(key, 0)

    return edges, visited


# ---------------------------------------------------------------------------
# FALLBACK: description similarity + value overlap for unreached sheets
# ---------------------------------------------------------------------------

def build_text_pool(df, sheet_name, max_rows=MAX_ROWS_FOR_LABEL_SCAN):
    """
    Sheet name + up to max_rows of text-like cell values (row labels), for
    description matching. Returns (texts, cell_refs) as two parallel lists
    -- cell_refs[i] is the Excel cell (e.g. "B12") that texts[i] came from,
    or None for the sheet-name entry at index 0. Column position maps
    directly to Excel column letter (df columns preserve left-to-right
    sheet order from load_raw_sheets), and row position + 2 accounts for
    the header row consumed when the DataFrame was built.
    """
    texts = [sheet_name]
    cell_refs = [None]
    for col_pos, col in enumerate(df.columns[:MAX_COLS_FOR_MATCHING]):
        col_letter = get_column_letter(col_pos + 1)
        series = df[col].dropna().astype(str).head(max_rows)
        for row_pos, v in series.items():
            if v.replace(".", "", 1).replace("-", "", 1).isdigit():
                continue
            texts.append(v)
            cell_refs.append(f"{col_letter}{row_pos + 2}")
    if len(texts) > MAX_POOL_ITEMS_FOR_FUZZ:
        return texts[:MAX_POOL_ITEMS_FOR_FUZZ], cell_refs[:MAX_POOL_ITEMS_FOR_FUZZ]
    return texts, cell_refs


def description_similarity(pool_a, pool_b, locations_a=None, locations_b=None, top_k=5):
    """
    Returns a dict quantifying the fuzzy match between two text pools, not
    just a bare score:
        score                 -- best single pairwise match, 0-100
        text_a, text_b        -- the actual two strings that produced it,
                                  so you can eyeball whether it's a real
                                  label match or a coincidental short word
        corroborating_matches -- how many OTHER items in pool_a also found
                                  a decent (>= DESCRIPTION_DETECT_THRESHOLD)
                                  match somewhere in pool_b. A score of 1
                                  means the whole match rests on a single
                                  pair; anything higher means multiple
                                  independent labels agree.
        top_matches            -- up to top_k of those corroborating pairs
                                  (sorted strongest-first), each with its
                                  own text_a/text_b/score and, if locations
                                  were supplied, cell_a/cell_b -- so a
                                  match can be inspected in detail instead
                                  of collapsing everything into one pair.

    PERFORMANCE: still one batched rapidfuzz.process.cdist call scoring
    the full pool_a x pool_b matrix, same as before -- corroboration count
    and the top-k list are both free by-products of already having the
    full matrix (row-wise max/argmax + a sort), not an extra scoring pass.
    """
    empty = {"score": 0.0, "text_a": None, "text_b": None, "corroborating_matches": 0, "top_matches": []}
    if not pool_a or not pool_b:
        return empty
    matrix = rf_process.cdist(pool_a, pool_b, scorer=fuzz.token_sort_ratio)
    if matrix.size == 0:
        return empty

    row_best_idx = matrix.argmax(axis=1)
    row_best_score = matrix.max(axis=1)
    order = np.argsort(-row_best_score)  # strongest match first

    best_i = int(order[0])
    best_j = int(row_best_idx[best_i])
    best_score = float(row_best_score[best_i])
    corroborating = int((row_best_score >= DESCRIPTION_DETECT_THRESHOLD).sum())

    top_matches = []
    for i in order:
        i = int(i)
        score = float(row_best_score[i])
        if score < DESCRIPTION_DETECT_THRESHOLD:
            break  # order is descending, nothing further qualifies
        j = int(row_best_idx[i])
        entry = {"text_a": pool_a[i], "text_b": pool_b[j], "score": round(score, 1)}
        if locations_a is not None:
            entry["cell_a"] = locations_a[i]
        if locations_b is not None:
            entry["cell_b"] = locations_b[j]
        top_matches.append(entry)
        if len(top_matches) >= top_k:
            break

    return {
        "score": best_score, "text_a": pool_a[best_i], "text_b": pool_b[best_j],
        "corroborating_matches": corroborating, "top_matches": top_matches,
    }


def value_overlap_score(series_a: pd.Series, series_b: pd.Series) -> float:
    set_a = set(series_a.dropna().astype(str).str.strip().str.upper())
    set_b = set(series_b.dropna().astype(str).str.strip().str.upper())
    if not set_a or not set_b:
        return 0.0
    smaller = min(len(set_a), len(set_b))
    return (len(set_a & set_b) / smaller) if smaller else 0.0


def value_similarity(df_a, df_b):
    """
    Returns a dict quantifying the value-overlap match between two sheets:
        score                -- average best per-column Jaccard overlap,
                                 0-1 (same number the accept/reject
                                 decision is based on, unchanged)
        column_a, column_b   -- the single strongest-matching column pair,
                                 as a concrete illustration of the match
        overlap_count        -- how many actual values those two columns
                                 share
        smaller_set_size     -- size of the smaller of the two value sets
                                 being compared (the overlap denominator)
        sample_shared_values -- up to 5 of the actual shared values, so
                                 you can see whether it's a handful of
                                 generic values or a real, specific match
        corroborating_columns -- how many column pairs (not just the best
                                 one) independently clear the detection
                                 threshold. 1 means only one column pair is
                                 carrying the whole match.
    """
    cols_a = list(df_a.columns)[:MAX_COLS_FOR_MATCHING]
    cols_b = list(df_b.columns)[:MAX_COLS_FOR_MATCHING]
    empty = {
        "score": 0.0, "column_a": None, "column_b": None, "overlap_count": 0,
        "smaller_set_size": 0, "sample_shared_values": [], "corroborating_columns": 0,
    }
    if not cols_a or not cols_b:
        return empty

    sample_a = df_a[cols_a].head(MAX_ROWS_FOR_VALUE_MATCH)
    sample_b = df_b[cols_b].head(MAX_ROWS_FOR_VALUE_MATCH)
    sets_b = {}
    for cb in cols_b:
        try:
            sets_b[cb] = set(sample_b[cb].dropna().astype(str).str.strip().str.upper())
        except Exception:
            sets_b[cb] = set()

    per_col_best = []  # (column_a, score, column_b, overlap_count, smaller_size, shared_values_set)
    for ca in cols_a:
        try:
            set_a = set(sample_a[ca].dropna().astype(str).str.strip().str.upper())
        except Exception:
            set_a = set()
        best_score, best_cb, best_overlap, best_smaller, best_shared = 0.0, None, 0, 0, set()
        if set_a:
            for cb in cols_b:
                set_b = sets_b[cb]
                if not set_b:
                    continue
                smaller = min(len(set_a), len(set_b))
                shared = set_a & set_b
                score = (len(shared) / smaller) if smaller else 0.0
                if score > best_score:
                    best_score, best_cb, best_overlap, best_smaller, best_shared = score, cb, len(shared), smaller, shared
        per_col_best.append((ca, best_score, best_cb, best_overlap, best_smaller, best_shared))

    avg_score = sum(e[1] for e in per_col_best) / len(per_col_best) if per_col_best else 0.0
    corroborating_columns = sum(1 for e in per_col_best if e[1] >= VALUE_DETECT_THRESHOLD)
    top = max(per_col_best, key=lambda e: e[1]) if per_col_best else None

    if top and top[1] > 0:
        column_a, _, column_b, overlap_count, smaller_set_size, shared_values = top
        sample_shared_values = sorted(shared_values)[:5]
    else:
        column_a = column_b = None
        overlap_count = smaller_set_size = 0
        sample_shared_values = []

    # Locate a concrete cell for the first sample value, on both sides --
    # this is what powers the "jump to this cell in Excel" button. Only
    # the first sample value is worth resolving to a cell (illustrative
    # anchor point); the rest of sample_shared_values stays text-only.
    cell_a = cell_b = None
    if sample_shared_values:
        first_val = sample_shared_values[0]
        try:
            col_pos_a = cols_a.index(column_a)
            match_a = sample_a[column_a].dropna().astype(str).str.strip().str.upper()
            row_idx_a = match_a[match_a == first_val].index
            if len(row_idx_a) > 0:
                cell_a = f"{get_column_letter(col_pos_a + 1)}{row_idx_a[0] + 2}"
        except Exception:
            pass
        try:
            col_pos_b = cols_b.index(column_b)
            match_b = sample_b[column_b].dropna().astype(str).str.strip().str.upper()
            row_idx_b = match_b[match_b == first_val].index
            if len(row_idx_b) > 0:
                cell_b = f"{get_column_letter(col_pos_b + 1)}{row_idx_b[0] + 2}"
        except Exception:
            pass

    return {
        "score": avg_score, "column_a": column_a, "column_b": column_b,
        "overlap_count": overlap_count, "smaller_set_size": smaller_set_size,
        "sample_shared_values": sample_shared_values, "corroborating_columns": corroborating_columns,
        "cell_a": cell_a, "cell_b": cell_b,
    }


def fallback_match_unreached_sheets(unmapped_sheets, lineage_sheets, raw_sheets):
    """
    For every sheet no formula path reached, tries description similarity
    first, then value overlap, against every sheet already in the lineage.
    Picks the single best-scoring candidate parent per method; if description
    clears its detection bar, that wins outright (higher tier) without even
    checking value overlap for that sheet.

    Each accepted match carries concrete, inspectable evidence -- not just
    a bare score -- including actual Excel cell references, so a match can
    be judged (and located) rather than taken on faith:
      description matches -- match_score, corroborating_matches (how many
        OTHER labels also agreed, not just the top one), top_matches (up
        to 5 of those matched text pairs, each with its own score and the
        exact cell it came from on both sheets), evidence_detail (a
        readable summary of the top pairs, cell refs included)
      value matches -- match_score, overlap_count/overlap_total (how many
        values actually overlap, out of how many), corroborating_columns
        (how many column pairs agree, not just one), cell_a/cell_b (the
        cell of one concrete shared value, on each sheet), evidence_detail
        (a sample of the actual shared values plus that cell pair)

    Returns {sheet_name: {"parent": str, "tier": str, "confidence": int, ...evidence}}
    for sheets that clear CONFIDENCE_THRESHOLD; sheets that don't clear
    either bar are simply absent (excluded from the lineage).
    """
    results = {}
    text_pools = {}       # sheet -> texts
    text_pool_cells = {}  # sheet -> parallel cell_refs
    for s in lineage_sheets:
        if s in raw_sheets:
            texts, cells = build_text_pool(raw_sheets[s], s)
            text_pools[s] = texts
            text_pool_cells[s] = cells

    for sheet in unmapped_sheets:
        if sheet not in raw_sheets:
            continue
        df = raw_sheets[sheet]
        pool, pool_cells = build_text_pool(df, sheet)

        best_desc, best_desc_parent = None, None
        for parent in lineage_sheets:
            if parent not in text_pools:
                continue
            detail = description_similarity(pool, text_pools[parent], pool_cells, text_pool_cells[parent])
            if best_desc is None or detail["score"] > best_desc["score"]:
                best_desc, best_desc_parent = detail, parent

        if best_desc and best_desc["score"] >= DESCRIPTION_DETECT_THRESHOLD:
            corroborating = best_desc["corroborating_matches"]
            top_matches = best_desc["top_matches"]
            corroboration_note = (
                f"; {corroborating} other label(s) also matched" if corroborating > 1
                else "; only this one label matched -- treat with caution"
            )
            pairs_text = "; ".join(
                f"'{m['text_a']}' (cell {m.get('cell_a') or '?'} on {sheet}) ~ "
                f"'{m['text_b']}' (cell {m.get('cell_b') or '?'} on {best_desc_parent})"
                for m in top_matches[:3]
            )
            results[sheet] = {
                "parent": best_desc_parent, "tier": "description",
                "confidence": TIER_CONFIDENCE["description"],
                "match_score": round(best_desc["score"], 1),
                "corroborating_matches": corroborating,
                "top_matches": top_matches,
                "evidence_detail": f"{pairs_text}{corroboration_note}",
            }
            continue

        best_val, best_val_parent = None, None
        for parent in lineage_sheets:
            if parent not in raw_sheets:
                continue
            detail = value_similarity(df, raw_sheets[parent])
            if best_val is None or detail["score"] > best_val["score"]:
                best_val, best_val_parent = detail, parent

        if best_val and best_val["score"] >= VALUE_DETECT_THRESHOLD:
            sample_str = ", ".join(best_val["sample_shared_values"][:3]) if best_val["sample_shared_values"] else "n/a"
            corroborating_cols = best_val["corroborating_columns"]
            corroboration_note = (
                f"; {corroborating_cols} column pair(s) corroborate" if corroborating_cols > 1
                else "; only one column pair matched -- treat with caution"
            )
            cell_a, cell_b = best_val.get("cell_a"), best_val.get("cell_b")
            cell_text = f" -- e.g. {sheet}!{cell_a} = {best_val_parent}!{cell_b}" if cell_a and cell_b else ""
            results[sheet] = {
                "parent": best_val_parent, "tier": "value",
                "confidence": TIER_CONFIDENCE["value"],
                "match_score": round(best_val["score"] * 100, 1),
                "overlap_count": best_val["overlap_count"],
                "overlap_total": best_val["smaller_set_size"],
                "corroborating_columns": corroborating_cols,
                "cell_a": cell_a, "cell_b": cell_b,
                "evidence_detail": (
                    f"{best_val['overlap_count']} of {best_val['smaller_set_size']} shared values in "
                    f"{best_val['column_a']} vs {best_val['column_b']} (e.g. {sample_str}){cell_text}{corroboration_note}"
                ),
            }

    return {k: v for k, v in results.items() if v["confidence"] >= CONFIDENCE_THRESHOLD}



