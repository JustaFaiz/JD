"""
Streamlit dashboard for end-to-end lineage discovery -- single workpaper version.

Accepts ONE Excel workbook containing multiple tabs (SAP TB, Corptax, Longview,
ERS, DTTU, filing schedule, etc.), auto-identifies which tab is which system
from the sheet name (and column signatures as a fallback), lets you confirm
or override each guess, then runs the same overlap discovery + field mapping
as before across the confirmed tabs.

Run with:
    streamlit run lineage_dashboard.py
"""

import itertools
import io

import pandas as pd
import streamlit as st
from rapidfuzz import fuzz


# ---------------------------------------------------------------------------
# TAB IDENTIFICATION -- guess system from sheet name + column signatures
# ---------------------------------------------------------------------------

# Aliases used to fuzzy-match sheet names to a system label.
SYSTEM_ALIASES = {
    "SAP_TB":   ["sap", "tb", "trial balance", "sap tb", "gl extract", "sap extract"],
    "ERS":      ["ers", "estimated return summary", "ers extract"],
    "DTTU":     ["dttu", "deferred tax true up", "deferred tax true-up", "true up", "true-up", "dtt"],
    "Longview": ["longview", "lv", "lv upload", "upload template", "consolidation"],
    "Corptax":  ["corptax", "corp tax", "ctx", "corptax import"],
    "Filing":   ["filing", "return", "schedule", "tax return", "filed"],
}

# Column-name keywords that are typical signatures of each system, used as a
# fallback/confidence-booster when the sheet name itself is ambiguous
# (e.g. tabs named "Sheet1", "Data", "Tab3").
SYSTEM_COLUMN_SIGNATURES = {
    "SAP_TB":   ["company code", "gl account", "cost center", "werks", "doc type", "posting"],
    "ERS":      ["entity id", "return type", "estimate", "ers"],
    "DTTU":     ["true up", "true-up", "deferred tax", "dtl", "dta", "temporary difference"],
    "Longview": ["consolidation", "adjustment code", "elimination", "reporting entity"],
    "Corptax":  ["tax year", "entity", "m-1", "m-3", "schedule", "federal taxable"],
    "Filing":   ["form", "line item", "filed amount", "jurisdiction"],
}


def guess_system_for_sheet(sheet_name: str, df: pd.DataFrame):
    """
    Returns (best_system, confidence 0-100, reason string, breakdown dict).

    IMPORTANT: column headers are ALWAYS scanned, regardless of how well (or
    badly) the sheet name matches. A tab named "Sheet3" with SAP-style columns
    scores just as well on the column signal as a tab literally named "SAP_TB".
    The two signals are combined (not one gating the other), so a sheet name
    that matches nothing but has strongly matching columns still surfaces
    correctly -- and the breakdown dict lets the UI show both scores side by
    side, so you can see a name/column disagreement instead of it being
    silently resolved.
    """
    # Signal 1: sheet name vs. aliases (always computed)
    name_scores = {}
    for system, aliases in SYSTEM_ALIASES.items():
        name_scores[system] = max(fuzz.partial_ratio(sheet_name.lower(), a) for a in aliases)

    # Signal 2: column headers vs. keyword signatures (always computed,
    # independent of signal 1 -- this is what catches a mislabeled/generic
    # sheet name with real system-specific columns)
    cols_lower = " | ".join(str(c).lower() for c in df.columns)
    col_scores_raw = {}
    for system, keywords in SYSTEM_COLUMN_SIGNATURES.items():
        col_scores_raw[system] = sum(1 for kw in keywords if kw in cols_lower)
    # normalize hits to a 0-100 scale per system (relative to that system's keyword list length)
    col_scores = {
        system: min(100, (hits / len(SYSTEM_COLUMN_SIGNATURES[system])) * 100 * 1.3)
        for system, hits in col_scores_raw.items()
    }

    # Combine: equal weight. A system only wins if it's genuinely supported
    # by name OR strongly by columns -- not just because it edged out others
    # on a near-zero score.
    combined = {
        system: 0.5 * name_scores[system] + 0.5 * col_scores[system]
        for system in SYSTEM_ALIASES
    }
    best_system = max(combined, key=combined.get)
    best_confidence = combined[best_system]

    breakdown = {
        "name_score": name_scores[best_system],
        "col_score": round(col_scores[best_system]),
        "col_hits": col_scores_raw[best_system],
    }

    if best_confidence < 30:
        return "Unassigned", 0, "no strong signal on name or columns -- assign manually", breakdown

    if name_scores[best_system] >= 70 and col_scores_raw[best_system] >= 1:
        reason = f"sheet name AND {col_scores_raw[best_system]} column(s) both agree"
    elif name_scores[best_system] >= 70:
        reason = f"sheet name matched '{sheet_name}' (columns didn't confirm)"
    elif col_scores_raw[best_system] >= 2:
        reason = f"{col_scores_raw[best_system]} column keywords matched (sheet name didn't help)"
    else:
        reason = f"weak combined signal on '{sheet_name}'"

    return best_system, round(best_confidence), reason, breakdown


# ---------------------------------------------------------------------------
# CORE MATCHING LOGIC (unchanged from prior version)
# ---------------------------------------------------------------------------

def match_headers(df_a: pd.DataFrame, df_b: pd.DataFrame, threshold: int):
    matches = []
    used_targets = set()
    for col_a in df_a.columns:
        best_score, best_col_b, best_method = 0, None, None
        for col_b in df_b.columns:
            if col_b in used_targets:
                continue
            sort_score = fuzz.token_sort_ratio(str(col_a), str(col_b))
            partial_score = fuzz.partial_ratio(str(col_a), str(col_b))
            score, method = max((sort_score, "token_sort"), (partial_score, "partial"))
            if score > best_score:
                best_score, best_col_b, best_method = score, col_b, method
        if best_score >= threshold:
            matches.append({
                "source_field": col_a, "target_field": best_col_b,
                "score": best_score, "method": f"name:{best_method}",
            })
            used_targets.add(best_col_b)
    return matches


def value_overlap_score(series_a: pd.Series, series_b: pd.Series) -> float:
    set_a = set(series_a.dropna().astype(str).str.strip().str.upper())
    set_b = set(series_b.dropna().astype(str).str.strip().str.upper())
    if not set_a or not set_b:
        return 0.0
    smaller = min(len(set_a), len(set_b))
    return (len(set_a & set_b) / smaller) if smaller else 0.0


def match_by_values(df_a: pd.DataFrame, df_b: pd.DataFrame,
                     already_matched_targets: set, threshold: float):
    matches = []
    used_targets = set(already_matched_targets)
    for col_a in df_a.columns:
        best_score, best_col_b = 0.0, None
        for col_b in df_b.columns:
            if col_b in used_targets:
                continue
            if df_a[col_a].dtype.kind not in "OUS" and df_b[col_b].dtype.kind in "OUS":
                continue
            score = value_overlap_score(df_a[col_a], df_b[col_b])
            if score > best_score:
                best_score, best_col_b = score, col_b
        if best_score >= threshold:
            matches.append({
                "source_field": col_a, "target_field": best_col_b,
                "score": round(best_score * 100, 1), "method": "value_overlap",
            })
            used_targets.add(best_col_b)
    return matches


def field_level_mapping(df_a, df_b, source_system, target_system,
                         header_threshold, value_threshold):
    header_matches = match_headers(df_a, df_b, header_threshold)
    matched_targets = {m["target_field"] for m in header_matches}
    value_matches = match_by_values(df_a, df_b, matched_targets, value_threshold)
    all_matches = header_matches + value_matches
    matched_targets |= {m["target_field"] for m in value_matches}

    rows = []
    for m in all_matches:
        rows.append({
            "Source System": source_system, "Source Field": m["source_field"],
            "Transformation": "direct" if m["score"] >= 95 else "mapped/renamed",
            "Target System": target_system, "Target Field": m["target_field"],
            "Adjustment Type": "", "Match Confidence": m["score"],
            "Match Method": m["method"], "SME Confirmed": "Pending",
        })
    for col_b in df_b.columns:
        if col_b not in matched_targets:
            rows.append({
                "Source System": "(none found)", "Source Field": "",
                "Transformation": "manual/adjustment - unverified",
                "Target System": target_system, "Target Field": col_b,
                "Adjustment Type": "Candidate M-1/M-3 or manual entry - CONFIRM WITH SME",
                "Match Confidence": 0, "Match Method": "no_match", "SME Confirmed": "Pending",
            })
    return pd.DataFrame(rows)


def pairwise_overlap_report(dfs: dict, header_threshold: int, value_threshold: float,
                             min_matched_fields: int) -> pd.DataFrame:
    results = []
    for sys_a, sys_b in itertools.permutations(dfs.keys(), 2):
        df_a, df_b = dfs[sys_a], dfs[sys_b]
        header_matches = match_headers(df_a, df_b, header_threshold)
        matched_targets = {m["target_field"] for m in header_matches}
        value_matches = match_by_values(df_a, df_b, matched_targets, value_threshold)
        total = len(header_matches) + len(value_matches)
        avg_conf = (sum(m["score"] for m in header_matches + value_matches) / total) if total else 0
        results.append({
            "From": sys_a, "To": sys_b, "Matched Fields": total,
            "Avg Confidence": round(avg_conf, 1),
            "Candidate Edge": total >= min_matched_fields,
        })

    columns = ["From", "To", "Matched Fields", "Avg Confidence", "Candidate Edge"]
    if not results:
        return pd.DataFrame(columns=columns)
    return pd.DataFrame(results, columns=columns).sort_values(
        ["Candidate Edge", "Matched Fields"], ascending=[False, False]
    ).reset_index(drop=True)


def to_excel_bytes(df: pd.DataFrame) -> bytes:
    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        df.to_excel(writer, index=False)
    return buf.getvalue()


def build_lineage_diagram(report: pd.DataFrame, confirmed_pair: tuple = None) -> str:
    """
    Builds a Graphviz DOT diagram of confirmed candidate edges: boxes for
    each system, arrows for each candidate connection, labeled with matched
    field count and confidence. Edge color signals strength; the currently
    selected pair (if any) is highlighted thicker.
    """
    edges = report[report["Candidate Edge"]] if not report.empty else report
    nodes = sorted(set(edges["From"]) | set(edges["To"]))

    lines = ['digraph lineage {', '  rankdir=LR;', '  node [shape=box, style="rounded,filled", fillcolor="#eaf1fb", fontname="Helvetica", fontsize=11];', '  edge [fontname="Helvetica", fontsize=9];']

    for n in nodes:
        lines.append(f'  "{n}";')

    for _, row in edges.iterrows():
        conf = row["Avg Confidence"]
        color = "#2e7d32" if conf >= 80 else ("#f9a825" if conf >= 60 else "#c62828")
        is_selected = confirmed_pair and (row["From"], row["To"]) == confirmed_pair
        penwidth = 3 if is_selected else 1.5
        label = f'{int(row["Matched Fields"])} fields, {conf:.0f}%'
        lines.append(f'  "{row["From"]}" -> "{row["To"]}" [label="{label}", color="{color}", penwidth={penwidth}];')

    lines.append('}')
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# STREAMLIT UI
# ---------------------------------------------------------------------------

st.set_page_config(page_title="Lineage Discovery", layout="wide")
st.title("End-to-End Lineage Discovery")
st.caption("Upload one workpaper (multiple tabs) → auto-identify each tab's system → discover connections → build the field-level mapping log.")

with st.sidebar:
    st.header("Matching sensitivity")
    header_threshold = st.slider("Header name match threshold", 50, 100, 80)
    value_threshold = st.slider("Value overlap threshold", 0.0, 1.0, 0.5, 0.05)
    min_matched_fields = st.slider("Min matched fields to call it a candidate edge", 1, 10, 2)

st.subheader("1. Upload your workpaper")
workpaper = st.file_uploader("Excel workbook with one tab per system", type=["xlsx", "xls"])

if workpaper is not None:
    raw_sheets = pd.read_excel(workpaper, sheet_name=None)  # dict: {sheet_name: df}
    st.success(f"Found {len(raw_sheets)} tabs: {list(raw_sheets.keys())}")

    st.subheader("2. Confirm which tab is which system")
    st.write("Best guess is pre-filled from the sheet name and column contents. Override anything that's wrong, and set unrelated tabs (notes, cover sheets) to *Skip*.")

    system_options = list(SYSTEM_ALIASES.keys()) + ["Skip", "Other (type below)"]
    assignments = {}

    for sheet_name, df in raw_sheets.items():
        guess, confidence, reason, breakdown = guess_system_for_sheet(sheet_name, df)
        default_idx = system_options.index(guess) if guess in system_options else system_options.index("Skip")

        col1, col2, col3 = st.columns([2, 2, 3])
        with col1:
            st.markdown(f"**{sheet_name}**")
            st.caption(f"{len(df)} rows x {len(df.columns)} cols")
        with col2:
            choice = st.selectbox(
                "System", system_options, index=default_idx,
                key=f"assign_{sheet_name}", label_visibility="collapsed",
            )
        with col3:
            st.caption(f"Guess: {guess} ({confidence}% combined) - {reason}")
            st.caption(
                f"  name-match: {breakdown['name_score']:.0f}% · "
                f"column-match: {breakdown['col_score']:.0f}% ({breakdown['col_hits']} keyword hits)"
            )

        if choice == "Other (type below)":
            custom = st.text_input(f"Custom label for '{sheet_name}'", key=f"custom_{sheet_name}")
            if custom.strip():
                assignments[custom.strip()] = df
        elif choice != "Skip":
            assignments[choice] = df

    st.divider()
    st.subheader("3. Discover candidate edges")
    st.write(f"Confirmed tabs: {list(assignments.keys()) if assignments else 'none yet'}")

    if st.button("Run discovery", type="primary", disabled=len(assignments) < 2):
        st.session_state["report"] = pairwise_overlap_report(
            assignments, header_threshold, value_threshold, min_matched_fields
        )
        st.session_state["dfs"] = assignments

    if len(assignments) < 2:
        st.info("Confirm at least 2 tabs to a system (not Skip) to run discovery.")

    if "report" in st.session_state:
        report = st.session_state["report"]
        st.dataframe(
            report.style.apply(
                lambda row: ["background-color: #d4f7d4" if row["Candidate Edge"] else "" for _ in row],
                axis=1,
            ),
            use_container_width=True,
        )
        st.download_button(
            "Download edge discovery report (xlsx)",
            data=to_excel_bytes(report),
            file_name="lineage_edge_discovery.xlsx",
        )

        st.divider()
        st.subheader("4. Field-level mapping for a confirmed pair")

        dfs = st.session_state["dfs"]
        candidate_pairs = report[report["Candidate Edge"]] if not report.empty else report
        pair_options = [f"{r['From']} -> {r['To']}" for _, r in candidate_pairs.iterrows()] or \
                       [f"{r['From']} -> {r['To']}" for _, r in report.iterrows()]

        if pair_options:
            selected = st.selectbox("Choose a pair", pair_options)
            from_sys, to_sys = selected.split(" -> ")

            if st.button("Generate field-level mapping"):
                st.session_state["mapping_df"] = field_level_mapping(
                    dfs[from_sys], dfs[to_sys], from_sys, to_sys,
                    header_threshold, value_threshold,
                )
                st.session_state["mapping_pair"] = selected

            if "mapping_df" in st.session_state:
                st.write(f"**{st.session_state['mapping_pair']}**")
                mapping_df = st.session_state["mapping_df"]

                def highlight_row(row):
                    return ["background-color: #fff3cd" for _ in row] if row["Adjustment Type"] else ["" for _ in row]

                st.dataframe(mapping_df.style.apply(highlight_row, axis=1), use_container_width=True)
                st.download_button(
                    "Download field mapping (xlsx)",
                    data=to_excel_bytes(mapping_df),
                    file_name=f"lineage_mapping_{from_sys}_to_{to_sys}.xlsx",
                )

                n_adj = (mapping_df["Adjustment Type"] != "").sum()
                st.caption(
                    f"{len(mapping_df) - n_adj} matched fields, {n_adj} unmatched target fields "
                    f"flagged as candidate adjustments/manual entries - confirm these on the SME call."
                )

        st.divider()
        st.subheader("5. Lineage diagram")
        st.write(
            "Visual of every confirmed candidate edge: green = high confidence (80%+), "
            "amber = medium (60-79%), red = weak (below 60%, worth double-checking on the SME call). "
            "If a pair is selected above for field-level mapping, its edge is drawn thicker."
        )
        selected_pair_tuple = (
            (from_sys, to_sys) if pair_options and "mapping_pair" in st.session_state else None
        )
        dot_source = build_lineage_diagram(report, confirmed_pair=selected_pair_tuple)
        st.graphviz_chart(dot_source, use_container_width=True)
        st.download_button(
            "Download diagram source (.dot)",
            data=dot_source,
            file_name="lineage_diagram.dot",
        )
else:
    st.info("Upload your workpaper Excel file to get started.")
