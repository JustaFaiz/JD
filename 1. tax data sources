"""
Tax Data Inventory Crawler
---------------------------
Walks a folder of tax workpapers (.xlsx/.xlsm), extracts structural
metadata from each file, and writes it into a multi-tab Excel workbook
that seeds the Tax Data Inventory / Metadata Repository.

It does NOT read or move business data (cell values, dollar amounts,
taxpayer figures) — only structure: sheet names, headers, named ranges,
external links, comments, and formulas that reference other files.

USAGE:
    python tax_metadata_crawler.py <input_folder> <output_file.xlsx>

Example:
    python tax_metadata_crawler.py "C:\\Tax\\Workpapers" "Tax_Data_Inventory_Draft.xlsx"

Requires: openpyxl, pandas  (both already in your environment)
"""

import os
import re
import sys
from datetime import datetime

import pandas as pd
from openpyxl import load_workbook

# Keyword hints used to guess which upstream/downstream system a file
# belongs to, based on filename. Edit this dict to match your naming
# conventions — it's a starting guess, not a source of truth.
SYSTEM_KEYWORDS = {
    "SAP": ["sap", "fico", "trial balance", "tb_"],
    "Longview": ["longview", "lv_"],
    "Corptax": ["corptax", "ctx_"],
    "Excel Workpaper": [],  # fallback bucket, always matches last
}

EXTERNAL_REF_PATTERN = re.compile(r"\[\d+\]")  # e.g. ='[1]Sheet1'!$A$1


def guess_system(filename: str) -> str:
    name_lower = filename.lower()
    for system, keywords in SYSTEM_KEYWORDS.items():
        for kw in keywords:
            if kw in name_lower:
                return system
    return "Unclassified"


def find_header_row(ws, max_scan_rows=10, max_scan_cols=40):
    """
    Heuristic: the header row is the first row within the first
    max_scan_rows that has more than 2 non-empty text cells in a row.
    Returns (row_index, [header_values]) or (None, []) if not found.
    """
    for row_idx in range(1, max_scan_rows + 1):
        row_values = []
        non_empty = 0
        for col_idx in range(1, max_scan_cols + 1):
            cell = ws.cell(row=row_idx, column=col_idx)
            val = cell.value
            row_values.append(val)
            if val not in (None, ""):
                non_empty += 1
        if non_empty > 2:
            return row_idx, row_values
    return None, []


def extract_comments(ws, sheet_name, file_name):
    records = []
    for row in ws.iter_rows():
        for cell in row:
            if cell.comment is not None:
                records.append({
                    "File": file_name,
                    "Sheet": sheet_name,
                    "Cell": cell.coordinate,
                    "Author": cell.comment.author,
                    "Comment": cell.comment.text.strip(),
                })
    return records


def extract_external_links(ws, sheet_name, file_name):
    """Flags formulas that reference another workbook, e.g. ='[1]Sheet1'!$B$2"""
    records = []
    for row in ws.iter_rows():
        for cell in row:
            if isinstance(cell.value, str) and cell.value.startswith("="):
                if EXTERNAL_REF_PATTERN.search(cell.value):
                    records.append({
                        "File": file_name,
                        "Sheet": sheet_name,
                        "Cell": cell.coordinate,
                        "Formula": cell.value,
                    })
    return records


def extract_named_ranges(wb, file_name):
    records = []
    for name, defined_name in wb.defined_names.items():
        records.append({
            "File": file_name,
            "Name": name,
            "RefersTo": defined_name.attr_text,
        })
    return records


def crawl_file(filepath):
    """
    Returns a dict of lists: headers, named_ranges, external_links, comments, errors
    for a single workbook.
    """
    file_name = os.path.basename(filepath)
    result = {
        "headers": [],
        "named_ranges": [],
        "external_links": [],
        "comments": [],
        "errors": [],
    }

    try:
        # keep_links=True preserves external link info; data_only=False
        # so we see formulas (needed to detect cross-file references).
        wb = load_workbook(filepath, data_only=False, keep_links=True)
    except Exception as e:
        result["errors"].append({
            "File": file_name,
            "Issue": f"Could not open file: {e}",
        })
        return result

    system_guess = guess_system(file_name)

    for sheet_name in wb.sheetnames:
        ws = wb[sheet_name]

        try:
            header_row, header_values = find_header_row(ws)
            if header_row:
                for col_idx, val in enumerate(header_values, start=1):
                    if val not in (None, ""):
                        result["headers"].append({
                            "System (guess)": system_guess,
                            "File": file_name,
                            "Sheet": sheet_name,
                            "Header Row": header_row,
                            "Column": ws.cell(row=header_row, column=col_idx).coordinate,
                            "Field Name": str(val).strip(),
                            "Owner": "",       # left blank for manual fill-in
                            "Downstream Use": "",  # left blank for manual fill-in
                        })
            else:
                result["errors"].append({
                    "File": file_name,
                    "Issue": f"No clear header row found on sheet '{sheet_name}'",
                })
        except Exception as e:
            result["errors"].append({
                "File": file_name,
                "Issue": f"Header scan failed on sheet '{sheet_name}': {e}",
            })

        try:
            result["comments"].extend(extract_comments(ws, sheet_name, file_name))
        except Exception as e:
            result["errors"].append({
                "File": file_name,
                "Issue": f"Comment scan failed on sheet '{sheet_name}': {e}",
            })

        try:
            result["external_links"].extend(extract_external_links(ws, sheet_name, file_name))
        except Exception as e:
            result["errors"].append({
                "File": file_name,
                "Issue": f"External link scan failed on sheet '{sheet_name}': {e}",
            })

    try:
        result["named_ranges"].extend(extract_named_ranges(wb, file_name))
    except Exception as e:
        result["errors"].append({
            "File": file_name,
            "Issue": f"Named range scan failed: {e}",
        })

    return result


def crawl_files(filepaths, progress_callback=None):
    """
    Scans a given list of workbook filepaths (as opposed to a whole folder).
    Used directly by the Streamlit dashboard, and by crawl_folder() below.
    progress_callback(filename) is called before each file is scanned, if provided.
    """
    all_headers, all_named_ranges = [], []
    all_external_links, all_comments, all_errors = [], [], []

    for filepath in filepaths:
        fname = os.path.basename(filepath)
        if progress_callback:
            progress_callback(fname)
        else:
            print(f"Scanning: {fname}")
        result = crawl_file(filepath)
        all_headers.extend(result["headers"])
        all_named_ranges.extend(result["named_ranges"])
        all_external_links.extend(result["external_links"])
        all_comments.extend(result["comments"])
        all_errors.extend(result["errors"])

    return {
        "headers": pd.DataFrame(all_headers),
        "named_ranges": pd.DataFrame(all_named_ranges),
        "external_links": pd.DataFrame(all_external_links),
        "comments": pd.DataFrame(all_comments),
        "errors": pd.DataFrame(all_errors),
    }


def crawl_folder(input_folder):
    excel_files = [
        os.path.join(input_folder, f) for f in os.listdir(input_folder)
        if f.lower().endswith((".xlsx", ".xlsm")) and not f.startswith("~$")
    ]

    if not excel_files:
        print(f"No .xlsx/.xlsm files found in {input_folder}")

    return crawl_files(excel_files)


def write_inventory(dataframes, output_path):
    with pd.ExcelWriter(output_path, engine="openpyxl") as writer:
        # Summary tab first
        summary = pd.DataFrame({
            "Metric": [
                "Generated On",
                "Fields Discovered",
                "Named Ranges Discovered",
                "Cross-File Formula References",
                "Comments Captured",
                "Files with Errors",
            ],
            "Value": [
                datetime.now().strftime("%Y-%m-%d %H:%M"),
                len(dataframes["headers"]),
                len(dataframes["named_ranges"]),
                len(dataframes["external_links"]),
                len(dataframes["comments"]),
                dataframes["errors"]["File"].nunique() if not dataframes["errors"].empty else 0,
            ],
        })
        summary.to_excel(writer, sheet_name="Summary", index=False)

        dataframes["headers"].to_excel(writer, sheet_name="Field Inventory", index=False)
        dataframes["named_ranges"].to_excel(writer, sheet_name="Named Ranges", index=False)
        dataframes["external_links"].to_excel(writer, sheet_name="Cross-File Links", index=False)
        dataframes["comments"].to_excel(writer, sheet_name="Cell Comments", index=False)
        dataframes["errors"].to_excel(writer, sheet_name="Scan Errors", index=False)

    print(f"\nInventory written to: {output_path}")


def main():
    if len(sys.argv) != 3:
        print("Usage: python tax_metadata_crawler.py <input_folder> <output_file.xlsx>")
        sys.exit(1)

    input_folder = sys.argv[1]
    output_path = sys.argv[2]

    if not os.path.isdir(input_folder):
        print(f"Input folder not found: {input_folder}")
        sys.exit(1)

    dataframes = crawl_folder(input_folder)
    write_inventory(dataframes, output_path)


if __name__ == "__main__":
    main()
