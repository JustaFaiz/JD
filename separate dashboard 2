# ---------------------------------------------------------------------------
# CONFIDENCE TIERS -- fixed by method, not blended
# ---------------------------------------------------------------------------

TIER_CONFIDENCE = {
    "formula": 100,        # direct cross-sheet cell/range formula reference
    "named_range": 90,     # formula uses a workbook-defined name resolving to another sheet
    "description": 80,     # fuzzy sheet-name / row-label match
    "value": 70,           # value-set overlap
}
CONFIDENCE_THRESHOLD = 70

# Sheets named after a form line item (L10, L26, Line_15, "Line 20", etc.)
# are calculation/support schedules, not raw data sources -- see original
# rationale: often self-contained, which would otherwise wrongly classify
# them as Input source. Adjustable per-workbook via the UI.
LINE_SCHEDULE_PATTERN_DEFAULT = r"^(l|line)[\s_\-]?\d+|^(sch|schedule)\b"

# Bumped whenever the shape of a lineage dict's relationships changes --
# see classify_and_assemble / the schema-mismatch check in run_app.
LINEAGE_SCHEMA_VERSION = 6  # bumped: relationships now also carry value_locations (full shared-value/cell list) for value-tier edges


def matches_line_schedule_pattern(sheet_name, pattern):
    if not pattern:
        return False
    try:
        return bool(re.match(pattern, sheet_name.strip(), re.IGNORECASE))
    except re.error:
        return False


DESCRIPTION_DETECT_THRESHOLD = 55   # rapidfuzz score (0-100) to count as "a description match exists"
VALUE_DETECT_THRESHOLD = 0.25       # Jaccard overlap fraction to count as "a value match exists"

MAX_COLS_FOR_MATCHING = 15
MAX_ROWS_FOR_VALUE_MATCH = 300
MAX_ROWS_FOR_LABEL_SCAN = 500
MAX_POOL_ITEMS_FOR_FUZZ = 60  # cap on how many text items per sheet enter the cdist matrix
MAX_VALUES_FOR_EXPORT_PER_EDGE = 500  # cap on shared values resolved-to-cells per value-tier edge, for the export


# ---------------------------------------------------------------------------
# FORMULA PARSING -- cross-sheet cell/range references
# ---------------------------------------------------------------------------

CELL_REF_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])(\$?[A-Z]{1,3}\$?\d{1,7})(?::(\$?[A-Z]{1,3}\$?\d{1,7}))?(?!\()"
)
COLUMN_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?([A-Z]{1,3})\$?:\$?([A-Z]{1,3})\$?(?![A-Za-z0-9_])"
)
ROW_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?(\d{1,7})\$?:\$?(\d{1,7})\$?(?![A-Za-z0-9_])"
)
NAME_TOKEN_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_.]*)\b(?!\()")

FULL_RANGE_ROW_CAP = 5000
FULL_RANGE_COL_CAP = 200


def extract_cross_sheet_refs(formula, current_sheet):
    refs = set()
    for m in CELL_REF_RE.finditer(formula):
        sheet = m.group(1) or m.group(2)
        if sheet and sheet != current_sheet:
            refs.add(sheet)
    for m in COLUMN_ONLY_RE.finditer(formula):
        sheet = m.group(1) or m.group(2)
        if sheet and sheet != current_sheet:
            refs.add(sheet)
    for m in ROW_ONLY_RE.finditer(formula):
        sheet = m.group(1) or m.group(2)
        if sheet and sheet != current_sheet:
            refs.add(sheet)
    return refs


def extract_named_range_refs(formula, defined_name_map, current_sheet):
    refs = set()
    for m in NAME_TOKEN_RE.finditer(formula):
        token = m.group(1).lower()
        if token in defined_name_map:
            for sheet in defined_name_map[token]:
                if sheet != current_sheet:
                    refs.add(sheet)
    return refs


def load_defined_name_map(wb):
    name_map = {}

    def add_destinations(name_obj, name_key):
        try:
            for sheet_name, _coord in name_obj.destinations:
                name_map.setdefault(name_key, set()).add(sheet_name)
        except Exception:
            pass

    try:
        for name_key, name_obj in wb.defined_names.items():
            add_destinations(name_obj, name_key.lower())
    except AttributeError:
        for name_obj in getattr(wb, "defined_names", []):
            add_destinations(name_obj, getattr(name_obj, "name", "").lower())

    for ws in wb.worksheets:
        local_names = getattr(ws, "defined_names", None)
        if not local_names:
            continue
        try:
            for name_key, name_obj in local_names.items():
                add_destinations(name_obj, name_key.lower())
        except AttributeError:
            pass

    return name_map


def load_workbook_formulas(file_bytes):
    wb = load_workbook(io.BytesIO(file_bytes), data_only=False, read_only=True)
    defined_name_map = load_defined_name_map(wb)

    formulas = {}
    for ws in wb.worksheets:
        for r_idx, row in enumerate(ws.iter_rows(values_only=True), start=1):
            for c_idx, value in enumerate(row, start=1):
                if isinstance(value, str) and value.startswith("="):
                    coord = f"{get_column_letter(c_idx)}{r_idx}"
                    formulas[(ws.title, coord)] = value
    sheetnames = wb.sheetnames
    wb.close()
    return formulas, sheetnames, defined_name_map


def _dedupe_headers(header):
    seen = {}
    deduped = []
    for h in header:
        if h in seen:
            seen[h] += 1
            deduped.append(f"{h}.{seen[h]}")
        else:
            seen[h] = 0
            deduped.append(h)
    return deduped


def load_raw_sheets(file_bytes):
    wb = load_workbook(io.BytesIO(file_bytes), data_only=True, read_only=True)
    raw_sheets = {}
    for ws in wb.worksheets:
        rows = list(ws.iter_rows(values_only=True))
        if not rows:
            raw_sheets[ws.title] = pd.DataFrame()
            continue
        header, *body = rows
        header = [h if h is not None else f"Unnamed: {i}" for i, h in enumerate(header)]
        header = _dedupe_headers(header)
        df = pd.DataFrame(body, columns=header)
        raw_sheets[ws.title] = df
    wb.close()
    return raw_sheets


# ---------------------------------------------------------------------------
# BACKWARD TRAVERSAL FROM THE ROOT
# ---------------------------------------------------------------------------

def trace_lineage_from_root(root_sheet, formulas, defined_name_map):
    edges = {}
    counts = {}
    visited = {root_sheet}
    frontier = [root_sheet]

    formulas_by_sheet = {}
    for (sheet, coord), f in formulas.items():
        formulas_by_sheet.setdefault(sheet, []).append(f)

    while frontier:
        next_frontier = []
        for current in frontier:
            for f in formulas_by_sheet.get(current, []):
                direct_refs = extract_cross_sheet_refs(f, current)
                named_refs = extract_named_range_refs(f, defined_name_map, current) - direct_refs
                all_refs = direct_refs | named_refs

                for src in all_refs:
                    counts[(src, current)] = counts.get((src, current), 0) + 1

                for src in direct_refs:
                    key = (src, current)
                    if key not in edges or edges[key]["tier"] != "formula":
                        edges[key] = {"tier": "formula", "confidence": TIER_CONFIDENCE["formula"]}
                    if src not in visited:
                        visited.add(src)
                        next_frontier.append(src)

                for src in named_refs:
                    key = (src, current)
                    if key not in edges:
                        edges[key] = {"tier": "named_range", "confidence": TIER_CONFIDENCE["named_range"]}
                    if src not in visited:
                        visited.add(src)
                        next_frontier.append(src)
        frontier = next_frontier

    for key, info in edges.items():
        info["count"] = counts.get(key, 0)

    return edges, visited


# ---------------------------------------------------------------------------
# FALLBACK: description similarity + value overlap for unreached sheets
# ---------------------------------------------------------------------------

def build_text_pool(df, sheet_name, max_rows=MAX_ROWS_FOR_LABEL_SCAN):
    texts = [sheet_name]
    cell_refs = [None]
    for col_pos, col in enumerate(df.columns[:MAX_COLS_FOR_MATCHING]):
        col_letter = get_column_letter(col_pos + 1)
        series = df[col].dropna().astype(str).head(max_rows)
        for row_pos, v in series.items():
            if v.replace(".", "", 1).replace("-", "", 1).isdigit():
                continue
            texts.append(v)
            cell_refs.append(f"{col_letter}{row_pos + 2}")
    if len(texts) > MAX_POOL_ITEMS_FOR_FUZZ:
        return texts[:MAX_POOL_ITEMS_FOR_FUZZ], cell_refs[:MAX_POOL_ITEMS_FOR_FUZZ]
    return texts, cell_refs


def description_similarity(pool_a, pool_b, locations_a=None, locations_b=None, top_k=5):
    empty = {"score": 0.0, "text_a": None, "text_b": None, "corroborating_matches": 0, "top_matches": []}
    if not pool_a or not pool_b:
        return empty
    matrix = rf_process.cdist(pool_a, pool_b, scorer=fuzz.token_sort_ratio)
    if matrix.size == 0:
        return empty

    row_best_idx = matrix.argmax(axis=1)
    row_best_score = matrix.max(axis=1)
    order = np.argsort(-row_best_score)

    best_i = int(order[0])
    best_j = int(row_best_idx[best_i])
    best_score = float(row_best_score[best_i])
    corroborating = int((row_best_score >= DESCRIPTION_DETECT_THRESHOLD).sum())

    top_matches = []
    for i in order:
        i = int(i)
        score = float(row_best_score[i])
        if score < DESCRIPTION_DETECT_THRESHOLD:
            break
        j = int(row_best_idx[i])
        entry = {"text_a": pool_a[i], "text_b": pool_b[j], "score": round(score, 1)}
        if locations_a is not None:
            entry["cell_a"] = locations_a[i]
        if locations_b is not None:
            entry["cell_b"] = locations_b[j]
        top_matches.append(entry)
        if len(top_matches) >= top_k:
            break

    return {
        "score": best_score, "text_a": pool_a[best_i], "text_b": pool_b[best_j],
        "corroborating_matches": corroborating, "top_matches": top_matches,
    }


def value_overlap_score(series_a: pd.Series, series_b: pd.Series) -> float:
    set_a = set(series_a.dropna().astype(str).str.strip().str.upper())
    set_b = set(series_b.dropna().astype(str).str.strip().str.upper())
    if not set_a or not set_b:
        return 0.0
    smaller = min(len(set_a), len(set_b))
    return (len(set_a & set_b) / smaller) if smaller else 0.0


def value_similarity(df_a, df_b):
    cols_a = list(df_a.columns)[:MAX_COLS_FOR_MATCHING]
    cols_b = list(df_b.columns)[:MAX_COLS_FOR_MATCHING]
    empty = {
        "score": 0.0, "column_a": None, "column_b": None, "overlap_count": 0,
        "smaller_set_size": 0, "sample_shared_values": [], "corroborating_columns": 0,
    }
    if not cols_a or not cols_b:
        return empty

    sample_a = df_a[cols_a].head(MAX_ROWS_FOR_VALUE_MATCH)
    sample_b = df_b[cols_b].head(MAX_ROWS_FOR_VALUE_MATCH)
    sets_b = {}
    for cb in cols_b:
        try:
            sets_b[cb] = set(sample_b[cb].dropna().astype(str).str.strip().str.upper())
        except Exception:
            sets_b[cb] = set()

    per_col_best = []
    for ca in cols_a:
        try:
            set_a = set(sample_a[ca].dropna().astype(str).str.strip().str.upper())
        except Exception:
            set_a = set()
        best_score, best_cb, best_overlap, best_smaller, best_shared = 0.0, None, 0, 0, set()
        if set_a:
            for cb in cols_b:
                set_b = sets_b[cb]
                if not set_b:
                    continue
                smaller = min(len(set_a), len(set_b))
                shared = set_a & set_b
                score = (len(shared) / smaller) if smaller else 0.0
                if score > best_score:
                    best_score, best_cb, best_overlap, best_smaller, best_shared = score, cb, len(shared), smaller, shared
        per_col_best.append((ca, best_score, best_cb, best_overlap, best_smaller, best_shared))

    avg_score = sum(e[1] for e in per_col_best) / len(per_col_best) if per_col_best else 0.0
    corroborating_columns = sum(1 for e in per_col_best if e[1] >= VALUE_DETECT_THRESHOLD)
    top = max(per_col_best, key=lambda e: e[1]) if per_col_best else None

    if top and top[1] > 0:
        column_a, _, column_b, overlap_count, smaller_set_size, shared_values = top
        sample_shared_values = sorted(shared_values)[:5]
        # Full overlap set (not the 5-item UI sample) -- this is what the
        # value-overlap lineage export resolves cell locations for, since
        # "give me every copy-pasted value" needs more than 5 examples.
        # Capped so one enormous matching column pair can't blow up the
        # export; MAX_VALUES_FOR_EXPORT_PER_EDGE below controls this.
        full_shared_values = sorted(shared_values)[:MAX_VALUES_FOR_EXPORT_PER_EDGE]
    else:
        column_a = column_b = None
        overlap_count = smaller_set_size = 0
        sample_shared_values = []
        full_shared_values = []

    # Resolve a concrete cell for EVERY sample shared value (not just the
    # first one) -- this is what powers both the single "jump to this cell"
    # anchor button (cell_a/cell_b, kept for backward compat) AND the full
    # value-overlap lineage export, where each individual copy-pasted
    # number needs its own source/target cell pair, not just one example.
    cell_a = cell_b = None
    value_locations = []
    if full_shared_values:
        try:
            col_pos_a = cols_a.index(column_a)
            match_a = sample_a[column_a].dropna().astype(str).str.strip().str.upper()
        except Exception:
            col_pos_a, match_a = None, None
        try:
            col_pos_b = cols_b.index(column_b)
            match_b = sample_b[column_b].dropna().astype(str).str.strip().str.upper()
        except Exception:
            col_pos_b, match_b = None, None

        for v in full_shared_values:
            va = vb = None
            if match_a is not None:
                row_idx_a = match_a[match_a == v].index
                if len(row_idx_a) > 0:
                    va = f"{get_column_letter(col_pos_a + 1)}{row_idx_a[0] + 2}"
            if match_b is not None:
                row_idx_b = match_b[match_b == v].index
                if len(row_idx_b) > 0:
                    vb = f"{get_column_letter(col_pos_b + 1)}{row_idx_b[0] + 2}"
            value_locations.append({"value": v, "cell_a": va, "cell_b": vb})

        if value_locations:
            cell_a, cell_b = value_locations[0]["cell_a"], value_locations[0]["cell_b"]

    return {
        "score": avg_score, "column_a": column_a, "column_b": column_b,
        "overlap_count": overlap_count, "smaller_set_size": smaller_set_size,
        "sample_shared_values": sample_shared_values, "corroborating_columns": corroborating_columns,
        "cell_a": cell_a, "cell_b": cell_b, "value_locations": value_locations,
    }


def fallback_match_unreached_sheets(unmapped_sheets, lineage_sheets, raw_sheets):
    results = {}
    text_pools = {}
    text_pool_cells = {}
    for s in lineage_sheets:
        if s in raw_sheets:
            texts, cells = build_text_pool(raw_sheets[s], s)
            text_pools[s] = texts
            text_pool_cells[s] = cells

    for sheet in unmapped_sheets:
        if sheet not in raw_sheets:
            continue
        df = raw_sheets[sheet]
        pool, pool_cells = build_text_pool(df, sheet)

        best_desc, best_desc_parent = None, None
        for parent in lineage_sheets:
            if parent not in text_pools:
                continue
            detail = description_similarity(pool, text_pools[parent], pool_cells, text_pool_cells[parent])
            if best_desc is None or detail["score"] > best_desc["score"]:
                best_desc, best_desc_parent = detail, parent

        if best_desc and best_desc["score"] >= DESCRIPTION_DETECT_THRESHOLD:
            corroborating = best_desc["corroborating_matches"]
            top_matches = best_desc["top_matches"]
            corroboration_note = (
                f"; {corroborating} other label(s) also matched" if corroborating > 1
                else "; only this one label matched -- treat with caution"
            )
            pairs_text = "; ".join(
                f"'{m['text_a']}' (cell {m.get('cell_a') or '?'} on {sheet}) ~ "
                f"'{m['text_b']}' (cell {m.get('cell_b') or '?'} on {best_desc_parent})"
                for m in top_matches[:3]
            )
            results[sheet] = {
                "parent": best_desc_parent, "tier": "description",
                "confidence": TIER_CONFIDENCE["description"],
                "match_score": round(best_desc["score"], 1),
                "corroborating_matches": corroborating,
                "top_matches": top_matches,
                "evidence_detail": f"{pairs_text}{corroboration_note}",
            }
            continue

        best_val, best_val_parent = None, None
        for parent in lineage_sheets:
            if parent not in raw_sheets:
                continue
            detail = value_similarity(df, raw_sheets[parent])
            if best_val is None or detail["score"] > best_val["score"]:
                best_val, best_val_parent = detail, parent

        if best_val and best_val["score"] >= VALUE_DETECT_THRESHOLD:
            sample_str = ", ".join(best_val["sample_shared_values"][:3]) if best_val["sample_shared_values"] else "n/a"
            corroborating_cols = best_val["corroborating_columns"]
            corroboration_note = (
                f"; {corroborating_cols} column pair(s) corroborate" if corroborating_cols > 1
                else "; only one column pair matched -- treat with caution"
            )
            cell_a, cell_b = best_val.get("cell_a"), best_val.get("cell_b")
            cell_text = f" -- e.g. {sheet}!{cell_a} = {best_val_parent}!{cell_b}" if cell_a and cell_b else ""
            results[sheet] = {
                "parent": best_val_parent, "tier": "value",
                "confidence": TIER_CONFIDENCE["value"],
                "match_score": round(best_val["score"] * 100, 1),
                "overlap_count": best_val["overlap_count"],
                "overlap_total": best_val["smaller_set_size"],
                "corroborating_columns": corroborating_cols,
                "cell_a": cell_a, "cell_b": cell_b,
                "value_locations": best_val.get("value_locations", []),
                "evidence_detail": (
                    f"{best_val['overlap_count']} of {best_val['smaller_set_size']} shared values in "
                    f"{best_val['column_a']} vs {best_val['column_b']} (e.g. {sample_str}){cell_text}{corroboration_note}"
                ),
            }

    return {k: v for k, v in results.items() if v["confidence"] >= CONFIDENCE_THRESHOLD}


# ---------------------------------------------------------------------------
# LINE 30 / TAXABLE INCOME AUTO-DETECTION
# ---------------------------------------------------------------------------

LINE30_LABEL_HINTS = ["taxable income", "line 30", "net taxable income"]
CELL_ADDR_RE = re.compile(r"^\$?([A-Za-z]{1,3})\$?(\d{1,7})$")


def lookup_cell_direct(values_ws, formulas_ws, cell_ref):
    m = CELL_ADDR_RE.match(cell_ref.strip())
    if not m:
        return None
    col_letters, row_str = m.group(1).upper(), m.group(2)
    row_idx = int(row_str)
    try:
        col_idx = column_index_from_string(col_letters)
    except ValueError:
        return None

    value = values_ws.cell(row=row_idx, column=col_idx).value
    label = values_ws.cell(row=row_idx, column=1).value

    raw = formulas_ws.cell(row=row_idx, column=col_idx).value
    formula = raw if isinstance(raw, str) and raw.startswith("=") else None

    return {"row": row_idx, "col": col_letters, "label": label, "value": value, "formula": formula}


def detect_final_output_cell(df, target_row_hint=30):
    candidates = []
    for col in df.columns[:5]:
        series = df[col].dropna().astype(str)
        for row_idx, text in series.items():
            best_hint_score = max(fuzz.partial_ratio(text.lower(), hint) for hint in LINE30_LABEL_HINTS)
            if best_hint_score < 60:
                continue
            row_distance_penalty = min(abs((row_idx + 2) - target_row_hint), 20)
            adjusted_score = best_hint_score - row_distance_penalty
            candidates.append((row_idx, col, text, round(adjusted_score, 1)))
    candidates.sort(key=lambda c: c[3], reverse=True)
    return candidates[:10]


# ---------------------------------------------------------------------------
# CLASSIFICATION + ASSEMBLY
# ---------------------------------------------------------------------------

def classify_and_assemble(root_sheet, traced_edges, fallback_edges, final_output_desc,
                           line_schedule_pattern=LINE_SCHEDULE_PATTERN_DEFAULT):
    fed_by_traced = {}
    best_parent_traced = {}

    for (src, dst), info in traced_edges.items():
        fed_by_traced.setdefault(dst, set()).add(src)
        if src not in best_parent_traced or info["confidence"] > best_parent_traced[src][2]:
            best_parent_traced[src] = (dst, info["tier"], info["confidence"])

    traced_sheets = {root_sheet} | {s for pair in traced_edges for s in pair}

    nodes = []
    for sheet in sorted(traced_sheets):
        if sheet == root_sheet:
            nodes.append({
                "sheet_name": sheet, "classification": "Output node",
                "parent_sheet": None, "filing_reference": root_sheet,
                "confidence_score": 100, "match_method": None,
            })
            continue
        is_line_schedule = matches_line_schedule_pattern(sheet, line_schedule_pattern)
        classification = "Process node" if (sheet in fed_by_traced or is_line_schedule) else "Input source"
        parent_sheet, tier, confidence = best_parent_traced.get(sheet, (None, None, 0))
        nodes.append({
            "sheet_name": sheet, "classification": classification,
            "parent_sheet": parent_sheet, "filing_reference": root_sheet,
            "confidence_score": confidence, "match_method": tier,
        })

    for sheet, info in fallback_edges.items():
        is_line_schedule = matches_line_schedule_pattern(sheet, line_schedule_pattern)
        nodes.append({
            "sheet_name": sheet, "classification": "Process node" if is_line_schedule else "Input source",
            "parent_sheet": info["parent"], "filing_reference": root_sheet,
            "confidence_score": info["confidence"], "match_method": info["tier"],
        })

    relationships = [
        {
            "source": src, "target": dst, "relationship": "feeds",
            "formula_count": info.get("count", 0), "method": info["tier"],
        }
        for (src, dst), info in traced_edges.items()
    ] + [
        {
            "source": sheet, "target": info["parent"], "relationship": "feeds",
            "formula_count": None, "method": info["tier"],
            "match_score": info.get("match_score"),
            "corroborating_matches": info.get("corroborating_matches"),
            "corroborating_columns": info.get("corroborating_columns"),
            "overlap_count": info.get("overlap_count"),
            "overlap_total": info.get("overlap_total"),
            "evidence_detail": info.get("evidence_detail"),
            # NEW (schema v5): carried through so the exported diagram's
            # side panel can render per-match "open in Excel" buttons
            # without needing separate access to lineage["fallback_evidence"].
            # cell_a/cell_b: the single resolved shared-value cell pair for
            #   a "value" tier match. top_matches: the full ranked list of
            #   text-pair matches (each with its own cell_a/cell_b) for a
            #   "description" tier match -- absent/None for formula/named_range.
            "cell_a": info.get("cell_a"),
            "cell_b": info.get("cell_b"),
            "top_matches": info.get("top_matches"),
            # NEW (schema v6): full resolved shared-value/cell list for a
            # "value" tier match -- powers the value-overlap lineage
            # export (every copy-pasted number, not just one example).
            "value_locations": info.get("value_locations"),
        }
        for sheet, info in fallback_edges.items()
    ]

    return {
        "filing_reference": root_sheet,
        "final_output": final_output_desc,
        "nodes": nodes,
        "relationships": relationships,
        "fallback_evidence": fallback_edges,
        "schema_version": LINEAGE_SCHEMA_VERSION,
    }


def get_downstream_lineage(lineage: dict, start_sheet: str):
    return get_downstream_lineage_multi(lineage, [start_sheet])


def get_downstream_lineage_multi(lineage: dict, start_sheets: list):
    node_map = {n["sheet_name"]: n for n in lineage["nodes"]}
    valid_starts = [s for s in start_sheets if s in node_map]
    if not valid_starts:
        return None

    forward = {}
    rel_lookup = {}
    for r in lineage["relationships"]:
        forward.setdefault(r["source"], []).append(r["target"])
        rel_lookup[(r["source"], r["target"])] = r

    visited_nodes = set(valid_starts)
    visited_edges = set()
    frontier = list(valid_starts)
    while frontier:
        next_frontier = []
        for current in frontier:
            for dst in forward.get(current, []):
                edge = (current, dst)
                if edge not in visited_edges:
                    visited_edges.add(edge)
                if dst not in visited_nodes:
                    visited_nodes.add(dst)
                    next_frontier.append(dst)
        frontier = next_frontier

    return {
        "filing_reference": lineage["filing_reference"],
        "final_output": lineage["final_output"],
        "nodes": [node_map[s] for s in visited_nodes if s in node_map],
        "relationships": [rel_lookup[e] for e in sorted(visited_edges) if e in rel_lookup],
        "combined_from": valid_starts,
        "schema_version": LINEAGE_SCHEMA_VERSION,
    }


EDGE_FILTER_OPTIONS = {
    "All connections (formula + named range + fuzzy matches)": {"formula", "named_range", "description", "value"},
    "Formula + named range only (exclude fuzzy matches)": {"formula", "named_range"},
    "Direct cell formulas only (exclude named ranges & fuzzy matches)": {"formula"},
}


def filter_lineage_by_methods(lineage: dict, allowed_methods: set) -> dict:
    root = lineage["filing_reference"]
    filtered_rels = [r for r in lineage["relationships"] if r.get("method") in allowed_methods]
    node_map = {n["sheet_name"]: n for n in lineage["nodes"]}
    combined_from = lineage.get("combined_from")

    if combined_from:
        forward = {}
        for r in filtered_rels:
            forward.setdefault(r["source"], []).append(r["target"])
        visited = {s for s in combined_from if s in node_map}
        frontier = list(visited)
        while frontier:
            next_frontier = []
            for current in frontier:
                for dst in forward.get(current, []):
                    if dst not in visited:
                        visited.add(dst)
                        next_frontier.append(dst)
            frontier = next_frontier
    else:
        backward = {}
        for r in filtered_rels:
            backward.setdefault(r["target"], []).append(r["source"])
        visited = {root}
        frontier = [root]
        while frontier:
            next_frontier = []
            for current in frontier:
                for src in backward.get(current, []):
                    if src not in visited:
                        visited.add(src)
                        next_frontier.append(src)
            frontier = next_frontier

    kept_rels = [r for r in filtered_rels if r["source"] in visited and r["target"] in visited]

    return {
        "filing_reference": lineage["filing_reference"],
        "final_output": lineage["final_output"],
        "nodes": [node_map[s] for s in visited if s in node_map],
        "relationships": kept_rels,
        "combined_from": lineage.get("combined_from"),
        "schema_version": lineage.get("schema_version", LINEAGE_SCHEMA_VERSION),
    }


