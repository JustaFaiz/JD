  //     corroborating text-pairs, each independently clickable)
  //   value edge        -> one row for the resolved cellA/cellB pair
  //   formula/named_range -> unchanged, just the count tag
  function buildEdgeListItem(sheetName, edge, isUpstream) {{
    var li = document.createElement('li');
    var mainLine = document.createElement('div');
    mainLine.textContent = sheetName;
    if (edge.label) {{
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = edge.label;
      mainLine.appendChild(tag);
    }}
    li.appendChild(mainLine);

    if (edge.method === 'description' && edge.topMatches && edge.topMatches.length) {{
      // Fed-by list: this sheet's cell is cell_a, the other side is cell_b.
      // Fed-to list: reverse -- this row's "other side" is source's cell_a.
      edge.topMatches.forEach(function (m) {{
        var row = document.createElement('div');
        row.className = 'match-row';
        var text = document.createElement('div');
        text.className = 'match-text';
        text.textContent = '"' + m.text_a + '" ~ "' + m.text_b + '"';
        var score = document.createElement('span');
        score.className = 'match-score';
        score.textContent = m.score + '%';
        text.appendChild(score);
        row.appendChild(text);

        var btnRow = document.createElement('div');
        btnRow.className = 'locate-buttons';
        if (m.cell_a) btnRow.appendChild(makeLocateButton(edge.from, m.cell_a));
        if (m.cell_b) btnRow.appendChild(makeLocateButton(edge.to, m.cell_b));
        row.appendChild(btnRow);
        li.appendChild(row);
      }});
    }} else if (edge.method === 'value' && (edge.cellA || edge.cellB)) {{
      var row = document.createElement('div');
      row.className = 'match-row';
      if (edge.evidenceDetail) {{
        var text = document.createElement('div');
        text.className = 'match-text';
        text.textContent = edge.evidenceDetail;
        row.appendChild(text);
      }}
      var btnRow = document.createElement('div');
      btnRow.className = 'locate-buttons';
      if (edge.cellA) btnRow.appendChild(makeLocateButton(edge.from, edge.cellA));
      if (edge.cellB) btnRow.appendChild(makeLocateButton(edge.to, edge.cellB));
      row.appendChild(btnRow);
      li.appendChild(row);
    }} else if (edge.evidenceDetail) {{
      var evidence = document.createElement('span');
      evidence.className = 'evidence-detail';
      evidence.textContent = edge.evidenceDetail;
      li.appendChild(evidence);
    }}

    return li;
  }}

  function showPanel(nodeId) {{
