def lineage_to_excel_bytes(lineage: dict) -> bytes:
    nodes_df = pd.DataFrame(lineage["nodes"])
    rel_df = pd.DataFrame(lineage["relationships"])
    summary_df = pd.DataFrame([{
        "Filing Reference": lineage["filing_reference"],
        "Final Output": lineage["final_output"],
        "Combined From": ", ".join(lineage["combined_from"]) if lineage.get("combined_from") else "",
        "Node Count": len(lineage["nodes"]),
        "Relationship Count": len(lineage["relationships"]),
    }])

    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        summary_df.to_excel(writer, index=False, sheet_name="Summary")
        nodes_df.to_excel(writer, index=False, sheet_name="Nodes")
        rel_df.to_excel(writer, index=False, sheet_name="Relationships")
    return buf.getvalue()


def fuzzy_match_lineage_to_excel_bytes(lineage: dict) -> bytes:
    """
    Downloadable Excel of every fuzzy-matched (non-formula) connection in
    this lineage -- both "value" tier (shared data values) and
    "description" tier (matched sheet/row labels) -- one row per matched
    item, with both sides' sheet name, cell reference, and what actually
    matched. In a tax workpaper this is typically the "no formula link"
    lineage: numbers or labels that line up between two sheets without any
    formula tying them together, usually because a value was copy-pasted
    or manually re-typed rather than formula-fed.

    Two sheets in the output workbook, since the two tiers carry
    genuinely different evidence shapes:
      "Value Overlap"     -- one row per shared value; Source Value and
                              Target Value are the SAME number (that's
                              what makes it a value-overlap match), each
                              with its own cell reference on its own sheet.
      "Description Match" -- one row per matched label pair; Source Text
                              and Target Text are typically DIFFERENT
                              wording that fuzzy-matched (e.g. "Total
                              Revenue" ~ "Revenue Total"), each with its
                              own cell reference.

    One row per (relationship, matched item) pair -- NOT one row per
    relationship -- since a single sheet-to-sheet connection can rest on
    several independently-matched values or labels, each with its own
    source/target cell. A connection with no resolved cell-level detail
    still gets one row so it isn't silently dropped, with blank cell/text
    columns.
    """
    value_rows = []
    desc_rows = []

    for r in lineage["relationships"]:
        method = r.get("method")
        source, target = r["source"], r["target"]

        if method == "value":
            locations = r.get("value_locations") or []
            if not locations:
                value_rows.append({
                    "Source Sheet": source, "Source Cell": None, "Source Value": None,
                    "Target Sheet": target, "Target Cell": None, "Target Value": None,
                    "Match Score (%)": r.get("match_score"),
                    "Overlap Count": r.get("overlap_count"),
                    "Overlap Total": r.get("overlap_total"),
                })
                continue
            for loc in locations:
                value_rows.append({
                    "Source Sheet": source, "Source Cell": loc.get("cell_a"), "Source Value": loc.get("value"),
                    "Target Sheet": target, "Target Cell": loc.get("cell_b"), "Target Value": loc.get("value"),
                    "Match Score (%)": r.get("match_score"),
                    "Overlap Count": r.get("overlap_count"),
                    "Overlap Total": r.get("overlap_total"),
                })

        elif method == "description":
            matches = r.get("top_matches") or []
            if not matches:
                desc_rows.append({
                    "Source Sheet": source, "Source Cell": None, "Source Text": None,
                    "Target Sheet": target, "Target Cell": None, "Target Text": None,
                    "Match Score (%)": r.get("match_score"),
                    "Corroborating Matches": r.get("corroborating_matches"),
                })
                continue
            for m in matches:
                desc_rows.append({
                    "Source Sheet": source, "Source Cell": m.get("cell_a"), "Source Text": m.get("text_a"),
                    "Target Sheet": target, "Target Cell": m.get("cell_b"), "Target Text": m.get("text_b"),
                    "Match Score (%)": m.get("score"),
                    "Corroborating Matches": r.get("corroborating_matches"),
                })

    value_df = pd.DataFrame(value_rows, columns=[
        "Source Sheet", "Source Cell", "Source Value",
        "Target Sheet", "Target Cell", "Target Value",
        "Match Score (%)", "Overlap Count", "Overlap Total",
    ])
    desc_df = pd.DataFrame(desc_rows, columns=[
        "Source Sheet", "Source Cell", "Source Text",
        "Target Sheet", "Target Cell", "Target Text",
        "Match Score (%)", "Corroborating Matches",
    ])

    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        value_df.to_excel(writer, index=False, sheet_name="Value Overlap")
        desc_df.to_excel(writer, index=False, sheet_name="Description Match")
    return buf.getvalue()


NODE_COLOR = {"Input source": "#2ecc71", "Process node": "#2a9d8f", "Output node": "#f1c40f"}
COMBINED_START_COLOR = "#e76f51"


def compute_lineage_depths(lineage: dict) -> dict:
    root = lineage["filing_reference"]
    feeds_into = {}
    for n in lineage["nodes"]:
        if n["parent_sheet"]:
            feeds_into[n["sheet_name"]] = n["parent_sheet"]

    depths = {root: 0}
    for n in lineage["nodes"]:
        sheet = n["sheet_name"]
        if sheet in depths:
            continue
        chain = []
        cursor = sheet
        seen = set()
        while cursor not in depths and cursor in feeds_into and cursor not in seen:
            seen.add(cursor)
            chain.append(cursor)
            cursor = feeds_into[cursor]
        base_depth = depths.get(cursor, 0)
        for j, s in enumerate(chain):
            depths[s] = base_depth + (len(chain) - j)
    return depths


def _edge_label_and_title(r: dict) -> tuple:
    method = r.get("method")
    count = r.get("formula_count")
    src, dst = r["source"], r["target"]

    if method in ("formula", "named_range") and count:
        label = str(count)
        noun = "formula" if count == 1 else "formulas"
        via = " (via a named range)" if method == "named_range" else ""
        title = f"{count} {noun} on {dst} reference {src}{via}"
    elif method == "description":
        score = r.get("match_score")
        label = f"~desc {score:.0f}%" if score is not None else "~desc"
        detail = r.get("evidence_detail") or ""
        title = f"{src} matched to {dst} by description similarity -- no direct formula link found. {detail}"
    elif method == "value":
        score = r.get("match_score")
        label = f"~val {score:.0f}%" if score is not None else "~val"
        detail = r.get("evidence_detail") or ""
        title = f"{src} matched to {dst} by shared data values -- no direct formula link found. {detail}"
    else:
        label = ""
        title = f"{src} feeds {dst}"
    return label, title


def build_lineage_visual_html(lineage: dict, filter_label: str = None,
                               bridge_port: int = None, file_path: str = None,
                               workbook_name_hint: str = None) -> str:
    """
    Same as before, PLUS: if bridge_port and file_path are supplied, every
    fuzzy-matched (description/value) edge in the side panel gets real
    "Open in Excel" buttons that fetch() the locate bridge -- one button
    per matched cell pair. Both description-tier edges (which can carry
    several corroborating text-pair matches) and value-tier edges (which
    carry one resolved shared-value cell pair) are covered; description
    edges get a button per top_matches entry instead of only the merged
    evidence sentence, so each individual corroborating match is
    independently inspectable and clickable, not just described in prose.

    If bridge_port/file_path are omitted, the panel still shows the
    evidence text as before -- it just renders without buttons (e.g. for
    a plain "download the HTML and look at it later, no bridge running"
    use case).
    """
    depths = compute_lineage_depths(lineage)
    max_depth = max(depths.values()) if depths else 0
    combined_from = set(lineage.get("combined_from") or [])

    nodes_json = json.dumps([
        {
            "id": n["sheet_name"], "label": n["sheet_name"],
            "color": COMBINED_START_COLOR if n["sheet_name"] in combined_from else NODE_COLOR.get(n["classification"], "#888888"),
            "shape": "box", "size": 30 if n["classification"] == "Output node" else 24,
            "level": depths.get(n["sheet_name"], max_depth),
            "title": (
                f"{n['sheet_name']}\\nClassification: {n['classification']}"
                f"\\nConfidence: {n['confidence_score']}%"
                f"\\nMethod: {n['match_method'] or '(root)'}"
            ),
            "font": {"color": "#ffffff", "size": 16},
        }
        for n in lineage["nodes"]
    ])

    edge_dicts = []
    for r in lineage["relationships"]:
        label, title = _edge_label_and_title(r)
        method = r.get("method")
        entry = {
            "from": r["source"], "to": r["target"], "arrows": "to",
            "label": label, "title": title,
            "method": method,
            "evidenceDetail": r.get("evidence_detail"),
        }
        if method == "value":
            entry["cellA"] = r.get("cell_a")
            entry["cellB"] = r.get("cell_b")
        elif method == "description":
            # top_matches entries already carry text_a/text_b/score/cell_a/cell_b
            entry["topMatches"] = r.get("top_matches") or []
        edge_dicts.append(entry)
    edges_json = json.dumps(edge_dicts)

    bridge_config_json = json.dumps({
        "enabled": bool(bridge_port and file_path),
        "url": f"http://127.0.0.1:{bridge_port}/locate" if bridge_port else None,
        "filePath": file_path,
        "workbookNameHint": workbook_name_hint or "",
    })

    legend_extra = (
        "Orange = sheet(s) you selected for this combined view.<br>"
        if combined_from else ""
    )
    if filter_label:
        legend_extra += f"<b>Filter:</b> {filter_label} -- sheets/edges outside this filter are hidden here (still present in the tables/exports).<br>"
    if bridge_port and file_path:
        legend_extra += (
            "Click a fuzzy-matched edge's \"Open in Excel\" buttons in the side panel to jump straight "
            "to the matched cell -- requires the locate-bridge (bridge.py) to still be running.<br>"
        )

    return f"""<!doctype html>
