    position:fixed; top:0; right:0; width:340px; height:100vh; box-sizing:border-box;
    background:#1b1b1b; color:#eee; font-family:sans-serif;
    transform:translateX(100%); transition:transform 0.18s ease;
    padding:20px; overflow-y:auto; box-shadow:-4px 0 14px rgba(0,0,0,0.6); z-index:20;
  }}
  #side-panel.open {{ transform:translateX(0); }}
  #side-panel .close-btn {{ position:absolute; top:10px; right:14px; cursor:pointer; font-size:20px; color:#aaa; }}
  #side-panel .close-btn:hover {{ color:#fff; }}
