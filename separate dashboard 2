BRIDGE_PORT = 8765
_BRIDGE_SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "bridge.py")


def ensure_bridge_running(port: int = BRIDGE_PORT):
    """
    Starts bridge.py as a background subprocess if it isn't already
    running/reachable, and returns the (possibly newly created) Popen
    handle via session_state -- so repeat clicks in the same Streamlit
    session reuse the same bridge process instead of spawning a new one
    (and failing to bind the port) every time.

    Reachability is checked with a quick GET /ping rather than just
    trusting a stored Popen handle, since the person may have killed the
    bridge window manually without dashboard.py's process object knowing.
    """
    import urllib.request

    def _is_reachable():
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/ping", timeout=0.5) as resp:
                return resp.status == 200
        except Exception:
            return False

    if _is_reachable():
        return True, None

    existing = st.session_state.get("_fld_bridge_proc") if st is not None else None
    if existing is not None and existing.poll() is None:
        # process object thinks it's alive but /ping failed -- give it a
        # moment to finish starting up before giving up on it
        import time
        time.sleep(1.0)
        if _is_reachable():
            return True, None

    try:
        proc = subprocess.Popen(
            [sys.executable, _BRIDGE_SCRIPT, "--port", str(port)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        return False, f"Couldn't start bridge.py: {e}"

    if st is not None:
        st.session_state["_fld_bridge_proc"] = proc

    import time
    for _ in range(20):  # up to ~2s
        if _is_reachable():
            return True, None
        time.sleep(0.1)

    return False, "Started bridge.py but it isn't responding on /ping yet -- try again in a moment."


def ensure_workbook_on_disk(file_bytes: bytes, file_name: str) -> str:
    """
    Writes the uploaded workbook to a stable temp path ONCE per uploaded
    file (cached in session_state), so the bridge always has a real path
    to open/find instead of re-writing a fresh temp copy on every locate
    click. Streamlit only ever gives this app the uploaded bytes, never
    the file's real path on the person's machine -- so, same as the
    original locate_cell_in_excel, this is necessarily a working COPY,
    not their original file.
    """
    cache_key = "_fld_workbook_path"
    name_key = "_fld_workbook_path_name"
    if st is not None and st.session_state.get(name_key) == file_name:
        cached_path = st.session_state.get(cache_key)
        if cached_path and os.path.exists(cached_path):
            return cached_path

    tmpdir = tempfile.mkdtemp(prefix="filing_lineage_bridge_")
    safe_name = file_name or "workbook.xlsx"
    path = os.path.join(tmpdir, safe_name)
    with open(path, "wb") as fh:
        fh.write(file_bytes)

    if st is not None:
        st.session_state[cache_key] = path
        st.session_state[name_key] = file_name

    return path


