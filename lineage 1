"""
Streamlit dashboard for end-to-end lineage discovery
(ERP sources -> DTTU / Longview / ERS -> Corptax -> filing schedule)

Run with:
    streamlit run lineage_dashboard.py

Upload each system's extract file, run discovery to see which systems
are actually connected (and how strongly), then drill into any confirmed
pair to get the field-level Source/Target mapping log.
"""

import itertools
import io

import pandas as pd
import streamlit as st
from rapidfuzz import fuzz


# ---------------------------------------------------------------------------
# CORE MATCHING LOGIC (same as lineage_discovery.py)
# ---------------------------------------------------------------------------

def read_any(uploaded_file) -> pd.DataFrame:
    name = uploaded_file.name.lower()
    if name.endswith((".xlsx", ".xls")):
        return pd.read_excel(uploaded_file)
    return pd.read_csv(uploaded_file)


def match_headers(df_a: pd.DataFrame, df_b: pd.DataFrame, threshold: int):
    matches = []
    used_targets = set()
    for col_a in df_a.columns:
        best_score, best_col_b, best_method = 0, None, None
        for col_b in df_b.columns:
            if col_b in used_targets:
                continue
            sort_score = fuzz.token_sort_ratio(str(col_a), str(col_b))
            partial_score = fuzz.partial_ratio(str(col_a), str(col_b))
            score, method = max((sort_score, "token_sort"), (partial_score, "partial"))
            if score > best_score:
                best_score, best_col_b, best_method = score, col_b, method
        if best_score >= threshold:
            matches.append({
                "source_field": col_a, "target_field": best_col_b,
                "score": best_score, "method": f"name:{best_method}",
            })
            used_targets.add(best_col_b)
    return matches


def value_overlap_score(series_a: pd.Series, series_b: pd.Series) -> float:
    set_a = set(series_a.dropna().astype(str).str.strip().str.upper())
    set_b = set(series_b.dropna().astype(str).str.strip().str.upper())
    if not set_a or not set_b:
        return 0.0
    smaller = min(len(set_a), len(set_b))
    return (len(set_a & set_b) / smaller) if smaller else 0.0


def match_by_values(df_a: pd.DataFrame, df_b: pd.DataFrame,
                     already_matched_targets: set, threshold: float):
    matches = []
    used_targets = set(already_matched_targets)
    for col_a in df_a.columns:
        best_score, best_col_b = 0.0, None
        for col_b in df_b.columns:
            if col_b in used_targets:
                continue
            if df_a[col_a].dtype.kind not in "OUS" and df_b[col_b].dtype.kind in "OUS":
                continue
            score = value_overlap_score(df_a[col_a], df_b[col_b])
            if score > best_score:
                best_score, best_col_b = score, col_b
        if best_score >= threshold:
            matches.append({
                "source_field": col_a, "target_field": best_col_b,
                "score": round(best_score * 100, 1), "method": "value_overlap",
            })
            used_targets.add(best_col_b)
    return matches


def field_level_mapping(df_a, df_b, source_system, target_system,
                         header_threshold, value_threshold):
    header_matches = match_headers(df_a, df_b, header_threshold)
    matched_targets = {m["target_field"] for m in header_matches}
    value_matches = match_by_values(df_a, df_b, matched_targets, value_threshold)
    all_matches = header_matches + value_matches
    matched_targets |= {m["target_field"] for m in value_matches}

    rows = []
    for m in all_matches:
        rows.append({
            "Source System": source_system, "Source Field": m["source_field"],
            "Transformation": "direct" if m["score"] >= 95 else "mapped/renamed",
            "Target System": target_system, "Target Field": m["target_field"],
            "Adjustment Type": "", "Match Confidence": m["score"],
            "Match Method": m["method"], "SME Confirmed": "Pending",
        })
    for col_b in df_b.columns:
        if col_b not in matched_targets:
            rows.append({
                "Source System": "(none found)", "Source Field": "",
                "Transformation": "manual/adjustment - unverified",
                "Target System": target_system, "Target Field": col_b,
                "Adjustment Type": "Candidate M-1/M-3 or manual entry - CONFIRM WITH SME",
                "Match Confidence": 0, "Match Method": "no_match", "SME Confirmed": "Pending",
            })
    return pd.DataFrame(rows)


def pairwise_overlap_report(dfs: dict, header_threshold: int, value_threshold: float,
                             min_matched_fields: int) -> pd.DataFrame:
    results = []
    for sys_a, sys_b in itertools.permutations(dfs.keys(), 2):
        df_a, df_b = dfs[sys_a], dfs[sys_b]
        header_matches = match_headers(df_a, df_b, header_threshold)
        matched_targets = {m["target_field"] for m in header_matches}
        value_matches = match_by_values(df_a, df_b, matched_targets, value_threshold)
        total = len(header_matches) + len(value_matches)
        avg_conf = (sum(m["score"] for m in header_matches + value_matches) / total) if total else 0
        results.append({
            "From": sys_a, "To": sys_b, "Matched Fields": total,
            "Avg Confidence": round(avg_conf, 1),
            "Candidate Edge": total >= min_matched_fields,
        })

    columns = ["From", "To", "Matched Fields", "Avg Confidence", "Candidate Edge"]
    if not results:
        return pd.DataFrame(columns=columns)
    return pd.DataFrame(results, columns=columns).sort_values(
        ["Candidate Edge", "Matched Fields"], ascending=[False, False]
    ).reset_index(drop=True)


def to_excel_bytes(df: pd.DataFrame) -> bytes:
    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        df.to_excel(writer, index=False)
    return buf.getvalue()


# ---------------------------------------------------------------------------
# STREAMLIT UI
# ---------------------------------------------------------------------------

st.set_page_config(page_title="Lineage Discovery", layout="wide")
st.title("End-to-End Lineage Discovery")
st.caption("ERP sources → DTTU / Longview / ERS → Corptax → filing schedule — inferred from extracts, not live system access.")

with st.sidebar:
    st.header("Matching sensitivity")
    header_threshold = st.slider("Header name match threshold", 50, 100, 80)
    value_threshold = st.slider("Value overlap threshold", 0.0, 1.0, 0.5, 0.05)
    min_matched_fields = st.slider("Min matched fields to call it a candidate edge", 1, 10, 2)

st.subheader("1. Upload extracts")
st.write("Upload one file per system. Name each one after the system it represents (SAP, ERS, DTTU, Longview, Corptax, Filing, etc.) — you decide the labels, so unknown-flow systems like DTTU are just another node.")

if "systems" not in st.session_state:
    st.session_state.systems = ["SAP_TB", "ERS", "DTTU", "Longview", "Corptax", "Filing"]

cols = st.columns(3)
dfs = {}
for i, system in enumerate(st.session_state.systems):
    with cols[i % 3]:
        uploaded = st.file_uploader(system, type=["csv", "xlsx", "xls"], key=f"upload_{system}")
        if uploaded is not None:
            try:
                dfs[system] = read_any(uploaded)
                st.success(f"{len(dfs[system])} rows, {len(dfs[system].columns)} columns")
            except Exception as e:
                st.error(f"Could not read {system}: {e}")

new_system = st.text_input("Add another system/tool (optional)", "")
if st.button("Add system") and new_system.strip():
    st.session_state.systems.append(new_system.strip())
    st.rerun()

st.divider()
st.subheader("2. Discover candidate edges")
st.write("Tests every pair of uploaded systems for field/value overlap. Doesn't assume a fixed hop order — this is what tells you where an ambiguous system like DTTU actually connects.")

if st.button("Run discovery", type="primary", disabled=len(dfs) < 2):
    report = pairwise_overlap_report(dfs, header_threshold, value_threshold, min_matched_fields)
    st.session_state["report"] = report

if len(dfs) < 2:
    st.info("Upload at least 2 files to run discovery.")

if "report" in st.session_state:
    report = st.session_state["report"]
    st.dataframe(
        report.style.apply(
            lambda row: ["background-color: #d4f7d4" if row["Candidate Edge"] else "" for _ in row],
            axis=1,
        ),
        use_container_width=True,
    )
    st.download_button(
        "Download edge discovery report (xlsx)",
        data=to_excel_bytes(report),
        file_name="lineage_edge_discovery.xlsx",
    )

    st.divider()
    st.subheader("3. Field-level mapping for a confirmed pair")
    st.write("Once you've confirmed a real edge (on the SME call or from strong scores above), pick the pair here to generate the actual Source/Target field log.")

    candidate_pairs = report[report["Candidate Edge"]] if not report.empty else report
    pair_options = [f"{r['From']} → {r['To']}" for _, r in candidate_pairs.iterrows()] or \
                   [f"{r['From']} → {r['To']}" for _, r in report.iterrows()]

    if pair_options:
        selected = st.selectbox("Choose a pair", pair_options)
        from_sys, to_sys = selected.split(" → ")

        if st.button("Generate field-level mapping"):
            mapping_df = field_level_mapping(
                dfs[from_sys], dfs[to_sys], from_sys, to_sys,
                header_threshold, value_threshold,
            )
            st.session_state["mapping_df"] = mapping_df
            st.session_state["mapping_pair"] = selected

        if "mapping_df" in st.session_state:
            st.write(f"**{st.session_state['mapping_pair']}**")
            mapping_df = st.session_state["mapping_df"]

            def highlight_row(row):
                if row["Adjustment Type"]:
                    return ["background-color: #fff3cd" for _ in row]
                return ["" for _ in row]

            st.dataframe(mapping_df.style.apply(highlight_row, axis=1), use_container_width=True)
            st.download_button(
                "Download field mapping (xlsx)",
                data=to_excel_bytes(mapping_df),
                file_name=f"lineage_mapping_{from_sys}_to_{to_sys}.xlsx",
            )

            n_adj = (mapping_df["Adjustment Type"] != "").sum()
            st.caption(
                f"{len(mapping_df) - n_adj} matched fields, {n_adj} unmatched target fields "
                f"flagged as candidate adjustments/manual entries — confirm these specifically on the SME call."
            )
