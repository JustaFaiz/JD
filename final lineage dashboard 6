    _cached_load_workbook_formulas = st.cache_data(show_spinner=False)(load_workbook_formulas)
    _cached_load_raw_sheets = st.cache_data(show_spinner=False)(load_raw_sheets)
    _cached_fallback_match = st.cache_data(show_spinner=False)(fallback_match_unreached_sheets)

    @st.cache_resource(show_spinner=False)
    def _cached_open_workbooks(file_bytes, _name):
        """
