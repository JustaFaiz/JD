    }},
    nodes: {{ font: {{ color: "#ffffff", size: 16 }} }}
  }});
  network.once("stabilizationIterationsDone", function () {{ network.setOptions({{physics: false}}); }});
</script>
</body></html>"""


# ---------------------------------------------------------------------------
# STREAMLIT UI
# ---------------------------------------------------------------------------

def run_app():
    st.set_page_config(page_title="Filing Lineage", layout="wide")
    st.title("Filing-Centric Lineage")
    st.caption("Pick your filing reference sheet -> trace every real formula link feeding it -> fuzzy-fallback for anything formulas don't reach.")

    uploaded = st.file_uploader("Upload workbook", type=["xlsx", "xls"])
    if uploaded is None:
        st.info("Upload your workbook to get started.")
        return

    file_bytes = uploaded.getvalue()

    if "fld_formulas" not in st.session_state or st.session_state.get("_fld_name") != uploaded.name:
        with st.spinner("Reading formulas and defined names..."):
            formulas, sheetnames, defined_name_map = load_workbook_formulas(file_bytes)
            raw_sheets = pd.read_excel(io.BytesIO(file_bytes), sheet_name=None)
            st.session_state["fld_formulas"] = formulas
            st.session_state["fld_sheetnames"] = sheetnames
            st.session_state["fld_defined_names"] = defined_name_map
            st.session_state["fld_raw_sheets"] = raw_sheets
            st.session_state["_fld_name"] = uploaded.name
            st.session_state.pop("fld_lineage", None)

    sheetnames = st.session_state["fld_sheetnames"]
    formulas = st.session_state["fld_formulas"]
    defined_name_map = st.session_state["fld_defined_names"]
    raw_sheets = st.session_state["fld_raw_sheets"]

    st.success(f"Loaded {len(sheetnames)} sheets, {len(formulas)} formulas, {len(defined_name_map)} defined name(s).")

    st.subheader("1. Filing reference sheet")
    default_idx = next((i for i, s in enumerate(sheetnames) if "taxable income" in s.lower()), 0)
    root_sheet = st.selectbox("This sheet is the root/output node -- the final aggregation sheet.", sheetnames, index=default_idx)

    st.subheader("2. Final output cell (Taxable Income / Line 30)")
    input_mode = st.radio(
        "How do you want to specify it?",
        ["Enter cell reference directly", "Pick from auto-detected candidates"],
        horizontal=True,
    )

    if input_mode == "Enter cell reference directly":
        cell_ref = st.text_input("Cell reference on the filing reference sheet (e.g. B30)", value="")
        if cell_ref.strip():
            info = lookup_cell_direct(file_bytes, root_sheet, cell_ref)
            if info is None:
                st.error(f"Couldn't parse or find '{cell_ref}' on {root_sheet} -- check the reference (e.g. B30).")
                final_output_desc = None
            else:
                label_text = f'"{info["label"]}"' if info["label"] else "(no label found in column A)"
                if info["value"] is None and info["formula"]:
                    st.warning(
                        f"Row {info['row']}, col {info['col']}: {label_text}, formula {info['formula']} -- "
                        f"no cached value (this workbook wasn't last saved by Excel itself, so openpyxl can't "
                        f"read a computed result). The formula and label look fine to use regardless."
                    )
                else:
                    st.success(f"Row {info['row']}, col {info['col']}: {label_text} = {info['value']}")
                final_output_desc = f'{label_text} (cell {info["col"]}{info["row"]}) on {root_sheet}, value {info["value"]}'
        else:
            st.info("Enter a cell reference to confirm it before building the lineage.")
            final_output_desc = None
    else:
        candidates = detect_final_output_cell(raw_sheets[root_sheet])
        if candidates:
            options = [f"Row {r}, col {c}: \"{text}\" (match {score}%)" for r, c, text, score in candidates]
            choice_idx = st.selectbox("Best guesses, ranked -- confirm or pick a different one:", range(len(options)), format_func=lambda i: options[i])
            chosen = candidates[choice_idx]
            final_output_desc = f'"{chosen[2]}" (row {chosen[0]}, col {chosen[1]}) on {root_sheet}'
        else:
            st.warning("No row matched 'Taxable Income' / 'Line 30' well -- switch to direct entry instead.")
            final_output_desc = None

    st.subheader("3. Build the lineage")
    with st.expander("Line-schedule naming pattern (advanced)"):
        st.write(
            "Sheets matching this pattern are treated as calculation/support schedules "
            "(Process node) even if nothing formula-feeds them -- e.g. \"L20\", \"Line_15\", "
            "\"Sch M-1\" are line-item schedules for the return, not raw data sources, even "
            "when they're self-contained. Adjust if your tabs follow a different convention."
        )
        line_schedule_pattern = st.text_input(
            "Regex (case-insensitive, matched from the start of the sheet name)",
            value=LINE_SCHEDULE_PATTERN_DEFAULT,
        )
        test_name = st.text_input("Test a sheet name against this pattern", value="L20 Depreciation")
        if test_name:
            matched = matches_line_schedule_pattern(test_name, line_schedule_pattern)
            st.caption(("Matches" if matched else "Does not match") + f" -- \"{test_name}\"")

    if st.button("Trace lineage from this root", type="primary", disabled=final_output_desc is None):
        with st.spinner("Tracing formulas backward from root..."):
            traced_edges, visited = trace_lineage_from_root(root_sheet, formulas, defined_name_map)
        unmapped = [s for s in sheetnames if s not in visited]
        with st.spinner(f"Running fallback matching on {len(unmapped)} unreached sheet(s)..."):
            fallback_edges = fallback_match_unreached_sheets(unmapped, list(visited), raw_sheets)
        lineage = classify_and_assemble(root_sheet, traced_edges, fallback_edges, final_output_desc, line_schedule_pattern)
        st.session_state["fld_lineage"] = lineage

        excluded = [s for s in unmapped if s not in fallback_edges]
        if excluded:
            st.warning(f"{len(excluded)} sheet(s) had no formula path AND no match clearing {CONFIDENCE_THRESHOLD}% -- excluded: {', '.join(excluded)}")

    if "fld_lineage" in st.session_state:
        lineage = st.session_state["fld_lineage"]

        st.divider()
        st.subheader("4. Result")
        nodes_df = pd.DataFrame(lineage["nodes"])
        rel_df = pd.DataFrame(lineage["relationships"])

        col1, col2 = st.columns(2)
        with col1:
            st.write("**Nodes**")
            st.dataframe(nodes_df, use_container_width=True, hide_index=True)
        with col2:
            st.write("**Relationships**")
            st.dataframe(rel_df, use_container_width=True, hide_index=True)

        st.divider()
        st.subheader("5. Outputs")

        dl_col, vis_col, json_col = st.columns(3)

        with dl_col:
            st.download_button(
                "Download Excel", data=lineage_to_excel_bytes(lineage),
                file_name="filing_lineage.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            )

        with vis_col:
            if st.button("Open Visual in New Tab"):
                html = build_lineage_visual_html(lineage)
                tmpdir = tempfile.mkdtemp(prefix="filing_lineage_")
                html_path = os.path.join(tmpdir, "lineage_visual.html")
                with open(html_path, "w", encoding="utf-8") as f:
                    f.write(html)
                webbrowser.open(f"file://{html_path}")
                st.success("Opened in a new browser tab (same machine this app is running on).")

        with json_col:
            st.download_button(
                "Download JSON", data=json.dumps(lineage, indent=2),
                file_name="filing_lineage.json", mime="application/json",
            )


if __name__ == "__main__":
    if st is None:
        raise SystemExit("Streamlit is required to run this app: pip install streamlit")
    run_app()
