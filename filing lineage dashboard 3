  }}
</style></head>
<body>
<div id="hint">
  <b>Filing reference:</b> {lineage['filing_reference']}<br>
  <b>Final output:</b> {lineage['final_output']}<br>
  Green = Input source, teal = Process node, gold = Output node (root).<br>
  Top = furthest upstream, bottom = filing output. Drag to nudge within a level if boxes overlap.
</div>
<div id="tree"></div>
<script>
  var nodes = new vis.DataSet({nodes_json});
  var edges = new vis.DataSet({edges_json});
  var network = new vis.Network(document.getElementById('tree'), {{nodes: nodes, edges: edges}}, {{
    layout: {{
      hierarchical: {{
        enabled: true, direction: "DU", sortMethod: "directed",
        levelSeparation: 220, nodeSpacing: 260, treeSpacing: 280
      }}
    }},
