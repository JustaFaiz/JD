# Palette for system-level coloring, used once a classification file is
# supplied. Falls back to a hashed color for any label not in this list,
# so an unexpected "Final System" value from the classification file still
# renders instead of erroring.
SYSTEM_COLORS = {
    "SAP_TB":   "#4285F4",
    "ERS":      "#34A853",
    "DTTU":     "#FBBC05",
    "Longview": "#9C27B0",
    "Corptax":  "#EA4335",
    "Filing":   "#00ACC1",
    "Unclassified": "#888888",
}


def system_color(system_name):
    if system_name in SYSTEM_COLORS:
        return SYSTEM_COLORS[system_name]
    # deterministic fallback color for any label outside the known set
    h = abs(hash(system_name)) % 0xFFFFFF
    return f"#{h:06x}"


# Keyword match against the system label to bucket it into a stage. Only
# "Input" is matched explicitly (SAP/ERS are where data originates);
# everything else -- Corptax, Longview, DTTU, workpapers, tangibles, or
# any custom label you typed in the classification editor -- defaults to
# "Process", matching how these were described: SAP/ERS feed in, and
# everything downstream of that is process.
STAGE_INPUT_KEYWORDS = ["sap", "ers"]


def infer_stage(system_name):
    # split on any non-alphanumeric (including underscore) so "SAP_TB" and
    # "Workpapers" both tokenize sensibly -- a plain \b regex treats "_" as
    # a word character, which would wrongly keep "sap" glued to "_tb" and
    # miss it, while a bare substring check wrongly matches "ers" inside
    # "Workpapers". Exact token match avoids both failure modes.
    tokens = re.split(r"[^a-z0-9]+", (system_name or "").lower())
    if any(kw in tokens for kw in STAGE_INPUT_KEYWORDS):
        return "Input"
    return "Process"


# Initial x-position seed per stage, in the same pixel space vis-network
# uses. This only biases where each node STARTS before physics settles --
# every node stays fully, freely draggable afterward in any direction.
# It's a starting hint, not a lock, so an Input node can still end up
# wherever you drag it.
STAGE_X_SEED = {"Input": -400, "Process": 400}


def load_classification(path):
    """
    Reads a classification workbook (the 'tab_classification.xlsx' export
    from the lineage dashboard) and returns {sheet_name: system_label},
    skipping rows marked Skip/blank. Matches the "Sheet Name" / "Final
    System" columns by header text, case-insensitively, so it still works
    if column order changes.
    """
    wb = load_workbook(path, data_only=True, read_only=True)
    ws = wb.worksheets[0]
    rows = ws.iter_rows(values_only=True)
    header = next(rows)
    header_lower = [str(h).strip().lower() if h else "" for h in header]
    try:
        sheet_col = header_lower.index("sheet name")
        system_col = header_lower.index("final system")
    except ValueError:
        wb.close()
        raise ValueError(
            "Classification file must have 'Sheet Name' and 'Final System' columns "
            "(the export from the lineage dashboard's tab-classification step)."
        )

    classification = {}
    for row in rows:
        if row is None or len(row) <= max(sheet_col, system_col):
            continue
        sheet_name = row[sheet_col]
        system = row[system_col]
        if not sheet_name or not system:
            continue
        system = str(system).strip()
        if system.lower() in ("skip", ""):
            continue
        classification[str(sheet_name)] = system
    wb.close()
    return classification

CELL_REF_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])(\$?[A-Z]{1,3}\$?\d{1,7})(?::(\$?[A-Z]{1,3}\$?\d{1,7}))?(?!\()"
)
COLUMN_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?([A-Z]{1,3})\$?:\$?([A-Z]{1,3})\$?(?![A-Za-z0-9_])"
)
ROW_ONLY_RE = re.compile(
    r"(?:(?:'([^']+)'|([A-Za-z_][A-Za-z0-9_]*))!)?"
    r"(?<![A-Za-z0-9_])\$?(\d{1,7})\$?:\$?(\d{1,7})\$?(?![A-Za-z0-9_])"
)

FULL_RANGE_ROW_CAP = 5000
FULL_RANGE_COL_CAP = 200

# Cap on how many individual cross-sheet formulas get listed in the
# Excel export's "Cross-Sheet Formulas" column per sheet - a sheet with
# thousands of cross-sheet formulas would otherwise produce a single
# cell too large to be useful (or to open comfortably).
MAX_FORMULAS_LISTED = 50


def _spans_overlap(span, other_spans):
    s0, s1 = span
    for a0, a1 in other_spans:
        if s0 < a1 and a0 < s1:
            return True
    return False


def extract_refs(formula, current_sheet, sheet_bounds):
    """Returns list of (sheet, cell, is_range). For a range reference
    (A2:A500, a full column, or a full row), only the FIRST and LAST
    cell of that range are returned - not every cell in between. This
    keeps things fast and lets ranges still get dependent arrows drawn
    (just on their two boundary cells) instead of being skipped
    entirely or expanding to thousands of individual cells."""
    refs = []
    matched_spans = []

    for m in CELL_REF_RE.finditer(formula):
        matched_spans.append(m.span())
        sheet = m.group(1) or m.group(2) or current_sheet
        cell1 = m.group(3).replace('$', '')
        cell2 = m.group(4)
        if cell2:
            cell2 = cell2.replace('$', '')
            refs.append((sheet, cell1, True))
            refs.append((sheet, cell2, True))
        else:
            refs.append((sheet, cell1, False))

    for m in COLUMN_ONLY_RE.finditer(formula):
        if _spans_overlap(m.span(), matched_spans):
            continue
        sheet = m.group(1) or m.group(2) or current_sheet
        col1, col2 = m.group(3), m.group(4)
        c1, c2 = column_index_from_string(col1), column_index_from_string(col2)
        if c1 > c2:
            c1, c2 = c2, c1
        max_row = min(sheet_bounds.get(sheet, (FULL_RANGE_ROW_CAP, 1))[0], FULL_RANGE_ROW_CAP) or 1
        refs.append((sheet, f"{get_column_letter(c1)}1", True))
        refs.append((sheet, f"{get_column_letter(c2)}{max_row}", True))

    for m in ROW_ONLY_RE.finditer(formula):
        if _spans_overlap(m.span(), matched_spans):
            continue
        sheet = m.group(1) or m.group(2) or current_sheet
        row1, row2 = int(m.group(3)), int(m.group(4))
        if row1 > row2:
            row1, row2 = row2, row1
        max_col = min(sheet_bounds.get(sheet, (1, FULL_RANGE_COL_CAP))[1], FULL_RANGE_COL_CAP) or 1
        refs.append((sheet, f"A{row1}", True))
        refs.append((sheet, f"{get_column_letter(max_col)}{row2}", True))

    return refs


def load_formulas(path):
    """Uses read_only=True for much faster loading on large workbooks -
    streams rows instead of building the full in-memory object model.
    Note: in read_only mode, blank cells come back as a bare EmptyCell
    with no .coordinate attribute at all, so position is tracked by
    enumerating rows/columns ourselves instead of reading it off the cell."""
    wb = load_workbook(path, data_only=False, read_only=True)
    formulas = {}
    sheet_bounds = {}
    for ws in wb.worksheets:
        max_row = ws.max_row or 1
        max_col = ws.max_column or 1
        sheet_bounds[ws.title] = (max_row, max_col)
        rows = ws.iter_rows(min_row=1, max_row=max_row, min_col=1, max_col=max_col)
        for r_idx, row in enumerate(rows, start=1):
            for c_idx, cell in enumerate(row, start=1):
                if isinstance(cell.value, str) and cell.value.startswith('='):
                    coord = f"{get_column_letter(c_idx)}{r_idx}"
                    formulas[(ws.title, coord)] = cell.value
    sheetnames = wb.sheetnames
    wb.close()
    return formulas, sheetnames, sheet_bounds


def build_sheet_flow(formulas, sheet_bounds, min_cells=1):
    """Returns (flow, precedent_cells, dependent_cells):
    - flow: (src_sheet, dst_sheet) -> cell count, for the tree/edges
    - precedent_cells: sheet -> cells on that sheet whose formulas pull
      from another sheet (used to draw Trace Precedents arrows)
    - dependent_cells: sheet -> cells on that sheet that get pulled INTO
      formulas on other sheets (used to draw Trace Dependents arrows).
      For a range reference, only its first and last cell are included.

    Only sheet-pairs with min_cells+ total links are included in
    precedent_cells/dependent_cells - matching the same threshold used
    to decide which links show up in the tree diagram, so arrow-drawing
    doesn't include weak 1-2 cell links that aren't even visible in the
    graph."""
    flow = {}
    raw_refs = []  # (dst_sheet, dst_cell, src_sheet, src_cell)
    for (sheet, cell), f in formulas.items():
        refs = extract_refs(f, sheet, sheet_bounds)
        cross_sheet_refs = [(s, c, is_range) for s, c, is_range in refs if s != sheet]
        source_sheets = set(s for s, c, is_range in cross_sheet_refs)
        for src in source_sheets:
            key = (src, sheet)
            flow[key] = flow.get(key, 0) + 1
        for src_sheet, src_cell, is_range in cross_sheet_refs:
            raw_refs.append((sheet, cell, src_sheet, src_cell))

    precedent_cells = {}
    dependent_cells = {}
    for dst_sheet, dst_cell, src_sheet, src_cell in raw_refs:
        if flow.get((src_sheet, dst_sheet), 0) < min_cells:
            continue
        precedent_cells.setdefault(dst_sheet, set()).add(dst_cell)
        dependent_cells.setdefault(src_sheet, set()).add(src_cell)

    return flow, precedent_cells, dependent_cells


def export_trace_to_excel(formulas, sheet_bounds, flow, sheetnames, output_path):
    """Writes one row per sheet to a new .xlsx summarizing its place in
    the cross-sheet formula flow:
        Sheet Name | Fed By (upstream sheets) | Fed Into (downstream
        sheets) | Input Reference Count | Output Reference Count |
        Cross-Sheet Formulas On This Sheet

    "Fed By" / "Fed Into" and the reference counts are read straight off
    `flow` (all links, same source of truth as the tree diagram, not
    filtered by min_cells - so this export is a complete record even if
    the diagram itself is showing a filtered view).

    The formulas column is populated by re-checking each formula on a
    sheet for any cross-sheet reference via extract_refs - same logic
    build_sheet_flow uses, just organized per-sheet instead of
    aggregated into counts. Long lists are capped (MAX_FORMULAS_LISTED)
    so a sheet with thousands of cross-sheet formulas doesn't produce
    one unreadably huge cell.
    """
    formulas_by_sheet = {}
    for (sheet, cell), f in formulas.items():
        refs = extract_refs(f, sheet, sheet_bounds)
        if any(s != sheet for s, c, is_range in refs):
            formulas_by_sheet.setdefault(sheet, []).append(f"{cell}: {f}")

    wb = Workbook()
    ws = wb.active
    ws.title = "Sheet Trace"

    headers = [
        "Sheet Name",
        "Fed By (Upstream Sheets)",
        "Fed Into (Downstream Sheets)",
        "Input Reference Count",
        "Output Reference Count",
        "Cross-Sheet Formulas On This Sheet",
    ]
    ws.append(headers)
    for col_idx in range(1, len(headers) + 1):
        ws.cell(row=1, column=col_idx).font = Font(bold=True)

    for sheet in sorted(sheetnames):
        fed_by = sorted({src for (src, dst) in flow if dst == sheet})
        fed_into = sorted({dst for (src, dst) in flow if src == sheet})
        input_count = sum(v for (src, dst), v in flow.items() if dst == sheet)
        output_count = sum(v for (src, dst), v in flow.items() if src == sheet)

        f_list = formulas_by_sheet.get(sheet, [])
        formulas_text = "; ".join(f_list[:MAX_FORMULAS_LISTED])
        if len(f_list) > MAX_FORMULAS_LISTED:
            formulas_text += f" ... ({len(f_list) - MAX_FORMULAS_LISTED} more not shown)"

        ws.append([
            sheet,
            ", ".join(fed_by) if fed_by else "(none)",
            ", ".join(fed_into) if fed_into else "(none)",
            input_count,
            output_count,
            formulas_text if formulas_text else "(none)",
        ])

    widths = [22, 30, 30, 14, 14, 100]
    for i, w in enumerate(widths, start=1):
        ws.column_dimensions[get_column_letter(i)].width = w

    ws.freeze_panes = "A2"
    wb.save(output_path)
    return output_path


_last_auto_unhidden = {"path": None, "sheet": None}


def open_sheet_in_excel(workbook_path, sheet_name, precedent_cells=None, dependent_cells=None):
    """Uses pywin32 COM automation to actually drive Excel - no add-in
    required, this is the same mechanism VBA macros use. Grabs an
    already-running Excel instance if one has this workbook open;
    otherwise starts Excel and opens it fresh. Draws Trace Precedents
    arrows on precedent_cells (this sheet's formulas pulling from
    elsewhere) and Trace Dependents arrows on dependent_cells (this
    sheet's cells being pulled into formulas elsewhere) - covers both
    directions so source/input sheets, which have no precedents of
    their own, still show something meaningful."""
    import win32com.client as win32
    import pywintypes
    import win32gui
    import win32process
    import win32api
    import win32con

    def com_retry(func, attempts=6, delay=0.4, required=True):
        """Retries a COM call a few times before giving up - Excel's COM
        interface can be transiently 'not ready' right after launching,
        opening a workbook, or switching sheets, which raises errors on
        whatever call happens to run next (not always the same one).
        required=False swallows the final failure instead of raising."""
        last_exc = None
        for _ in range(attempts):
            try:
                return func()
            except Exception as e:
                last_exc = e
                time.sleep(delay)
        if required:
            raise last_exc
        return None

    def norm(p):
        return os.path.normcase(os.path.normpath(p))

    abs_path = os.path.abspath(workbook_path)
    target_norm = norm(abs_path)
    target_base = os.path.basename(abs_path).lower()

    excel = None
    wb = None

    try:
        excel = win32.GetActiveObject("Excel.Application")
    except pywintypes.com_error:
        excel = None

    if excel is not None:
        for book in excel.Workbooks:
            try:
                if norm(book.FullName) == target_norm:
                    wb = book
                    break
            except Exception:
                continue
        if wb is None:
            for book in excel.Workbooks:
                try:
                    if book.Name.lower() == target_base:
                        wb = book
                        break
                except Exception:
                    continue

    if excel is None:
        excel = win32.Dispatch("Excel.Application")

    com_retry(lambda: setattr(excel, "Visible", True))
    com_retry(lambda: setattr(excel, "DisplayAlerts", False), required=False)
    com_retry(lambda: setattr(excel, "AskToUpdateLinks", False), required=False)

    if wb is None:
        wb = com_retry(lambda: excel.Workbooks.Open(abs_path, 0))

    # Files in Downloads are usually tagged "from the internet" by Windows,
    # so Excel opens them in Protected View - which blocks most automation
    # until the user manually clicks "Enable Editing". Detect and exit
    # Protected View automatically instead.
    def exit_protected_view():
        if wb.ProtectedViewWindow is not None:
            return wb.ProtectedViewWindow.Edit()
        return wb
    new_wb = com_retry(exit_protected_view, required=False)
    if new_wb is not None:
        wb = new_wb

    com_retry(lambda: setattr(excel, "DisplayAlerts", False), required=False)
    com_retry(lambda: wb.Activate())

    # Re-hide whatever sheet we auto-unhid last time, if we're now
    # switching to a different one.
    global _last_auto_unhidden
    if (_last_auto_unhidden["path"] == target_norm
            and _last_auto_unhidden["sheet"] is not None
            and _last_auto_unhidden["sheet"] != sheet_name):
        com_retry(lambda: setattr(wb.Sheets(_last_auto_unhidden["sheet"]), "Visible", 0), required=False)
        _last_auto_unhidden["sheet"] = None

    sht = com_retry(lambda: wb.Sheets(sheet_name))

    was_hidden = com_retry(lambda: sht.Visible != -1, required=False)  # -1 = xlSheetVisible
    if was_hidden:
        com_retry(lambda: setattr(sht, "Visible", -1), required=False)
    com_retry(lambda: sht.Activate())

    if was_hidden:
        _last_auto_unhidden["path"] = target_norm
        _last_auto_unhidden["sheet"] = sheet_name

    # Clear any previously-drawn tracer arrows on this sheet, then draw
    # fresh Trace Precedents arrows on every cell here that pulls from
    # another sheet - same visual Excel draws when you click the
    # Formulas > Trace Precedents button yourself.
    #
    # NOTE: an earlier version tried batching cells into combined
    # multi-area Ranges to cut down COM calls. That silently broke
    # arrow-drawing entirely - ShowPrecedents/ShowDependents apparently
    # don't support multi-area Ranges the way most Range methods do, so
    # every batched call failed (silently swallowed by the retry logic)
    # and the repeated retries-with-delays across many batches is what
    # caused the long hang. Back to one call per cell, which is what
    # actually works - but with ScreenUpdating off during the loop
    # (cuts real overhead, since Excel doesn't repaint after every
    # single arrow) and a hard cap so a truly extreme sheet can't hang
    # indefinitely or render an unreadably dense wall of arrows anyway.
    MAX_ARROWS_PER_TYPE = 300

    def draw_arrows(addresses, method_name):
        addresses = list(addresses)
        truncated = len(addresses) > MAX_ARROWS_PER_TYPE
        if truncated:
            addresses = addresses[:MAX_ARROWS_PER_TYPE]
        for addr in addresses:
            com_retry(lambda addr=addr: getattr(sht.Range(addr), method_name)(), required=False)
        return truncated

    com_retry(lambda: setattr(excel, "ScreenUpdating", False), required=False)
    try:
        com_retry(lambda: sht.ClearArrows(), required=False)
        precedents_truncated = draw_arrows(precedent_cells, "ShowPrecedents") if precedent_cells else False
        dependents_truncated = draw_arrows(dependent_cells, "ShowDependents") if dependent_cells else False
    finally:
        com_retry(lambda: setattr(excel, "ScreenUpdating", True), required=False)

    # Force real foreground focus on THIS workbook's own window
    # specifically. Windows blocks background processes from stealing
    # focus by default; this combines two standard workarounds: a brief
    # simulated Alt key-tap (satisfies one of Windows' focus-stealing
    # conditions) plus attaching input threads together.
    try:
        hwnd = wb.Windows(1).Hwnd

        win32api.keybd_event(win32con.VK_MENU, 0, 0, 0)
        win32api.keybd_event(win32con.VK_MENU, 0, win32con.KEYEVENTF_KEYUP, 0)

        fg_hwnd = win32gui.GetForegroundWindow()
        fg_thread = win32process.GetWindowThreadProcessId(fg_hwnd)[0]
        target_thread = win32process.GetWindowThreadProcessId(hwnd)[0]
        current_thread = win32api.GetCurrentThreadId()

        win32process.AttachThreadInput(fg_thread, current_thread, True)
        win32process.AttachThreadInput(target_thread, current_thread, True)
        try:
            win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
            win32gui.BringWindowToTop(hwnd)
            win32gui.SetForegroundWindow(hwnd)
        finally:
            win32process.AttachThreadInput(fg_thread, current_thread, False)
            win32process.AttachThreadInput(target_thread, current_thread, False)
    except Exception:
        pass

    return {"precedents_truncated": precedents_truncated, "dependents_truncated": dependents_truncated}


