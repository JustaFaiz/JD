def nav_html(view_keys, active_key):
    """
    Simple top nav bar linking every generated view. view_keys is an
    ordered list of (url, label) pairs; active_key's matching url gets
    highlighted. Returns '' (no bar at all) if there's only one view,
    since a nav bar with a single link is just clutter.
    """
    if len(view_keys) <= 1:
        return ""
    links = []
    for url, label in view_keys:
        cls = ' class="active"' if url == active_key else ""
        links.append(f'<a href="{url}"{cls}>{label}</a>')
    return '<div id="navBar">' + "".join(links) + "</div>"


def render_view(nodes, edges, nav, hint_replacement, node_spacing):
    """
    Shared template assembly for every view (build_html, system overview,
    per-system) -- injects nodes/edges/nav and sets the physics spring
    length so views with fewer, bigger nodes (like System Overview) get
    more room than the full sheet-level tree. Layout is free-form
    (force-directed, not hierarchical), so every node stays draggable in
    any direction after it settles -- no curved edges needed to keep
    labels from overlapping, since you can just move the nodes apart.
    """
    html = HTML_TEMPLATE.replace("__NODES__", json.dumps(nodes)).replace("__EDGES__", json.dumps(edges))
    html = html.replace("__NAV__", nav)
    html = html.replace("__NODE_SPACING__", str(node_spacing))
    html = html.replace(
        "Green = input sheet, orange = output sheet, teal = in-between.<br>",
        hint_replacement,
    )
    return html


def build_html(flow, min_cells, classification=None, nav=""):
    """
    classification, if given ({sheet: system}), colors nodes by system
    instead of by root/leaf/middle position, and adds the system name to
    each node's tooltip -- this is what lets the full sheet-level view
    also show, at a glance, how systems join (e.g. a Corptax-colored node
    with incoming edges from both blue SAP nodes and purple Longview
    nodes).
    """
    strong = {k: v for k, v in flow.items() if v >= min_cells}
    if not strong:
        return None

    all_sheets = set()
    has_incoming = set()
    has_outgoing = set()
    for src, dst in strong:
        all_sheets.add(src)
        all_sheets.add(dst)
        has_outgoing.add(src)
        has_incoming.add(dst)

    roots = all_sheets - has_incoming
    leaves = all_sheets - has_outgoing

    nodes = []
    for sheet in all_sheets:
        system = classification.get(sheet) if classification else None
        if system:
            color = system_color(system)
            title = f"{sheet}\\nSystem: {system}\\nClick to switch to this sheet in Excel"
        elif sheet in roots:
            color = "#2ecc71"
            title = f"{sheet}\\nClick to switch to this sheet in Excel"
        elif sheet in leaves:
            color = "#f39c12"
            title = f"{sheet}\\nClick to switch to this sheet in Excel"
        else:
            color = "#2a9d8f"
            title = f"{sheet}\\nClick to switch to this sheet in Excel"
        nodes.append({
            "id": sheet, "label": sheet, "color": color,
            "shape": "box", "size": 25, "clickable": True,
            "title": title,
        })

    max_count = max(strong.values())
    edges = []
    for (src, dst), count in strong.items():
        width = 1 + (count / max_count) * 8
        edges.append({
            "from": src, "to": dst, "value": width,
            "label": str(count), "title": f"{count} formula cells"
        })

    hint_extra = (
        "Colored by system. Click a sheet to switch to it in Excel.<br>"
        if classification else
        "Green = input sheet, orange = output sheet, teal = in-between.<br>"
    )
    return render_view(nodes, edges, nav, hint_extra, node_spacing=200)


def build_system_overview_flow(flow, classification):
    """
    Rolls sheet-level links up to system-level links, dropping links
    where both ends are in the same system (those belong in the
    per-system view instead) or where either end has no classification
    (goes to 'Unclassified' rather than being silently dropped, so
    unlabeled tabs are still visible as a signal that something needs
    classifying).
    """
    system_flow = {}
    for (src, dst), count in flow.items():
        src_sys = classification.get(src, "Unclassified")
        dst_sys = classification.get(dst, "Unclassified")
        if src_sys == dst_sys:
            continue
        key = (src_sys, dst_sys)
        system_flow[key] = system_flow.get(key, 0) + count
    return system_flow


def build_system_overview_html(flow, classification, nav=""):
    """
    Whole-workbook view collapsed to one node per system. This is where
    joins are most visible -- e.g. a Corptax node with incoming edges
    from both SAP_TB and Longview shows exactly how those two systems'
    outputs converge before filing. Nodes aren't clickable (no single
    sheet to open for a whole system).

    Each node gets an initial x-position seeded by its stage (Input:
    SAP/ERS, vs. Process: everything else -- Corptax, Longview, DTTU,
    workpapers, etc.) so the layout starts roughly left-to-right by
    stage. That's only a starting hint for the physics simulation, not a
    lock -- every node is still freely draggable afterward.
    """
    system_flow = build_system_overview_flow(flow, classification)
    if not system_flow:
        return None

    systems = sorted(set(s for pair in system_flow for s in pair))

    # spread nodes within the same stage vertically so they don't all seed
    # at the exact same (x, y) and fight the physics solver on the first tick
    stage_counts = {}
    nodes = []
    for sys_ in systems:
        stage = infer_stage(sys_)
        seed_index = stage_counts.get(stage, 0)
        stage_counts[stage] = seed_index + 1
        nodes.append({
            "id": sys_, "label": sys_, "color": system_color(sys_),
            "shape": "box", "size": 35, "clickable": False,
            "title": f"{sys_}\\nStage: {stage}\\n(system-level view -- not a single sheet)",
            "font": {"size": 20},
            "x": STAGE_X_SEED[stage],
            "y": seed_index * 150 - 150,
        })

    max_count = max(system_flow.values())
    edges = []
    for (src, dst), count in system_flow.items():
        width = 1 + (count / max_count) * 10
        edges.append({
            "from": src, "to": dst, "value": width,
            "label": str(count), "title": f"{count} cross-sheet formula cells feed {dst} from {src}",
        })

    html = render_view(
        nodes, edges, nav,
        "System-level view: each box is a whole system, arrows show how they feed each other. "
        "Not clickable -- switch to a sheet-level view to open specific tabs. Roughly left "
        "(Input: SAP/ERS) to right (Process: everything else) to start -- drag freely from there.<br>",
        node_spacing=280,
    )
    return html


def build_per_system_flow(flow, classification, target_system):
    """
    Filtered view for one system: full internal sheet-to-sheet detail for
    tabs classified into target_system, PLUS collapsed boundary nodes
    (e.g. "[Longview]") for anything crossing in from or out to another
    system, so you see the internal structure without every external
    tab cluttering it. Returns (nodes_info, edges) where nodes_info maps
    node id -> {"clickable": bool, "system": str or None}.
    """
    nodes_info = {}
    edges = {}

    def boundary_id(system_name):
        return f"[{system_name}]"

    for (src, dst), count in flow.items():
        src_sys = classification.get(src)
        dst_sys = classification.get(dst)

        if src_sys == target_system and dst_sys == target_system:
            edge_key = (src, dst)
            nodes_info.setdefault(src, {"clickable": True, "system": src_sys})
            nodes_info.setdefault(dst, {"clickable": True, "system": dst_sys})
        elif dst_sys == target_system and src_sys != target_system:
            other = src_sys or "Unclassified"
            edge_key = (boundary_id(other), dst)
            nodes_info.setdefault(boundary_id(other), {"clickable": False, "system": other})
            nodes_info.setdefault(dst, {"clickable": True, "system": dst_sys})
        elif src_sys == target_system and dst_sys != target_system:
            other = dst_sys or "Unclassified"
            edge_key = (src, boundary_id(other))
            nodes_info.setdefault(src, {"clickable": True, "system": src_sys})
            nodes_info.setdefault(boundary_id(other), {"clickable": False, "system": other})
        else:
            continue

        edges[edge_key] = edges.get(edge_key, 0) + count

    return nodes_info, edges


def build_per_system_html(flow, classification, target_system, nav=""):
    nodes_info, edges = build_per_system_flow(flow, classification, target_system)
    if not edges:
        return None

    nodes = []
    for node_id, info in nodes_info.items():
        is_boundary = not info["clickable"]
        color = system_color(info["system"]) if info["system"] else "#888888"
        nodes.append({
            "id": node_id, "label": node_id, "color": color,
            "shape": "diamond" if is_boundary else "box",
            "size": 22 if is_boundary else 25,
            "clickable": info["clickable"],
            "title": (
                f"{node_id}\\n(external -- belongs to {info['system']})" if is_boundary
                else f"{node_id}\\nClick to switch to this sheet in Excel"
            ),
        })

    max_count = max(edges.values())
    edge_list = []
    for (src, dst), count in edges.items():
        width = 1 + (count / max_count) * 8
        edge_list.append({
            "from": src, "to": dst, "value": width,
            "label": str(count), "title": f"{count} formula cells",
        })

    html = render_view(
        nodes, edge_list, nav,
        f"{target_system} internal flow. Diamonds = other systems this connects to "
        f"(not individually clickable) -- boxes are real sheets in {target_system}. Drag freely to rearrange.<br>",
        node_spacing=230,
    )
    return html


class Handler(BaseHTTPRequestHandler):
    views = {}          # url path -> html string
    default_view = "/"
    workbook_path = ""
    precedent_cells = {}
    dependent_cells = {}

    def log_message(self, format, *args):
        pass  # keep the terminal quiet

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/":
            content = Handler.views.get(Handler.default_view)
        else:
            content = Handler.views.get(parsed.path)

        if content is not None:
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(content.encode("utf-8"))
        elif parsed.path == "/open":
            qs = parse_qs(parsed.query)
            sheet = qs.get("sheet", [None])[0]
            want_precedents = qs.get("precedents", ["true"])[0].lower() == "true"
            want_dependents = qs.get("dependents", ["true"])[0].lower() == "true"
            status = "ok"
            try:
                pre = sorted(Handler.precedent_cells.get(sheet, [])) if want_precedents else []
                dep = sorted(Handler.dependent_cells.get(sheet, [])) if want_dependents else []
                result = open_sheet_in_excel(Handler.workbook_path, sheet, precedent_cells=pre, dependent_cells=dep)
                notes = []
                if result and result.get("precedents_truncated"):
                    notes.append("precedents capped at 300")
                if result and result.get("dependents_truncated"):
                    notes.append("dependents capped at 300")
                if notes:
                    status = "ok (" + ", ".join(notes) + ")"
            except Exception as e:
                status = str(e)
                print(f"[!] Could not open sheet '{sheet}' in Excel: {e}")
                import traceback
                traceback.print_exc()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(status.encode("utf-8"))
        else:
            self.send_response(404)
            self.end_headers()


def main():
    if len(sys.argv) < 2:
        print("Usage: python sheet_tree_server.py <workbook.xlsx> [min_cells] [--classification tab_classification.xlsx]")
        print("No file argument given - exiting rather than opening a hardcoded sample.")
        sys.exit(1)

    args = sys.argv[1:]
    classification_path = None
    if "--classification" in args:
        idx = args.index("--classification")
        try:
            classification_path = args[idx + 1]
        except IndexError:
            print("--classification requires a file path after it.")
            sys.exit(1)
        del args[idx:idx + 2]

    path = args[0]
    min_cells = DEFAULT_MIN_CELLS
    if len(args) >= 2:
        try:
            min_cells = int(args[1])
        except ValueError:
            pass

    classification = {}
    if classification_path:
        try:
            classification = load_classification(classification_path)
            print(f"Loaded classification for {len(classification)} sheet(s) from {classification_path}.")
        except Exception as e:
            print(f"[!] Could not load classification file: {e}")
            print("Continuing without system-level views.")

    formulas, sheetnames, sheet_bounds = load_formulas(path)
    print(f"Loaded {len(formulas)} formulas across {len(sheetnames)} sheet(s).")

    flow, precedent_cells, dependent_cells = build_sheet_flow(formulas, sheet_bounds, min_cells=min_cells)
    print(f"Found {len(flow)} distinct sheet-to-sheet links. Showing links with {min_cells}+ cells.")

    if classification:
        unclassified = [s for s in sheetnames if s not in classification]
        if unclassified:
            print(f"Note: {len(unclassified)} sheet(s) have no classification entry and will show as 'Unclassified' in system views.")

    # Write the companion trace-data workbook regardless of min_cells -
    # this export uses ALL links found, not just the ones strong enough
    # to be drawn in the diagram, so it's a complete record.
    base, _ext = os.path.splitext(os.path.abspath(path))
    trace_output_path = base + "_trace_data.xlsx"
    try:
        export_trace_to_excel(formulas, sheet_bounds, flow, sheetnames, trace_output_path)
        print(f"Wrote sheet trace data to {trace_output_path}")
    except Exception as e:
        print(f"[!] Could not write trace data Excel file: {e}")

    # Build the nav bar's link list first (needed by every view), then
    # generate each view with that same nav so they all link to each other.
    nav_links = [("/view/all", "All Sheets")]
    if classification:
        nav_links.insert(0, ("/view/overview", "System Overview"))
        for sys_ in sorted(set(classification.values())):
            nav_links.append((f"/view/system/{sys_}", sys_))

    views = {}

    all_html = build_html(flow, min_cells, classification=classification or None, nav=nav_html(nav_links, "/view/all"))
    if all_html is None:
        print(f"No links with {min_cells}+ cells found - nothing to draw. Try a lower threshold.")
        return
    views["/view/all"] = all_html

    default_view = "/view/all"

    if classification:
        overview_html = build_system_overview_html(flow, classification, nav=nav_html(nav_links, "/view/overview"))
        if overview_html:
            views["/view/overview"] = overview_html
            default_view = "/view/overview"
        else:
            print("Note: no cross-system links found for the System Overview -- check that references between systems actually exist in this workbook.")

        for sys_ in sorted(set(classification.values())):
            sys_html = build_per_system_html(flow, classification, sys_, nav=nav_html(nav_links, f"/view/system/{sys_}"))
            if sys_html:
                views[f"/view/system/{sys_}"] = sys_html
            else:
                print(f"Note: no links found for system '{sys_}' -- skipping its view.")

    Handler.views = views
    Handler.default_view = default_view
    Handler.workbook_path = path
    Handler.precedent_cells = precedent_cells
    Handler.dependent_cells = dependent_cells

    server = HTTPServer(("127.0.0.1", PORT), Handler)
    actual_port = server.server_address[1]
    url = f"http://127.0.0.1:{actual_port}/"
    print(f"\nServing at {url}")
    if classification:
        print("Views: System Overview (default), All Sheets, and one per system -- use the nav bar at the top to switch.")
    print("Opening it in your browser now. Leave this window open while you use it - press Ctrl+C here to stop.")
    print("Clicking a real sheet box draws Trace Precedents arrows (what feeds it) AND Trace Dependents arrows")
    print("(what it feeds). System/boundary boxes in the overview and per-system views aren't clickable.")
    threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
