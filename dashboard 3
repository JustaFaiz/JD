SYSTEM_NAME_ALIASES = {
    "SAP_TB":   ["sap", "tb", "trial balance", "sap tb", "gl extract"],
    "ERS":      ["ers", "estimated return summary"],
    "DTTU":     ["dttu", "deferred tax true up", "deferred tax true-up", "true up", "true-up"],
    "Longview": ["longview", "lv", "lv upload", "upload template", "consolidation"],
    "Corptax":  ["corptax", "corp tax", "ctx", "corptax import"],
    "Filing":   ["filing", "return", "schedule", "tax return", "filed"],
}

MAX_COLS_FOR_CLASSIFICATION = 15
MAX_ROWS_FOR_VALUE_MATCH = 300
MAX_ROWS_FOR_FORMULA_SCAN = 100

DEFAULT_WEIGHTS = {"name": 0.25, "value": 0.75, "formula": 0.0}


# ---------------------------------------------------------------------------
# SIGNAL 1 & 2: column name + value overlap
# ---------------------------------------------------------------------------

def value_overlap_score(series_a: pd.Series, series_b: pd.Series) -> float:
    set_a = set(series_a.dropna().astype(str).str.strip().str.upper())
    set_b = set(series_b.dropna().astype(str).str.strip().str.upper())
    if not set_a or not set_b:
        return 0.0
    smaller = min(len(set_a), len(set_b))
    return (len(set_a & set_b) / smaller) if smaller else 0.0


def tab_similarity(df_a: pd.DataFrame, df_b: pd.DataFrame):
    """Returns (name_similarity, value_similarity), each 0-100."""
    cols_a = list(df_a.columns)[:MAX_COLS_FOR_CLASSIFICATION]
    cols_b = list(df_b.columns)[:MAX_COLS_FOR_CLASSIFICATION]
    if not cols_a or not cols_b:
        return 0.0, 0.0

    name_scores = [
        max((fuzz.token_sort_ratio(str(ca), str(cb)) for cb in cols_b), default=0)
        for ca in cols_a
    ]
    name_sim = sum(name_scores) / len(name_scores)

    sample_a = df_a[cols_a].head(MAX_ROWS_FOR_VALUE_MATCH)
    sample_b = df_b[cols_b].head(MAX_ROWS_FOR_VALUE_MATCH)
    value_scores = []
    for ca in cols_a:
        best_val = 0.0
        for cb in cols_b:
            try:
                score = value_overlap_score(sample_a[ca], sample_b[cb])
            except Exception:
                score = 0.0
            best_val = max(best_val, score)
        value_scores.append(best_val)
    value_sim = (sum(value_scores) / len(value_scores)) * 100 if value_scores else 0.0

    return round(name_sim), round(value_sim)


# ---------------------------------------------------------------------------
# SIGNAL 3 (optional): cell formulas
# ---------------------------------------------------------------------------

FUNC_TOKEN_RE = re.compile(r'([A-Z][A-Z0-9\.]{2,})\(')
SHEET_REF_RE = re.compile(r"(?:'([^']+)'|\b([A-Za-z0-9_]+))!")


def formula_tokens(formula: str) -> set:
    """Extract function names and referenced sheet names from a formula string."""
    tokens = set()
    upper = formula.upper()
    for fn in FUNC_TOKEN_RE.findall(upper):
        tokens.add(f"FN:{fn}")
    for m in SHEET_REF_RE.findall(formula):
        sheet = (m[0] or m[1])
        if sheet:
            tokens.add(f"REF:{sheet.upper()}")
    return tokens


def column_formula_signature(ws, ncols: int, nrows: int):
    """Returns list of token-sets, one per column position (1-indexed data starts row 2)."""
    sig = []
    max_col = min(ncols, ws.max_column or 0)
    max_row = min(nrows + 1, ws.max_row or 0)
    for j in range(1, max_col + 1):
        col_tokens = set()
        for i in range(2, max_row + 1):
            cell = ws.cell(row=i, column=j)
            if cell.data_type == "f" and isinstance(cell.value, str):
                col_tokens |= formula_tokens(cell.value)
        sig.append(col_tokens)
    return sig


def formula_similarity(sig_a: list, sig_b: list) -> float:
    if not sig_a or not sig_b:
        return 0.0
    scores = []
    for set_a in sig_a:
        best = 0.0
        for set_b in sig_b:
            if set_a and set_b:
                overlap = len(set_a & set_b) / len(set_a | set_b)
                best = max(best, overlap)
        scores.append(best)
    return (sum(scores) / len(scores)) * 100 if scores else 0.0


# ---------------------------------------------------------------------------
# CALIBRATION -- leave-one-out on reference tabs to derive signal weights
# ---------------------------------------------------------------------------

def calibrate_weights(reference_dfs: dict, reference_formula_sigs: dict, use_formula: bool):
    """
    reference_dfs: {system: [df, df, ...]}
    reference_formula_sigs: {system: [sig, sig, ...]} aligned by index, or {} if unused.

    For each system with 2+ reference tabs, hold out one at a time and check
    whether each signal alone ranks it closer to its own system's remaining
    references than to any other system's references. Returns calibrated
    weights, per-signal accuracy, and a note explaining what happened.
    """
    signals = ["name", "value"] + (["formula"] if use_formula else [])
    correct = {s: 0 for s in signals}
    total_trials = 0

    systems_with_pairs = [s for s, refs in reference_dfs.items() if len(refs) >= 2]
    if not systems_with_pairs:
        return dict(DEFAULT_WEIGHTS), {}, (
            "Not enough same-system reference tabs to calibrate (need 2+ per system for at "
            "least one system). Using default weights: 75% value overlap / 25% column names. "
            "Add a second reference tab to any system to enable calibration."
        )

    for system in systems_with_pairs:
        refs = reference_dfs[system]
        f_sigs = reference_formula_sigs.get(system, [None] * len(refs)) if use_formula else [None] * len(refs)
        other_refs = [(s2, i2) for s2, r2 in reference_dfs.items() if s2 != system for i2 in range(len(r2))]
        if not other_refs:
            continue

        for idx in range(len(refs)):
            held_out = refs[idx]
            held_out_fsig = f_sigs[idx]
            others_same = [refs[j] for j in range(len(refs)) if j != idx]
            others_same_fsig = [f_sigs[j] for j in range(len(refs)) if j != idx]
            other_sys_dfs = [reference_dfs[s2][i2] for s2, i2 in other_refs]
            other_sys_fsigs = [reference_formula_sigs.get(s2, [None] * len(reference_dfs[s2]))[i2] for s2, i2 in other_refs] if use_formula else [None] * len(other_refs)

            total_trials += 1
            name_scores_same, value_scores_same, formula_scores_same = [], [], []
            for o in others_same:
                n, v = tab_similarity(held_out, o)
                name_scores_same.append(n)
                value_scores_same.append(v)
            for fsig_o in others_same_fsig:
                if use_formula and held_out_fsig and fsig_o:
                    formula_scores_same.append(formula_similarity(held_out_fsig, fsig_o))

            name_scores_diff, value_scores_diff, formula_scores_diff = [], [], []
            for o in other_sys_dfs:
                n, v = tab_similarity(held_out, o)
                name_scores_diff.append(n)
                value_scores_diff.append(v)
            for fsig_o in other_sys_fsigs:
                if use_formula and held_out_fsig and fsig_o:
                    formula_scores_diff.append(formula_similarity(held_out_fsig, fsig_o))

            if max(name_scores_same, default=0) > max(name_scores_diff, default=0):
                correct["name"] += 1
            if max(value_scores_same, default=0) > max(value_scores_diff, default=0):
                correct["value"] += 1
            if use_formula:
                same_f = max(formula_scores_same, default=0)
                diff_f = max(formula_scores_diff, default=0)
                if same_f > diff_f:
                    correct["formula"] += 1

    if total_trials == 0:
        return dict(DEFAULT_WEIGHTS), {}, "Calibration trials found no valid pairs -- using default weights."

    accuracy = {s: correct[s] / total_trials for s in signals}
    total_acc = sum(accuracy.values())
    if total_acc == 0:
        weights = {s: 1 / len(signals) for s in signals}
        note = f"Calibrated over {total_trials} trials, but no signal discriminated correctly -- falling back to an equal split. Your reference tabs may need review."
    else:
        weights = {s: accuracy[s] / total_acc for s in signals}
        note = f"Calibrated over {total_trials} leave-one-out trial(s) across {len(systems_with_pairs)} system(s) with multiple references."

    for s in ["name", "value", "formula"]:
        weights.setdefault(s, 0.0)
    return weights, accuracy, note


def pick_single_best_signal(weights: dict) -> dict:
    """Hard-select mode: winner takes all weight."""
    best = max(weights, key=weights.get)
    return {s: (1.0 if s == best else 0.0) for s in weights}


# ---------------------------------------------------------------------------
# CLASSIFICATION using calibrated weights
# ---------------------------------------------------------------------------

def classify_tab(df, formula_sig, reference_dfs: dict, reference_formula_sigs: dict,
                  weights: dict, use_formula: bool):
    best_system, best_combined = "Unassigned", -1
    best_breakdown = {"name": 0, "value": 0, "formula": 0}

    for system, refs in reference_dfs.items():
        f_sigs = reference_formula_sigs.get(system, [None] * len(refs)) if use_formula else [None] * len(refs)
        name_best, value_best, formula_best = 0, 0, 0
        for i, ref_df in enumerate(refs):
            n, v = tab_similarity(df, ref_df)
            name_best = max(name_best, n)
            value_best = max(value_best, v)
            if use_formula and formula_sig and f_sigs[i]:
                formula_best = max(formula_best, formula_similarity(formula_sig, f_sigs[i]))

        combined = (
            weights.get("name", 0) * name_best
            + weights.get("value", 0) * value_best
            + weights.get("formula", 0) * formula_best
        )
        if combined > best_combined:
            best_system, best_combined = system, combined
            best_breakdown = {"name": name_best, "value": value_best, "formula": formula_best}

    return best_system, round(max(best_combined, 0)), best_breakdown


# ---------------------------------------------------------------------------
# LINEAGE MATCHING LOGIC (system-level, after classification -- unchanged)
# ---------------------------------------------------------------------------

def match_headers(df_a: pd.DataFrame, df_b: pd.DataFrame, threshold: int):
    matches = []
    used_targets = set()
    for col_a in df_a.columns:
        best_score, best_col_b, best_method = 0, None, None
        for col_b in df_b.columns:
            if col_b in used_targets:
                continue
            sort_score = fuzz.token_sort_ratio(str(col_a), str(col_b))
            partial_score = fuzz.partial_ratio(str(col_a), str(col_b))
            score, method = max((sort_score, "token_sort"), (partial_score, "partial"))
            if score > best_score:
                best_score, best_col_b, best_method = score, col_b, method
        if best_score >= threshold:
            matches.append({"source_field": col_a, "target_field": best_col_b, "score": best_score, "method": f"name:{best_method}"})
            used_targets.add(best_col_b)
    return matches


def match_by_values(df_a: pd.DataFrame, df_b: pd.DataFrame, already_matched_targets: set, threshold: float):
    matches = []
    used_targets = set(already_matched_targets)
    for col_a in df_a.columns:
        best_score, best_col_b = 0.0, None
        for col_b in df_b.columns:
            if col_b in used_targets:
                continue
            if df_a[col_a].dtype.kind not in "OUS" and df_b[col_b].dtype.kind in "OUS":
                continue
            score = value_overlap_score(df_a[col_a], df_b[col_b])
            if score > best_score:
                best_score, best_col_b = score, col_b
        if best_score >= threshold:
            matches.append({"source_field": col_a, "target_field": best_col_b, "score": round(best_score * 100, 1), "method": "value_overlap"})
            used_targets.add(best_col_b)
    return matches


def field_level_mapping(df_a, df_b, source_system, target_system, header_threshold, value_threshold):
    header_matches = match_headers(df_a, df_b, header_threshold)
    matched_targets = {m["target_field"] for m in header_matches}
    value_matches = match_by_values(df_a, df_b, matched_targets, value_threshold)
    all_matches = header_matches + value_matches
    matched_targets |= {m["target_field"] for m in value_matches}

    rows = []
    for m in all_matches:
        rows.append({
            "Source System": source_system, "Source Field": m["source_field"],
            "Transformation": "direct" if m["score"] >= 95 else "mapped/renamed",
            "Target System": target_system, "Target Field": m["target_field"],
            "Adjustment Type": "", "Match Confidence": m["score"],
            "Match Method": m["method"], "SME Confirmed": "Pending",
        })
    for col_b in df_b.columns:
        if col_b not in matched_targets:
            rows.append({
                "Source System": "(none found)", "Source Field": "",
                "Transformation": "manual/adjustment - unverified",
                "Target System": target_system, "Target Field": col_b,
                "Adjustment Type": "Candidate M-1/M-3 or manual entry - CONFIRM WITH SME",
                "Match Confidence": 0, "Match Method": "no_match", "SME Confirmed": "Pending",
            })
    return pd.DataFrame(rows)


def pairwise_overlap_report(dfs: dict, header_threshold: int, value_threshold: float, min_matched_fields: int) -> pd.DataFrame:
    results = []
    for sys_a, sys_b in itertools.permutations(dfs.keys(), 2):
        df_a, df_b = dfs[sys_a], dfs[sys_b]
        header_matches = match_headers(df_a, df_b, header_threshold)
        matched_targets = {m["target_field"] for m in header_matches}
        value_matches = match_by_values(df_a, df_b, matched_targets, value_threshold)
        total = len(header_matches) + len(value_matches)
        avg_conf = (sum(m["score"] for m in header_matches + value_matches) / total) if total else 0
        results.append({"From": sys_a, "To": sys_b, "Matched Fields": total, "Avg Confidence": round(avg_conf, 1), "Candidate Edge": total >= min_matched_fields})
    columns = ["From", "To", "Matched Fields", "Avg Confidence", "Candidate Edge"]
    if not results:
        return pd.DataFrame(columns=columns)
    return pd.DataFrame(results, columns=columns).sort_values(["Candidate Edge", "Matched Fields"], ascending=[False, False]).reset_index(drop=True)


def to_excel_bytes(df: pd.DataFrame) -> bytes:
    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as writer:
        df.to_excel(writer, index=False)
    return buf.getvalue()


def build_lineage_diagram(report: pd.DataFrame, confirmed_pair: tuple = None) -> str:
    edges = report[report["Candidate Edge"]] if not report.empty else report
    nodes = sorted(set(edges["From"]) | set(edges["To"]))
    lines = [
        'digraph lineage {', '  rankdir=LR;',
        '  node [shape=box, style="rounded,filled", fillcolor="#eaf1fb", fontname="Helvetica", fontsize=11];',
        '  edge [fontname="Helvetica", fontsize=9];',
    ]
    for n in nodes:
        lines.append(f'  "{n}";')
    for _, row in edges.iterrows():
        conf = row["Avg Confidence"]
        color = "#2e7d32" if conf >= 80 else ("#f9a825" if conf >= 60 else "#c62828")
        is_selected = confirmed_pair and (row["From"], row["To"]) == confirmed_pair
        penwidth = 3 if is_selected else 1.5
        label = f'{int(row["Matched Fields"])} fields, {conf:.0f}%'
        lines.append(f'  "{row["From"]}" -> "{row["To"]}" [label="{label}", color="{color}", penwidth={penwidth}];')
    lines.append('}')
    return "\n".join(lines)


