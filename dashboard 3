st.set_page_config(page_title="Lineage Discovery", layout="wide")
st.title("End-to-End Lineage Discovery")
st.caption("Upload one workpaper (many tabs) → confirm reference tabs per system → calibrate signal weights → classify → discover connections → build the mapping log.")

with st.sidebar:
    st.header("Classification signals")
    use_formula = st.checkbox(
        "Include cell-formula signal (slower)", value=False,
        help="Parses actual Excel formulas (function names + referenced sheet names) per column. Adds real signal for computed/derived tabs, but is heavier to run across 100+ tabs.",
    )
    if use_formula and not OPENPYXL_AVAILABLE:
        st.error("openpyxl is required for the formula signal. Install it: pip install openpyxl")
        use_formula = False

    weighting_mode = st.radio(
        "How to combine signals",
        ["Auto-calibrate & blend (recommended)", "Auto-pick single best signal", "Manual"],
        help="Calibrated modes derive weights from leave-one-out tests on your reference tabs, shown after you set references below -- not hand-tuned.",
    )

    if weighting_mode == "Manual":
        st.caption("Manual weights (normalized automatically):")
        w_name = st.slider("Column name weight", 0, 100, 25)
        w_value = st.slider("Value overlap weight", 0, 100, 75)
        w_formula = st.slider("Formula weight", 0, 100, 0) if use_formula else 0
        _total = max(w_name + w_value + w_formula, 1)
        manual_weights = {"name": w_name / _total, "value": w_value / _total, "formula": w_formula / _total}

    st.header("Lineage matching sensitivity")
    header_threshold = st.slider("Header name match threshold", 50, 100, 80)
    match_value_threshold = st.slider("Field value overlap threshold", 0.0, 1.0, 0.5, 0.05)
    min_matched_fields = st.slider("Min matched fields to call it a candidate edge", 1, 10, 2)

st.subheader("1. Upload your workpaper")
workpaper = st.file_uploader("Excel workbook with many tabs", type=["xlsx", "xls"])

if workpaper is not None:
    if "raw_sheets" not in st.session_state or st.session_state.get("_wp_name") != workpaper.name:
        with st.spinner("Reading all tabs..."):
            st.session_state["raw_sheets"] = pd.read_excel(workpaper, sheet_name=None)
            st.session_state["_wp_name"] = workpaper.name
            st.session_state.pop("formula_wb", None)
    raw_sheets = st.session_state["raw_sheets"]
    st.success(f"Found {len(raw_sheets)} tabs.")

    if use_formula and "formula_wb" not in st.session_state:
        with st.spinner("Parsing formulas (one-time)..."):
            workpaper.seek(0)
            st.session_state["formula_wb"] = openpyxl.load_workbook(workpaper, data_only=False)

    sheet_names = list(raw_sheets.keys())

    st.subheader("2. Confirm reference tabs for each system")
    st.write(
        "Select every tab you already trust by name for each system -- multiple is better than one, "
        "since 2+ per system is what lets the weighting below be calibrated instead of guessed. "
        "Leave a system empty if you have no confidently-named tab for it."
    )

    reference_choice = {}
    ref_cols = st.columns(3)
    for i, system in enumerate(SYSTEM_LABELS):
        suggested = [
            name for name in sheet_names
            if max(fuzz.partial_ratio(name.lower(), a) for a in SYSTEM_NAME_ALIASES[system]) >= 75
        ]
        with ref_cols[i % 3]:
            choice = st.multiselect(f"{system} reference(s)", sheet_names, default=suggested, key=f"ref_{system}")
            reference_choice[system] = choice

    reference_dfs = {sys_: [raw_sheets[n] for n in names] for sys_, names in reference_choice.items() if names}
    reference_sheet_names = {n for names in reference_choice.values() for n in names}

    reference_formula_sigs = {}
    if use_formula and reference_dfs:
        wb = st.session_state["formula_wb"]
        for sys_, names in reference_choice.items():
            if names:
                reference_formula_sigs[sys_] = [
                    column_formula_signature(wb[n], MAX_COLS_FOR_CLASSIFICATION, MAX_ROWS_FOR_FORMULA_SCAN)
                    for n in names if n in wb.sheetnames
                ]

    st.divider()
    st.subheader("3. Calibrate signal weights")

    if st.button("Run calibration", disabled=len(reference_dfs) < 1):
        weights, accuracy, note = calibrate_weights(reference_dfs, reference_formula_sigs, use_formula)
        st.session_state["calibrated_weights"] = weights
        st.session_state["calibration_accuracy"] = accuracy
        st.session_state["calibration_note"] = note

    if "calibrated_weights" in st.session_state:
        st.info(st.session_state["calibration_note"])
        if st.session_state["calibration_accuracy"]:
            acc_df = pd.DataFrame([
                {"Signal": s, "Leave-one-out accuracy": f"{a*100:.0f}%", "Calibrated weight": f"{st.session_state['calibrated_weights'][s]*100:.0f}%"}
                for s, a in st.session_state["calibration_accuracy"].items()
            ])
            st.dataframe(acc_df, use_container_width=True, hide_index=True)

    if weighting_mode == "Manual":
        active_weights = manual_weights
        st.caption(f"Using manual weights: {', '.join(f'{k}: {v*100:.0f}%' for k, v in active_weights.items())}")
    elif "calibrated_weights" in st.session_state:
        base = st.session_state["calibrated_weights"]
        active_weights = pick_single_best_signal(base) if weighting_mode == "Auto-pick single best signal" else base
        st.caption(f"Active weights: {', '.join(f'{k}: {v*100:.0f}%' for k, v in active_weights.items())}")
    else:
        active_weights = dict(DEFAULT_WEIGHTS)
        st.caption("Run calibration above, or switch to Manual, before classifying -- using defaults for now.")

    st.divider()
    st.subheader("4. Classify remaining tabs by content")

    if st.button("Classify all tabs", type="primary", disabled=len(reference_dfs) < 1):
        rows = []
        progress = st.progress(0.0, text="Classifying tabs...")
        non_ref_names = [n for n in sheet_names if n not in reference_sheet_names]
        wb = st.session_state.get("formula_wb")
        for i, name in enumerate(non_ref_names):
            fsig = column_formula_signature(wb[name], MAX_COLS_FOR_CLASSIFICATION, MAX_ROWS_FOR_FORMULA_SCAN) if (use_formula and wb and name in wb.sheetnames) else None
            guess, confidence, breakdown = classify_tab(
                raw_sheets[name], fsig, reference_dfs, reference_formula_sigs, active_weights, use_formula
            )
            rows.append({
                "Sheet Name": name, "Rows": len(raw_sheets[name]), "Cols": len(raw_sheets[name].columns),
                "Guessed System": guess, "Confidence": confidence,
                "Name Score": breakdown["name"], "Value Score": breakdown["value"], "Formula Score": breakdown["formula"] if use_formula else None,
                "Final System": guess,
            })
            progress.progress((i + 1) / max(len(non_ref_names), 1), text=f"Classifying tabs... ({i + 1}/{len(non_ref_names)})")
        progress.empty()

        for system, names in reference_choice.items():
            for name in names:
                rows.insert(0, {
                    "Sheet Name": name, "Rows": len(raw_sheets[name]), "Cols": len(raw_sheets[name].columns),
                    "Guessed System": system, "Confidence": 100,
                    "Name Score": 100, "Value Score": 100, "Formula Score": 100 if use_formula else None,
                    "Final System": system,
                })
        st.session_state["classification_df"] = pd.DataFrame(rows)

    if "classification_df" in st.session_state:
        cdf = st.session_state["classification_df"]

        show_low_only = st.checkbox("Show only low-confidence tabs (below 70) needing review", value=True)
        search = st.text_input("Filter by sheet name contains", "")

        display_df = cdf.copy()
        if show_low_only:
            display_df = display_df[display_df["Confidence"] < 70]
        if search:
            display_df = display_df[display_df["Sheet Name"].str.contains(search, case=False, na=False)]

        st.write(f"Showing {len(display_df)} of {len(cdf)} tabs. Edit **Final System** directly (type any label, or 'Skip' to exclude).")

        editable_cols = ["Sheet Name", "Rows", "Cols", "Guessed System", "Confidence", "Name Score", "Value Score", "Final System"]
        if use_formula:
            editable_cols.insert(-1, "Formula Score")

        edited = st.data_editor(
            display_df[editable_cols].sort_values("Confidence"),
            column_config={
                "Final System": st.column_config.TextColumn("Final System (editable)"),
                "Confidence": st.column_config.NumberColumn("Confidence", format="%d%%"),
                "Name Score": st.column_config.NumberColumn("Name Score", format="%d%%"),
                "Value Score": st.column_config.NumberColumn("Value Score", format="%d%%"),
                "Formula Score": st.column_config.NumberColumn("Formula Score", format="%d%%"),
            },
            disabled=[c for c in editable_cols if c != "Final System"],
            use_container_width=True,
            hide_index=True,
            key="editor",
        )

        cdf = cdf.set_index("Sheet Name")
        cdf.update(edited.set_index("Sheet Name")[["Final System"]])
        cdf = cdf.reset_index()
        st.session_state["classification_df"] = cdf

        st.download_button("Download full classification (xlsx)", data=to_excel_bytes(cdf), file_name="tab_classification.xlsx")

        st.divider()
        st.subheader("Launch Sheet Trace Viewer")
        st.write(
            "Opens the real formula-based trace tool (`sheet_tree_server.py`) in a new browser tab, "
            "using this workpaper and your confirmed classification above -- shows System Overview, "
            "All Sheets, and one drill-down view per system, all wired to actual traced formula "
            "references (not fuzzy matching)."
        )
        st.caption(
            "Runs **locally only** -- it starts a local server and drives your local Excel via "
            "COM automation, so it only works if you're running this dashboard on your own Windows "
            "machine with Excel installed and `sheet_tree_server.py` in the same folder as this script. "
            "It won't work if this dashboard is hosted remotely."
        )

        script_dir = os.path.dirname(os.path.abspath(__file__))
        default_script_path = os.path.join(script_dir, "sheet_tree_server.py")
        script_path = st.text_input("Path to sheet_tree_server.py", value=default_script_path)
        trace_min_cells = st.slider("Min cells per link to draw (sheet trace tool)", 1, 20, 1)

        launch_col, stop_col = st.columns(2)

        with launch_col:
            if st.button("Launch Sheet Trace Viewer", type="primary"):
                if not os.path.exists(script_path):
                    st.error(f"Could not find sheet_tree_server.py at: {script_path}. Place it next to this dashboard file or correct the path above.")
                else:
                    try:
                        if "trace_tmpdir" not in st.session_state:
                            st.session_state["trace_tmpdir"] = tempfile.mkdtemp(prefix="lineage_trace_")
                        tmpdir = st.session_state["trace_tmpdir"]

                        workbook_path = os.path.join(tmpdir, workpaper.name)
                        with open(workbook_path, "wb") as f:
                            f.write(workpaper.getvalue())

                        classification_path = os.path.join(tmpdir, "tab_classification.xlsx")
                        with open(classification_path, "wb") as f:
                            f.write(to_excel_bytes(cdf))

                        cmd = [
                            sys.executable, script_path, workbook_path, str(trace_min_cells),
                            "--classification", classification_path,
                        ]
                        proc = subprocess.Popen(cmd, cwd=tmpdir)
                        st.session_state["trace_proc"] = proc
                        st.success(f"Launched (PID {proc.pid}). A new browser tab should open automatically in a moment.")
                    except Exception as e:
                        st.error(f"Failed to launch: {e}")

        with stop_col:
            active_proc = st.session_state.get("trace_proc")
            if st.button("Stop Sheet Trace Viewer", disabled=active_proc is None or active_proc.poll() is not None):
                active_proc.terminate()
                st.info("Stopped.")

        if st.session_state.get("trace_proc") is not None:
            proc = st.session_state["trace_proc"]
            if proc.poll() is None:
                st.caption(f"Trace viewer running (PID {proc.pid}). Use Stop above when you're done with it, or close it from Task Manager if this dashboard restarts.")
            else:
                st.caption(f"Trace viewer process exited (code {proc.returncode}).")

        st.divider()
        st.subheader("5. Discover candidate edges")
        st.write("Tabs sharing the same Final System are combined into one dataset per system before matching.")

        confirmed = cdf[~cdf["Final System"].isin(["Skip", "", None])]
        system_dfs = {}
        for system, group in confirmed.groupby("Final System"):
            frames = [raw_sheets[n] for n in group["Sheet Name"] if n in raw_sheets]
            if frames:
                system_dfs[system] = pd.concat(frames, ignore_index=True, sort=False)

        st.write(f"Systems ready for lineage matching: {list(system_dfs.keys())}")

        if st.button("Run discovery", type="primary", disabled=len(system_dfs) < 2):
            st.session_state["report"] = pairwise_overlap_report(system_dfs, header_threshold, match_value_threshold, min_matched_fields)
            st.session_state["dfs"] = system_dfs

        if len(system_dfs) < 2:
            st.info("Assign at least 2 systems (not Skip) to run discovery.")

        if "report" in st.session_state:
            report = st.session_state["report"]
            st.dataframe(
                report.style.apply(lambda row: ["background-color: #d4f7d4" if row["Candidate Edge"] else "" for _ in row], axis=1),
                use_container_width=True,
            )
            st.download_button("Download edge discovery report (xlsx)", data=to_excel_bytes(report), file_name="lineage_edge_discovery.xlsx")

            st.divider()
            st.subheader("6. Field-level mapping for a confirmed pair")

            dfs = st.session_state["dfs"]
            candidate_pairs = report[report["Candidate Edge"]] if not report.empty else report
            pair_options = [f"{r['From']} -> {r['To']}" for _, r in candidate_pairs.iterrows()] or [f"{r['From']} -> {r['To']}" for _, r in report.iterrows()]

            selected_pair_tuple = None
            if pair_options:
                selected = st.selectbox("Choose a pair", pair_options)
                from_sys, to_sys = selected.split(" -> ")

                if st.button("Generate field-level mapping"):
                    st.session_state["mapping_df"] = field_level_mapping(dfs[from_sys], dfs[to_sys], from_sys, to_sys, header_threshold, match_value_threshold)
                    st.session_state["mapping_pair"] = selected

                if "mapping_df" in st.session_state:
                    selected_pair_tuple = (from_sys, to_sys)
                    st.write(f"**{st.session_state['mapping_pair']}**")
                    mapping_df = st.session_state["mapping_df"]

                    def highlight_row(row):
                        return ["background-color: #fff3cd" for _ in row] if row["Adjustment Type"] else ["" for _ in row]

                    st.dataframe(mapping_df.style.apply(highlight_row, axis=1), use_container_width=True)
                    st.download_button("Download field mapping (xlsx)", data=to_excel_bytes(mapping_df), file_name=f"lineage_mapping_{from_sys}_to_{to_sys}.xlsx")
                    n_adj = (mapping_df["Adjustment Type"] != "").sum()
                    st.caption(f"{len(mapping_df) - n_adj} matched fields, {n_adj} unmatched target fields flagged as candidate adjustments/manual entries - confirm on the SME call.")

            st.divider()
            st.subheader("7. Lineage diagram")
            st.write("Green = high confidence (80%+), amber = medium (60-79%), red = weak (below 60%). Selected pair drawn thicker.")
            dot_source = build_lineage_diagram(report, confirmed_pair=selected_pair_tuple)
            st.graphviz_chart(dot_source, use_container_width=True)
            st.download_button("Download diagram source (.dot)", data=dot_source, file_name="lineage_diagram.dot")
else:
    st.info("Upload your workpaper Excel file to get started.")
